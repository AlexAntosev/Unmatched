@page "/heroes-statistics"
@using Unmatched.Dtos
@using Unmatched.Extensions
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@inject NavigationManager NavManager
@inject IHeroStatisticsService HeroStatisticsService
@inject IHeroService HeroService
@inject IPlayStyleService PlayStyleService
@inject ICollectionService CollectionService
@inject IExpansionService ExpansionService
@inject IMatchService MatchService
@inject Unmatched.UI.BlazorServer.Services.AppSettingsService AppSettingsService
@*
    Screen 1c, the landing screen: a dense ranked list with an analysis column that follows the
    hovered or selected hero. Heroes from expansions you do not own are hidden, which is what the
    Collection screen's owned flags are for.
*@

<PageHeader Breadcrumbs="Crumbs">
    <Controls>
        <UmSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search hero…"/>
        <SegmentedControl TValue="ListViewMode" Variant="bar" Options="ListViewModeOptions.Default"
                           Value="_viewMode" ValueChanged="OnViewModeChanged"/>
    </Controls>
</PageHeader>

<div class="ladder">
    <header class="ladder-head">
        <div>
            <h1 class="um-page-title">Heroes ladder</h1>
            <div class="ladder-lede">@_heroes.Count heroes · @_totalMatches.ToString("N0") matches</div>
        </div>
        <div class="um-spacer"></div>
        @foreach (var stat in HeadlineStats())
        {
            <div class="ladder-headline">
                <div class="ladder-headline-label">@stat.Label</div>
                <div class="ladder-headline-value" style="color:@stat.Color">@stat.Value</div>
            </div>
        }
    </header>

    <Tabs TValue="LadderSort" Options="SortTabs" Value="_sort" ValueChanged="OnSortChanged" Class="ladder-tabs"/>

    <div class="ladder-body">
        <div class="ladder-list">
            @if (_viewMode == ListViewMode.List)
            {
                <ColumnHeader Columns="@Columns">
                    <div>#</div>
                    <div>Hero</div>
                    <div class="ladder-right">Pts</div>
                    <div class="ladder-right">GP</div>
                    <div>W / L</div>
                    <div class="ladder-right">K/D</div>
                </ColumnHeader>

                @foreach (var hero in _page)
                {
                    <LadderRow Columns="@Columns"
                               Rank="@DisplayRank(hero)"
                               Name="@hero.Name"
                               Sub="@ExpansionName(hero.HeroId)"
                               ImageUrl="@hero.ImageUrl"
                               IsRanged="hero.IsRanged"
                               EdgeColor="@EdgeColor(hero)"
                               WashColor="@WashColor(hero)"
                               Selected="@(_spotlight?.HeroId == hero.HeroId)"
                               OnHover="@(() => SelectAsync(hero))"
                               OnClick="@(() => OpenHero(hero))">
                        <Metrics>
                            <div class="ladder-points" style="color:@(hero.Points < 0 ? "var(--um-loss)" : "var(--um-accent-text)")">
                                @hero.Points
                            </div>
                            <div class="ladder-matches">@hero.TotalMatches</div>
                            <WinLossBar Wins="hero.TotalWins" Losses="hero.TotalLooses"/>
                            <div class="ladder-kd" style="color:@(hero.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                                @hero.Kd.ToString("0.00")
                            </div>
                        </Metrics>
                    </LadderRow>
                }
            }
            else
            {
                <div class="um-tile-grid">
                    @foreach (var hero in _page)
                    {
                        var rank = DisplayRank(hero);
                        <EntityTile Rank="rank" Name="@hero.Name" Sub="@ExpansionName(hero.HeroId)"
                                    ImageUrl="@hero.ImageUrl" IsRanged="hero.IsRanged"
                                    Highlighted="@(rank is >= 1 and <= 3)"
                                    OnClick="@(() => OpenHero(hero))">
                            <Metrics>
                                <div class="ladder-tile-points" style="color:@(hero.Points < 0 ? "var(--um-loss)" : "var(--um-accent-text)")">
                                    @hero.Points pts
                                </div>
                                <WinLossBar Wins="hero.TotalWins" Losses="hero.TotalLooses"/>
                            </Metrics>
                        </EntityTile>
                    }
                </div>
            }

            <GridFooter Caption="@(_viewMode == ListViewMode.List ? "ROWS PER PAGE" : "TILES PER PAGE")"
                        PageSizeOptions="PageSizeOptions" PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged"
                        CurrentPage="_currentPage" PageCount="PageCount" TotalCount="_sorted.Count"
                        PageChanged="GoToPage" Class="ladder-footer"/>
        </div>

        <aside class="ladder-aside">
            @if (_spotlight is not null)
            {
                <Panel Raised="true">
                    <div class="spotlight-head">
                        <HeroToken ImageUrl="@_spotlight.ImageUrl" Alt="@_spotlight.Name" Size="40" Radius="11"/>
                        <div>
                            <div class="spotlight-name">@_spotlight.Name</div>
                            <div class="spotlight-rank">selected · rank @(DisplayRank(_spotlight)?.ToString("00") ?? "-")</div>
                        </div>
                    </div>
                    <div class="spotlight-stats">
                        <StatTile Variant="inset" Label="Pts" Value="@_spotlight.Points.ToString()"
                                  ValueColor="var(--um-accent-text)"/>
                        <StatTile Variant="inset" Label="WR" Value="@($"{WinRate(_spotlight)}%")"
                                  ValueColor="var(--um-win)"/>
                        <StatTile Variant="inset" Label="HP" Value="@_spotlight.Hp.ToString()"/>
                        <StatTile Variant="inset" Label="Deck" Value="@_spotlight.DeckSize.ToString()"/>
                    </div>
                    <RadarChart Attack="_spotlightStyle?.Attack ?? 0"
                                Defence="_spotlightStyle?.Defence ?? 0"
                                Trickery="_spotlightStyle?.Trickery ?? 0"
                                Difficulty="_spotlightStyle?.Difficulty ?? 0"/>
                </Panel>

                <Panel Raised="true" Title="Best / worst matchups">
                    @if (_spotlightMatchups.Count == 0)
                    {
                        <div class="spotlight-empty">No recorded matchups yet.</div>
                    }
                    @foreach (var matchup in _spotlightMatchups)
                    {
                        <MatchupBar Name="@matchup.OpponentName" ImageUrl="@matchup.OpponentImageUrl"
                                    Percent="matchup.WinPercent"/>
                    }
                </Panel>
            }

            <Panel Raised="true" Title="Collection" Meta="@($"{_ownedExpansionIds.Count} / {_expansions.Count} sets")">
                <div class="spotlight-sets">
                    @foreach (var expansion in _expansions.Take(6))
                    {
                        var owned = _ownedExpansionIds.Contains(expansion.Id);
                        <div class="spotlight-set @(owned ? null : "is-missing")">
                            <div class="spotlight-set-cover">
                                @if (expansion.ImageUrl is not null)
                                {
                                    <img src="@expansion.ImageUrl" alt="@expansion.Name"/>
                                }
                                else
                                {
                                    <span>box art</span>
                                }
                            </div>
                            <div class="spotlight-set-name">@expansion.Name</div>
                            <div class="spotlight-set-tag" style="color:@(owned ? "var(--um-win)" : "var(--um-text-faint)")">
                                @(owned ? "owned" : "missing")
                            </div>
                        </div>
                    }
                </div>
            </Panel>
        </aside>
    </div>
</div>

@code {
    private const string Columns = "44px 1fr 78px 70px 118px 70px";
    private const int DefaultPageSize = 10;
    private const string ScreenKey = "heroes";

    private static readonly IReadOnlyList<SelectOption<int>> ListPageSizeOptions =
        [new(10, "10"), new(20, "20"), new(50, "50"), new(100, "100")];

    private static readonly IReadOnlyList<SelectOption<int>> TilePageSizeOptions =
        [new(10, "10"), new(20, "20"), new(50, "50"), new(GridFooter.AllPageSize, "All")];

    public enum LadderSort
    {
        Points,
        WinRate,
        Kd,
        RecentlyPlayed
    }

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Heroes")];

    private static readonly IReadOnlyList<SelectOption<LadderSort>> SortTabs =
    [
        new(LadderSort.Points, "Points"), new(LadderSort.WinRate, "Win rate"),
        new(LadderSort.Kd, "K/D"), new(LadderSort.RecentlyPlayed, "Recently played")
    ];

    private readonly Dictionary<Guid, UiPlayStyleDto?> _playStyles = new();

    private List<UiHeroStatisticsDto> _heroes = new();
    private List<UiHeroStatisticsDto> _sorted = new();
    private List<UiHeroStatisticsDto> _page = new();
    private Dictionary<Guid, int?> _displayRanks = new();
    private List<UiMatchLogDto> _matches = new();
    private List<ExpansionDto> _expansions = new();
    private Dictionary<Guid, string?> _expansionNamesByHero = new();
    private HashSet<Guid> _ownedExpansionIds = new();
    private Dictionary<Guid, DateTime> _lastPlayedByHero = new();

    private UiHeroStatisticsDto? _spotlight;
    private UiPlayStyleDto? _spotlightStyle;
    private IReadOnlyList<HeroMatchup> _spotlightMatchups = [];

    private LadderSort _sort = LadderSort.Points;
    private string? _search;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;
    private ListViewMode _viewMode = ListViewMode.List;
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_sorted.Count / (double)_pageSize));

    private IReadOnlyList<SelectOption<int>> PageSizeOptions
        => _viewMode == ListViewMode.List ? ListPageSizeOptions : TilePageSizeOptions;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var stats = HeroStatisticsService.GetHeroesStatisticsAsync();
            var catalogHeroes = HeroService.GetAsync();
            var expansions = ExpansionService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            var matches = MatchService.GetMatchLogAsync();
            await Task.WhenAll(stats, catalogHeroes, expansions, owned, matches);

            _expansions = expansions.Result.OrderBy(e => e.Name).ToList();
            _ownedExpansionIds = owned.Result.ToHashSet();
            _matches = matches.Result.ToList();
            _totalMatches = _matches.Count;

            var heroes = catalogHeroes.Result.ToList();
            _expansionNamesByHero = heroes.ToDictionary(h => h.Id, h => h.ExpansionName);
            var expansionIdByHero = heroes.ToDictionary(h => h.Id, h => h.ExpansionId);

            _lastPlayedByHero = _matches
                .SelectMany(m => m.Fighters.Select(f => (f.HeroId, m.Date)))
                .GroupBy(x => x.HeroId)
                .ToDictionary(g => g.Key, g => g.Max(x => x.Date));

            _heroes = FilterByCollection(stats.Result.ToList(), expansionIdByHero);
            Rebuild();
            await SelectAsync(_page.FirstOrDefault());
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    /// <summary>
    /// The persisted List/Tiles choice is read via JS interop (localStorage), which cannot run
    /// during static prerendering - only once the circuit is interactive.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _viewMode = await AppSettingsService.GetListViewModeAsync(ScreenKey);
            StateHasChanged();
        }
    }

    /// <summary>Heroes from sets you do not own are hidden - unless nothing is marked as owned yet.</summary>
    private List<UiHeroStatisticsDto> FilterByCollection(
        List<UiHeroStatisticsDto> heroes,
        Dictionary<Guid, Guid?> expansionIdByHero)
    {
        if (_ownedExpansionIds.Count == 0)
        {
            return heroes;
        }

        return heroes
            .Where(h => !expansionIdByHero.TryGetValue(h.HeroId, out var expansionId)
                     || expansionId is null
                     || _ownedExpansionIds.Contains(expansionId.Value))
            .ToList();
    }

    private void Rebuild()
    {
        IEnumerable<UiHeroStatisticsDto> heroes = _heroes;

        if (!string.IsNullOrWhiteSpace(_search))
        {
            heroes = heroes.Where(h => h.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        // Unranked heroes (no recorded matches) always sink to the bottom, regardless of sort tab.
        heroes = _sort switch
        {
            LadderSort.WinRate => heroes.OrderByDescending(h => h.Place is not null).ThenByDescending(WinRate).ThenByDescending(h => h.TotalMatches),
            LadderSort.Kd => heroes.OrderByDescending(h => h.Place is not null).ThenByDescending(h => h.Kd).ThenByDescending(h => h.TotalMatches),
            LadderSort.RecentlyPlayed => heroes.OrderByDescending(h => h.Place is not null).ThenByDescending(h => _lastPlayedByHero.GetValueOrDefault(h.HeroId)),
            _ => heroes.OrderByDescending(h => h.Place is not null).ThenByDescending(h => h.Points).ThenByDescending(h => h.Kd)
        };

        _sorted = heroes.ToList();
        _displayRanks = BuildDisplayRanks(_sorted);
        _currentPage = Math.Clamp(_currentPage, 1, PageCount);
        _page = _sorted.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
    }

    /// <summary>
    /// Renumbers the currently filtered/sorted list from 1, so unranked heroes (hidden by
    /// collection filters or excluded because they have no matches) don't leave gaps in the
    /// numbers shown on screen. Heroes with no recorded matches stay unranked.
    /// </summary>
    private static Dictionary<Guid, int?> BuildDisplayRanks(IReadOnlyList<UiHeroStatisticsDto> heroes)
    {
        var ranks = new Dictionary<Guid, int?>();
        var place = 1;
        foreach (var hero in heroes)
        {
            ranks[hero.HeroId] = hero.Place is not null ? place++ : null;
        }

        return ranks;
    }

    private int? DisplayRank(UiHeroStatisticsDto hero) => _displayRanks.GetValueOrDefault(hero.HeroId);

    private async Task SelectAsync(UiHeroStatisticsDto? hero)
    {
        if (hero is null || _spotlight?.HeroId == hero.HeroId)
        {
            return;
        }

        _spotlight = hero;
        _spotlightMatchups = HeroMatchupCalculator.BestAndWorst(
            HeroMatchupCalculator.Calculate(hero.HeroId, _matches));

        // Play styles are not part of the stats list, so they are fetched lazily and remembered.
        if (!_playStyles.TryGetValue(hero.HeroId, out var style))
        {
            style = await PlayStyleService.GetAsync(hero.HeroId);
            _playStyles[hero.HeroId] = style;
        }

        _spotlightStyle = style;
    }

    private void OnSortChanged(LadderSort sort)
    {
        _sort = sort;
        _currentPage = 1;
        Rebuild();
    }

    private void OnSearchChanged(string? search)
    {
        _search = search;
        _currentPage = 1;
        Rebuild();
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
        Rebuild();
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        Rebuild();
    }

    private async Task OnViewModeChanged(ListViewMode mode)
    {
        _viewMode = mode;
        _currentPage = 1;
        _pageSize = DefaultPageSize;
        Rebuild();
        await AppSettingsService.SetListViewModeAsync(ScreenKey, mode);
    }

    private void OpenHero(UiHeroStatisticsDto hero)
        => NavManager.NavigateTo($"{Urls.HeroesStatistics}/{hero.HeroId}");

    private string? ExpansionName(Guid heroId)
        => _expansionNamesByHero.GetValueOrDefault(heroId).ToShortName();

    private static int WinRate(UiHeroStatisticsDto hero)
        => hero.TotalMatches == 0 ? 0 : (int)Math.Round((double)hero.TotalWins / hero.TotalMatches * 100);

    /// <summary>Medals mark the podium; a negative score marks a hero that is losing ground.</summary>
    private string? EdgeColor(UiHeroStatisticsDto hero)
    {
        if (hero.Points < 0)
        {
            return "var(--um-loss)";
        }

        var rank = DisplayRank(hero);
        return rank is >= 1 and <= 3 ? PlaceColor.For(rank) : null;
    }

    private static string? WashColor(UiHeroStatisticsDto hero)
        => hero.Points < 0 ? "var(--um-loss-wash)" : null;

    private record Headline(string Label, string Value, string Color);

    private IEnumerable<Headline> HeadlineStats()
    {
        var played = _heroes.Where(h => h.TotalMatches > 0).ToList();
        if (played.Count == 0)
        {
            yield break;
        }

        var topWinRate = played.MaxBy(WinRate)!;
        var mostPlayed = played.MaxBy(h => h.TotalMatches)!;
        var coldest = played.MinBy(WinRate)!;

        yield return new Headline("Top win rate", $"{WinRate(topWinRate)}%", "var(--um-win)");
        yield return new Headline("Most played", mostPlayed.Name, "var(--um-text)");
        yield return new Headline("Coldest", coldest.Name, "var(--um-loss)");
    }
}
