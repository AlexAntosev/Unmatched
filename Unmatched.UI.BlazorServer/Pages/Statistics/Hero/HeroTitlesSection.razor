@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Services
@inject AppSettingsService AppSettingsService
@*
    Turn 10a - sits under the hero banner, above "Rating changes". Only what this hero actually holds
    is listed here - titles/achievements it hasn't earned aren't shown at all (the /titles catalogue
    page is where the full picture, held or not, lives). Left column: Unique titles held. Right column:
    Shared achievements earned, with the times-earned count and last-earned date, then any tournament
    titles held. The whole section collapses as one unit - the choice is durable per browser, same
    mechanism as the nav rail's expanded/collapsed state (AppSettingsService/NavState).
*@
<Panel Class="hero-titles-panel">
    <HeaderActions>
        <span class="hero-titles-badge hero-titles-badge-gold">@Summary.TitlesHeldCount TITLES HELD</span>
        <span class="hero-titles-badge hero-titles-badge-accent">@Summary.AchievementsHeldCount / @Summary.AchievementsTotalCount ACHIEVEMENTS</span>
        <div class="um-spacer"></div>
        <a class="hero-titles-all-link" href="@Urls.Titles">All titles<i class="bi bi-chevron-right"></i></a>
        <button type="button" class="hero-titles-collapse-toggle" title="@(_isExpanded ? "Collapse" : "Expand")" @onclick="ToggleExpandedAsync">
            <i class="bi @(_isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </button>
    </HeaderActions>
    <ChildContent>
        @if (_isExpanded)
        {
        <div class="hero-titles-grid">
            <div class="hero-titles-col">
                <div class="hero-titles-col-caption">
                    <span class="hero-titles-col-title">Titles</span>
                    <span class="hero-titles-col-note">unique · one holder at a time</span>
                </div>

                @if (Summary.HeldTitles.Count == 0)
                {
                    <div class="hero-titles-empty">No titles held yet.</div>
                }

                @foreach (var title in Summary.HeldTitles)
                {
                    <div class="hero-title-card @AccentClass(title.Entry.Style.Accent)">
                        <div class="hero-title-card-icon"><i class="bi @title.Entry.Style.Icon"></i></div>
                        <div class="hero-title-card-body">
                            <div class="hero-title-card-name">@title.Entry.DisplayName</div>
                            <div class="hero-title-card-desc">@title.Entry.Title.Comment</div>
                            @if (title.MetricLabel is not null)
                            {
                                <div class="hero-title-card-metric">@title.MetricLabel</div>
                            }
                        </div>
                        <div class="hero-title-card-date">
                            <div class="hero-title-card-date-label">Held since</div>
                            <div class="hero-title-card-date-value">@FormatDate(title.HeldSince)</div>
                        </div>
                    </div>
                }
            </div>

            <div class="hero-titles-col">
                <div class="hero-titles-col-caption">
                    <span class="hero-titles-col-title">Achievements</span>
                    <span class="hero-titles-col-note">shared · earned repeatedly</span>
                </div>

                @if (Summary.HeldAchievements.Count == 0)
                {
                    <div class="hero-titles-empty">No achievements earned yet.</div>
                }
                else
                {
                    <div class="hero-achievements-grid">
                        @foreach (var achievement in Summary.HeldAchievements)
                        {
                            <div class="hero-achievement-card">
                                <div class="hero-achievement-head">
                                    <i class="bi @achievement.Entry.Style.Icon"></i>
                                    <span class="hero-achievement-name">@achievement.Entry.DisplayName</span>
                                    <span class="hero-achievement-count">×@achievement.TimesEarned</span>
                                </div>
                                <div class="hero-achievement-desc">@achievement.Entry.Title.Comment</div>
                                @if (achievement.MetricLabel is not null)
                                {
                                    <div class="hero-achievement-metric">@achievement.MetricLabel</div>
                                }
                                <div class="hero-achievement-last">LAST · @FormatDate(achievement.LastEarnedAt)</div>
                            </div>
                        }
                    </div>
                }

                @if (Summary.TournamentTitles.Count > 0)
                {
                    <div class="hero-titles-divider"></div>
                    <div class="hero-titles-subcaption">Tournament titles</div>
                    <div class="hero-tournament-titles">
                        @foreach (var title in Summary.TournamentTitles)
                        {
                            <div class="hero-tournament-title-row">
                                <i class="bi @title.Entry.Style.Icon"></i>
                                <div class="hero-tournament-title-body">
                                    <div class="hero-tournament-title-name">@title.Entry.DisplayName</div>
                                    <div class="hero-tournament-title-meta">@title.TournamentName · @FormatDate(title.EarnedAt)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        }
    </ChildContent>
</Panel>

@code {
    [Parameter, EditorRequired]
    public HeroTitlesSummary Summary { get; set; } = default!;

    private bool _isExpanded = true;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
        {
            return;
        }

        _loaded = true;
        _isExpanded = await AppSettingsService.GetHeroTitlesSectionExpandedAsync();
        StateHasChanged();
    }

    private async Task ToggleExpandedAsync()
    {
        _isExpanded = !_isExpanded;
        await AppSettingsService.SetHeroTitlesSectionExpandedAsync(_isExpanded);
    }

    private static string AccentClass(TitleAccent accent) => accent switch
    {
        TitleAccent.Prestige => "is-prestige",
        TitleAccent.Negative => "is-negative",
        _ => "is-neutral"
    };

    private static string FormatDate(DateTime? date) => date?.ToString("dd MMM yyyy") ?? "—";
}
