@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Services
@inject IMinionService MinionService
@inject IMinionStatisticsService MinionStatisticsService
@inject IImageUploadService ImageUploadService

<div style="background: linear-gradient(180deg, @Statistics.Color 0%, rgba(255,255,255,1) 100%);">
    <div style="display: flex; align-items: center; justify-content: center;">
        <h3 class="page-title">@Statistics.Name</h3>
    </div>
    <div class="wrapper page-content">
        <div class="image-container">
            <EditableImage ImageUrl="@BustCache(Statistics.ImageUrl)" AltText="@Statistics.Name" OnFileSelected="OnImageSelectedAsync" />
        </div>
        <div>
            <img style="margin-bottom: 0.5rem;" src="@Statistics.MeleeRangeImageUrl" alt="@Statistics.Name" width="64px" height="auto"/>
            <h5>Hp: @Statistics.Hp</h5>
            <h5>Deck size: @Statistics.DeckSize</h5>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public MinionStatisticsDto Statistics { get; set; } = new();

    private int _cacheBust;

    private string BustCache(string? imageUrl) => imageUrl is null ? "/Unknown.png" : $"{imageUrl}?v={_cacheBust}";

    private async Task OnImageSelectedAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(15_000_000);
        var fileName = await ImageUploadService.SaveAsync("minions", Statistics.Name, Statistics.ImageFileName, stream, file.Name);
        await MinionService.UpdateImageAsync(Statistics.MinionId, fileName);
        await MinionStatisticsService.UpdateImageAsync(Statistics.MinionId, fileName);
        Statistics.ImageFileName = fileName;
        _cacheBust++;
        StateHasChanged();
    }
}

<style>
    .wrapper {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      column-gap: 32px;
      row-gap: 4px;
    }

    .image-container {
        width: 250px;
        height: 200px;
        text-align: center;
        display: block;
    }

    .container img {
        margin: auto;
        display: block;
    }
</style>
