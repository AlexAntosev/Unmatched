@page "/minions-statistics"
@using Unmatched.Dtos
@using Unmatched.Services.Statistics
@inject IMinionStatisticsService MinionStatisticsService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 1c ladder pattern. Wins here are the minion's own - a minion wins
    when the villain side wins.
*@

<EntityLadder TItem="MinionStatisticsDto" Items="_minions" Title="Minions"
              Lede="@($"{_minions.Count} minions · {_totalMatches:N0} appearances")"
              Breadcrumbs="Crumbs" Columns="@Columns" SearchText="@(m => m.Name)"
              SearchPlaceholder="Search minion…">
    <Header>
        <div>#</div>
        <div>Minion</div>
        <div class="minions-right">GP</div>
        <div>W / L</div>
        <div class="minions-right">K/D</div>
    </Header>
    <Row>
        <LadderRow Columns="@Columns" Rank="@(_minions.IndexOf(context) + 1)" Name="@context.Name"
                   ImageUrl="@context.ImageUrl" IsRanged="context.IsRanged"
                   EdgeColor="var(--um-info)" OnClick="@(() => Open(context))">
            <Metrics>
                <div class="minions-matches">@context.TotalMatches</div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
                <div class="minions-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    @context.Kd.ToString("0.00")
                </div>
            </Metrics>
        </LadderRow>
    </Row>
</EntityLadder>

@code {
    private const string Columns = "34px 1fr 58px 90px 62px";

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Minions")];

    private List<MinionStatisticsDto> _minions = new();
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            _minions = (await MinionStatisticsService.GetMinionsStatisticsAsync())
                .OrderByDescending(m => m.TotalMatches)
                .ToList();
            _totalMatches = _minions.Sum(m => m.TotalMatches);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Open(MinionStatisticsDto minion)
        => NavManager.NavigateTo($"{Urls.MinionsStatistics}/{minion.MinionId}");
}
