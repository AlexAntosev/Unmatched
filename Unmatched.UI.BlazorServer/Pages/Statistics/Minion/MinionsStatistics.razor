@page "/minions-statistics"
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@inject IMinionStatisticsService MinionStatisticsService
@inject IMinionService MinionService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 1c ladder pattern. Wins here are the minion's own - a minion wins
    when the villain side wins. Minions from sets you do not own are hidden, matching the heroes
    and maps ladders.
*@

<EntityLadder TItem="MinionStatisticsDto" Items="_minions" Title="Minions" ScreenKey="minions"
              Lede="@($"{_minions.Count} minions · {_totalMatches:N0} appearances")"
              Breadcrumbs="Crumbs" Columns="@Columns" SearchText="@(m => m.Name)"
              SearchPlaceholder="Search minion…">
    <Header>
        <div>#</div>
        <div>Minion</div>
        <div class="minions-right">GP</div>
        <div>W / L</div>
        <div class="minions-right">K/D</div>
    </Header>
    <Row>
        <LadderRow Columns="@Columns" Rank="@(_minions.IndexOf(context) + 1)" Name="@context.Name"
                   ImageUrl="@context.ImageUrl" IsRanged="context.IsRanged"
                   EdgeColor="var(--um-info)" OnClick="@(() => Open(context))">
            <Metrics>
                <div class="minions-matches">@context.TotalMatches</div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
                <div class="minions-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    @context.Kd.ToString("0.00")
                </div>
            </Metrics>
        </LadderRow>
    </Row>
    <Tile>
        <EntityTile Rank="@(_minions.IndexOf(context) + 1)" Name="@context.Name" ImageUrl="@context.ImageUrl"
                    IsRanged="context.IsRanged" Highlighted="@(_minions.IndexOf(context) is >= 0 and <= 2)"
                    OnClick="@(() => Open(context))">
            <Metrics>
                <div class="minions-tile-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    K/D @context.Kd.ToString("0.00")
                </div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
            </Metrics>
        </EntityTile>
    </Tile>
</EntityLadder>

@code {
    private const string Columns = "44px 1fr 58px 90px 62px";

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Minions")];

    private List<MinionStatisticsDto> _minions = new();
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var stats = MinionStatisticsService.GetMinionsStatisticsAsync();
            var catalog = MinionService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(stats, catalog, owned);

            var catalogMinions = catalog.Result.ToDictionary(m => m.Id);
            var ownedExpansionIds = owned.Result.ToHashSet();

            _minions = stats.Result.ToList();

            if (ownedExpansionIds.Count > 0)
            {
                _minions = _minions
                    .Where(m => !catalogMinions.TryGetValue(m.MinionId, out var catalogMinion)
                             || catalogMinion.ExpansionId is null
                             || ownedExpansionIds.Contains(catalogMinion.ExpansionId.Value))
                    .ToList();
            }

            _minions = _minions.OrderByDescending(m => m.TotalMatches).ToList();
            _totalMatches = _minions.Sum(m => m.TotalMatches);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Open(MinionStatisticsDto minion)
        => NavManager.NavigateTo($"{Urls.MinionsStatistics}/{minion.MinionId}");
}
