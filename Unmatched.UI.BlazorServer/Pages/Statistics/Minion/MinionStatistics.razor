@page "/minions-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Pages.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IMinionStatisticsService MinionStatisticsService
@using Microsoft.AspNetCore.Components

<div style="margin-bottom: 16px">
    <MinionSummary Statistics="Minion"></MinionSummary>
</div>
<div class="page-content" style="margin-bottom: 16px">
    <TotalMatchesRecord Total="Minion.TotalMatches" Wins="Minion.TotalWins" Looses="Minion.TotalLooses" Kd="Minion.Kd"></TotalMatchesRecord>
    <MonsterMatchupTable Title="Against Heroes" Rows="_heroMatchups"></MonsterMatchupTable>
    <MatchLogGrid MatchLogEntries="_matchLogEntries"></MatchLogGrid>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private MinionStatisticsDto Minion { get; set; } = new();
    private List<UiMatchLogDto> _matchLogEntries = new();
    private List<MonsterMatchupRow> _heroMatchups = new();

    [Inject] protected BlazorBootstrap.PreloadService PreloadService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            Guid.TryParse(Id, out var minionId);
            if (minionId == Guid.Empty)
            {
                return;
            }

            Minion = await MinionStatisticsService.GetMinionStatisticsAsync(minionId);
            _matchLogEntries = (await MinionStatisticsService.GetMinionMatchesAsync(minionId)).OrderByDescending(x => x.Date).ToList();

            _heroMatchups = _matchLogEntries
                .SelectMany(m => m.Fighters)
                .GroupBy(f => f.Hero?.Name ?? "Unknown")
                .Select(g => new MonsterMatchupRow
                    {
                        Name = g.Key,
                        Total = g.Count(),
                        Wins = g.Count(f => f.IsWinner),
                        Looses = g.Count(f => !f.IsWinner)
                    })
                .ToList();
        }
        finally
        {
            PreloadService.Hide();
        }
    }
}
