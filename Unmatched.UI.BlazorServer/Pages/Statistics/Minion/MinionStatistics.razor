@page "/minions-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Pages.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IMinionStatisticsService MinionStatisticsService
@*
    Not in the design pack: the 2a dossier pattern applied to a minion.
*@

<PageHeader Breadcrumbs="Crumbs"/>

<MinionSummary Statistics="_minion"/>

<div class="um-page">
    <MonsterMatchupTable Title="Against heroes" Rows="_heroMatchups"/>
    <MatchList Matches="_matchLog" Title="Match log" PageSize="8" Meta="@($"{_matchLog.Count} matches")"/>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MinionStatisticsDto _minion = new() { Name = string.Empty };
    private List<UiMatchLogDto> _matchLog = new();
    private List<MonsterMatchupRow> _heroMatchups = new();

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Minions", Urls.MinionsStatistics), new(_minion.Name)
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var minionId) || minionId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();

            var stats = MinionStatisticsService.GetMinionStatisticsAsync(minionId);
            var matches = MinionStatisticsService.GetMinionMatchesAsync(minionId);
            await Task.WhenAll(stats, matches);

            _minion = stats.Result;
            _matchLog = matches.Result.OrderByDescending(m => m.Date).ToList();

            _heroMatchups = _matchLog
                .SelectMany(m => m.Fighters)
                .GroupBy(f => f.Hero?.Name ?? "Unknown")
                .Select(g => new MonsterMatchupRow
                    {
                        Name = g.Key,
                        Total = g.Count(),
                        Wins = g.Count(f => f.IsWinner),
                        Looses = g.Count(f => !f.IsWinner)
                    })
                .OrderByDescending(r => r.Total)
                .ToList();
        }
        finally
        {
            PreloadService.Hide();
        }
    }
}
