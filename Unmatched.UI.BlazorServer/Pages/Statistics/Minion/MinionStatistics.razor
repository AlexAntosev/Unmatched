@page "/minions-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Pages.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IMinionStatisticsService MinionStatisticsService
@inject IMinionService MinionService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 2a dossier pattern applied to a minion.
*@

<EntityNavBar EntityNoun="minion" Breadcrumbs="Crumbs" PositionLabel="@PositionLabel"
              PreviousName="@_previousMinion?.Name" PreviousImageUrl="@_previousMinion?.ImageUrl"
              OnPreviousClick="@(() => GoToMinion(_previousMinion))"
              NextName="@_nextMinion?.Name" NextImageUrl="@_nextMinion?.ImageUrl"
              OnNextClick="@(() => GoToMinion(_nextMinion))"/>

<MinionSummary Statistics="_minion"/>

<div class="um-page">
    <MonsterMatchupTable Title="Against heroes" Rows="_heroMatchups"/>
    <MatchList Matches="_matchLog" Title="Match log" PageSize="8" Meta="@($"{_matchLog.Count} matches")"/>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MinionStatisticsDto _minion = new() { Name = string.Empty };
    private List<UiMatchLogDto> _matchLog = new();
    private List<MonsterMatchupRow> _heroMatchups = new();
    private MinionStatisticsDto? _previousMinion;
    private MinionStatisticsDto? _nextMinion;
    private int _rank;
    private int _ladderSize;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Minions", Urls.MinionsStatistics), new(_minion.Name)
    ];

    private string PositionLabel
        => _ladderSize == 0 ? string.Empty : $"Minion {_rank:00} of {_ladderSize} · sorted by matches played";

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var minionId) || minionId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();

            var stats = MinionStatisticsService.GetMinionStatisticsAsync(minionId);
            var matches = MinionStatisticsService.GetMinionMatchesAsync(minionId);
            var ladder = MinionStatisticsService.GetMinionsStatisticsAsync();
            var catalog = MinionService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(stats, matches, ladder, catalog, owned);

            _minion = stats.Result;
            _matchLog = matches.Result.OrderByDescending(m => m.Date).ToList();

            _heroMatchups = _matchLog
                .SelectMany(m => m.Fighters)
                .GroupBy(f => f.Hero?.Name ?? "Unknown")
                .Select(g => new MonsterMatchupRow
                    {
                        Name = g.Key,
                        Total = g.Count(),
                        Wins = g.Count(f => f.IsWinner),
                        Looses = g.Count(f => !f.IsWinner)
                    })
                .OrderByDescending(r => r.Total)
                .ToList();

            var catalogMinions = catalog.Result.ToDictionary(m => m.Id);
            var ownedExpansionIds = owned.Result.ToHashSet();
            BuildNeighbours(FilterByCollection(ladder.Result.ToList(), catalogMinions, ownedExpansionIds), minionId);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    /// <summary>Minions from sets you do not own are excluded from Prev/Next, matching the ladder page.</summary>
    private static List<MinionStatisticsDto> FilterByCollection(
        List<MinionStatisticsDto> minions, Dictionary<Guid, MinionDto> catalogMinions, HashSet<Guid> ownedExpansionIds)
    {
        if (ownedExpansionIds.Count == 0)
        {
            return minions;
        }

        return minions
            .Where(m => !catalogMinions.TryGetValue(m.MinionId, out var catalogMinion)
                     || catalogMinion.ExpansionId is null
                     || ownedExpansionIds.Contains(catalogMinion.ExpansionId.Value))
            .ToList();
    }

    /// <summary>Same order as the Minions ladder (most matches played first), wrapping at the ends.</summary>
    private void BuildNeighbours(List<MinionStatisticsDto> ladder, Guid minionId)
    {
        var ordered = ladder.OrderByDescending(m => m.TotalMatches).ToList();
        var index = ordered.FindIndex(m => m.MinionId == minionId);
        _ladderSize = ordered.Count;

        if (index < 0 || ordered.Count <= 1)
        {
            _rank = index + 1;
            _previousMinion = null;
            _nextMinion = null;
            return;
        }

        _rank = index + 1;
        _previousMinion = ordered[(index - 1 + ordered.Count) % ordered.Count];
        _nextMinion = ordered[(index + 1) % ordered.Count];
    }

    private void GoToMinion(MinionStatisticsDto? minion)
    {
        if (minion is not null)
        {
            NavManager.NavigateTo($"{Urls.MinionsStatistics}/{minion.MinionId}");
        }
    }
}
