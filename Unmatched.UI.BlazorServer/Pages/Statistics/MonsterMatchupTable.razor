@*
    The "Against villains" / "Against minions" records: name, meetings, wins, losses, K/D.
*@
<Panel Title="@Title">
    @if (Rows.Count == 0)
    {
        <div class="monster-empty">No co-op matches recorded yet.</div>
    }
    @foreach (var row in Rows)
    {
        <div class="monster-row">
            <span class="monster-name">@row.Name</span>
            <span class="monster-total">@row.Total</span>
            <span class="monster-wins">@row.Wins</span>
            <span class="monster-losses">@row.Looses</span>
            <span class="monster-kd" style="color:@(row.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                @row.Kd.ToString("0.00")
            </span>
        </div>
    }
</Panel>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<MonsterMatchupRow> Rows { get; set; } = [];
}
