@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Services
@using Unmatched.UI.BlazorServer.Shared.Statistics
@inject IVillainService VillainService
@inject IVillainStatisticsService VillainStatisticsService
@inject IImageUploadService ImageUploadService

<EntityDetailHeader Name="@Statistics.Name" Color="@Statistics.Color" ImageUrl="@BustCache(Statistics.ImageUrl)" OnFileSelected="OnImageSelectedAsync">
    <ExtraContent>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <img src="@Statistics.MeleeRangeImageUrl" alt="@Statistics.Name" height="48" width="auto"/>
            <StatCard Value="@Statistics.Hp.ToString()" Label="Hp"/>
            <StatCard Value="@Statistics.DeckSize.ToString()" Label="Deck size"/>
        </div>
    </ExtraContent>
</EntityDetailHeader>

@code {
    [Parameter]
    public VillainStatisticsDto Statistics { get; set; } = new();

    private int _cacheBust;

    private string BustCache(string? imageUrl) => imageUrl is null ? "/Unknown.png" : $"{imageUrl}?v={_cacheBust}";

    private async Task OnImageSelectedAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(15_000_000);
        var fileName = await ImageUploadService.SaveAsync("villains", Statistics.Name, Statistics.ImageFileName, stream, file.Name);
        await VillainService.UpdateImageAsync(Statistics.VillainId, fileName);
        await VillainStatisticsService.UpdateImageAsync(Statistics.VillainId, fileName);
        Statistics.ImageFileName = fileName;
        _cacheBust++;
        StateHasChanged();
    }
}
