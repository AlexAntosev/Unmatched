@page "/villains-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Pages.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IVillainStatisticsService VillainStatisticsService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 2a dossier pattern applied to a villain.
*@

<EntityNavBar EntityNoun="villain" Breadcrumbs="Crumbs" PositionLabel="@PositionLabel"
              PreviousName="@_previousVillain?.Name" PreviousImageUrl="@_previousVillain?.ImageUrl"
              OnPreviousClick="@(() => GoToVillain(_previousVillain))"
              NextName="@_nextVillain?.Name" NextImageUrl="@_nextVillain?.ImageUrl"
              OnNextClick="@(() => GoToVillain(_nextVillain))"/>

<VillainSummary Statistics="_villain"/>

<div class="um-page">
    <MonsterMatchupTable Title="Against heroes" Rows="_heroMatchups"/>
    <MatchList Matches="_matchLog" Title="Match log" PageSize="8" Meta="@($"{_matchLog.Count} matches")"/>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private VillainStatisticsDto _villain = new() { Name = string.Empty };
    private List<UiMatchLogDto> _matchLog = new();
    private List<MonsterMatchupRow> _heroMatchups = new();
    private VillainStatisticsDto? _previousVillain;
    private VillainStatisticsDto? _nextVillain;
    private int _rank;
    private int _ladderSize;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Villains", Urls.VillainsStatistics), new(_villain.Name)
    ];

    private string PositionLabel
        => _ladderSize == 0 ? string.Empty : $"Villain {_rank:00} of {_ladderSize} · sorted by matches played";

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var villainId) || villainId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();

            var stats = VillainStatisticsService.GetVillainStatisticsAsync(villainId);
            var matches = VillainStatisticsService.GetVillainMatchesAsync(villainId);
            var ladder = VillainStatisticsService.GetVillainsStatisticsAsync();
            await Task.WhenAll(stats, matches, ladder);

            _villain = stats.Result;
            _matchLog = matches.Result.OrderByDescending(m => m.Date).ToList();

            _heroMatchups = _matchLog
                .SelectMany(m => m.Fighters)
                .GroupBy(f => f.Hero?.Name ?? "Unknown")
                .Select(g => new MonsterMatchupRow
                    {
                        Name = g.Key,
                        Total = g.Count(),
                        Wins = g.Count(f => f.IsWinner),
                        Looses = g.Count(f => !f.IsWinner)
                    })
                .OrderByDescending(r => r.Total)
                .ToList();

            BuildNeighbours(ladder.Result.ToList(), villainId);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    /// <summary>Same order as the Villains ladder (most matches played first), wrapping at the ends.</summary>
    private void BuildNeighbours(List<VillainStatisticsDto> ladder, Guid villainId)
    {
        var ordered = ladder.OrderByDescending(v => v.TotalMatches).ToList();
        var index = ordered.FindIndex(v => v.VillainId == villainId);
        _ladderSize = ordered.Count;

        if (index < 0 || ordered.Count <= 1)
        {
            _rank = index + 1;
            _previousVillain = null;
            _nextVillain = null;
            return;
        }

        _rank = index + 1;
        _previousVillain = ordered[(index - 1 + ordered.Count) % ordered.Count];
        _nextVillain = ordered[(index + 1) % ordered.Count];
    }

    private void GoToVillain(VillainStatisticsDto? villain)
    {
        if (villain is not null)
        {
            NavManager.NavigateTo($"{Urls.VillainsStatistics}/{villain.VillainId}");
        }
    }
}
