@page "/villains-statistics"
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@inject IVillainStatisticsService VillainStatisticsService
@inject IVillainService VillainService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 1c ladder pattern, in the villain hue. Villains from sets you do not
    own are hidden, matching the heroes and maps ladders.
*@

<EntityLadder TItem="VillainStatisticsDto" Items="_villains" Title="Villains" ScreenKey="villains"
              Lede="@($"{_villains.Count} villains · {_totalMatches:N0} appearances")"
              Breadcrumbs="Crumbs" Columns="@Columns" SearchText="@(v => v.Name)"
              SearchPlaceholder="Search villain…">
    <Header>
        <div>#</div>
        <div>Villain</div>
        <div class="villains-right">GP</div>
        <div>W / L</div>
        <div class="villains-right">K/D</div>
    </Header>
    <Row>
        <LadderRow Columns="@Columns" Rank="@(_villains.IndexOf(context) + 1)" Name="@context.Name"
                   ImageUrl="@context.ImageUrl" IsRanged="context.IsRanged"
                   EdgeColor="var(--um-villain)" OnClick="@(() => Open(context))">
            <Metrics>
                <div class="villains-matches">@context.TotalMatches</div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
                <div class="villains-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    @context.Kd.ToString("0.00")
                </div>
            </Metrics>
        </LadderRow>
    </Row>
    <Tile>
        <EntityTile Rank="@(_villains.IndexOf(context) + 1)" Name="@context.Name" ImageUrl="@context.ImageUrl"
                    IsRanged="context.IsRanged" Highlighted="@(_villains.IndexOf(context) is >= 0 and <= 2)"
                    OnClick="@(() => Open(context))">
            <Metrics>
                <div class="villains-tile-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    K/D @context.Kd.ToString("0.00")
                </div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
            </Metrics>
        </EntityTile>
    </Tile>
</EntityLadder>

@code {
    private const string Columns = "44px 1fr 58px 90px 62px";

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Villains")];

    private List<VillainStatisticsDto> _villains = new();
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var stats = VillainStatisticsService.GetVillainsStatisticsAsync();
            var catalog = VillainService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(stats, catalog, owned);

            var catalogVillains = catalog.Result.ToDictionary(v => v.Id);
            var ownedExpansionIds = owned.Result.ToHashSet();

            _villains = stats.Result.ToList();

            if (ownedExpansionIds.Count > 0)
            {
                _villains = _villains
                    .Where(v => !catalogVillains.TryGetValue(v.VillainId, out var catalogVillain)
                             || catalogVillain.ExpansionId is null
                             || ownedExpansionIds.Contains(catalogVillain.ExpansionId.Value))
                    .ToList();
            }

            _villains = _villains.OrderByDescending(v => v.TotalMatches).ToList();
            _totalMatches = _villains.Sum(v => v.TotalMatches);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Open(VillainStatisticsDto villain)
        => NavManager.NavigateTo($"{Urls.VillainsStatistics}/{villain.VillainId}");
}
