@page "/players-statistics"
@using Unmatched.Dtos
@using Unmatched.Services.Statistics
@inject IPlayerStatisticsService PlayerStatisticsService
@inject NavigationManager NavManager
@*
    Not in the design pack: built from the 1c ladder pattern, minus the points column players do
    not have.
*@

<EntityLadder TItem="PlayerStatisticsDto" Items="_players" Title="Players" ScreenKey="players"
              Lede="@($"{_players.Count} players · {_totalMatches:N0} recorded appearances")"
              Breadcrumbs="Crumbs" Columns="@Columns" SearchText="@(p => p.Name)"
              SearchPlaceholder="Search player…">
    <Header>
        <div>#</div>
        <div>Player</div>
        <div class="players-right">GP</div>
        <div>W / L</div>
        <div class="players-right">K/D</div>
    </Header>
    <Row>
        <LadderRow Columns="@Columns" Rank="context.Place" Name="@context.Name" ImageUrl="@context.ImageUrl"
                   RoundArt="true" OnClick="@(() => Open(context))">
            <Metrics>
                <div class="players-matches">@context.TotalMatches</div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
                <div class="players-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    @context.Kd.ToString("0.00")
                </div>
            </Metrics>
        </LadderRow>
    </Row>
    <Tile>
        <EntityTile Rank="context.Place" Name="@context.Name" ImageUrl="@context.ImageUrl"
                    Highlighted="@(context.Place is >= 1 and <= 3)" OnClick="@(() => Open(context))">
            <Metrics>
                <div class="players-tile-kd" style="color:@(context.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    K/D @context.Kd.ToString("0.00")
                </div>
                <WinLossBar Wins="context.TotalWins" Losses="context.TotalLooses"/>
            </Metrics>
        </EntityTile>
    </Tile>
</EntityLadder>

@code {
    private const string Columns = "44px 1fr 58px 90px 62px";

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Players")];

    private List<PlayerStatisticsDto> _players = new();
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            _players = (await PlayerStatisticsService.GetPlayersStatisticsAsync())
                .OrderByDescending(p => p.TotalMatches)
                .ToList();
            _totalMatches = _players.Sum(p => p.TotalMatches);

            // Player stats carry no rank of their own, so the list numbers itself by activity.
            for (var i = 0; i < _players.Count; i++)
            {
                _players[i].Place = i + 1;
            }
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Open(PlayerStatisticsDto player)
        => NavManager.NavigateTo($"{Urls.PlayersStatistics}/{player.PlayerId}");
}
