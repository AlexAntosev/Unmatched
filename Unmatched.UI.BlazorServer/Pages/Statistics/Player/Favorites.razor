@using Unmatched.Dtos
@inject NavigationManager NavManager
@*
    Which heroes this player reaches for. The old grid became 1c ladder rows; the "chosen one"
    keeps its gold medal rather than a separate callout.
*@
<Panel Title="Favourite heroes" Meta="@($"{Records.Count} heroes played")">
    @if (Records.Count == 0)
    {
        <div class="favorites-empty">No heroes played yet.</div>
    }
    @foreach (var record in Records)
    {
        <LadderRow Columns="@Columns" Rank="record.Place" Name="@(record.Hero?.Name ?? "Unknown")"
                   ImageUrl="@record.Hero?.ImageUrl" IsRanged="record.Hero?.IsRanged"
                   EdgeColor="@(record.IsChosenOne ? "var(--um-gold)" : null)"
                   OnClick="@(() => Open(record))">
            <Metrics>
                <div class="favorites-matches">@record.TotalMatches</div>
                <WinLossBar Wins="record.TotalWins" Losses="record.TotalLooses"/>
                <div class="favorites-kd" style="color:@(record.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")">
                    @record.Kd.ToString("0.00")
                </div>
            </Metrics>
        </LadderRow>
    }
</Panel>

@code {
    private const string Columns = "34px 1fr 58px 90px 62px";

    [Parameter, EditorRequired]
    public IReadOnlyList<FavoriteStatisticsDto> Records { get; set; } = [];

    private void Open(FavoriteStatisticsDto record)
    {
        if (record.Hero is not null)
        {
            NavManager.NavigateTo($"{Urls.HeroesStatistics}/{record.Hero.Id}");
        }
    }
}
