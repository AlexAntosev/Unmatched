@page "/players-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Pages.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IPlayerStatisticsService PlayerStatisticsService
@inject IFavoriteStatisticsService FavoriteStatisticsService
@*
    Not in the design pack: the 2a dossier pattern applied to a player - banner, favourite heroes
    as ladder rows, the shared 3b match log, and the villain/minion records.
*@

<PageHeader Breadcrumbs="Crumbs"/>

<PlayerSummary Statistics="_player" ChosenOne="_chosenOne"/>

<div class="um-page">
    <Favorites Records="_favorites"/>

    <MatchList Matches="_matchLog" Title="Match log" PageSize="6" Meta="@($"{_matchLog.Count} matches")"/>

    <div class="player-duo">
        <MonsterMatchupTable Title="Against villains" Rows="_villainMatchups"/>
        <MonsterMatchupTable Title="Against minions" Rows="_minionMatchups"/>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private PlayerStatisticsDto _player = new() { Name = string.Empty };
    private List<UiMatchLogDto> _matchLog = new();
    private List<FavoriteStatisticsDto> _favorites = new();
    private List<MonsterMatchupRow> _villainMatchups = new();
    private List<MonsterMatchupRow> _minionMatchups = new();
    private FavoriteStatisticsDto? _chosenOne;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Players", Urls.PlayersStatistics), new(_player.Name)
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var playerId) || playerId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();

            var stats = PlayerStatisticsService.GetPlayerStatisticsAsync(playerId);
            var matches = PlayerStatisticsService.GetPlayerMatchesAsync(playerId);
            var favorites = FavoriteStatisticsService.GetFavoritesStatisticsAsync(playerId);
            await Task.WhenAll(stats, matches, favorites);

            _player = stats.Result;
            _matchLog = matches.Result.OrderByDescending(m => m.Date).ToList();

            _favorites = favorites.Result.OrderByDescending(f => f.TotalMatches).ToList();
            for (var i = 0; i < _favorites.Count; i++)
            {
                _favorites[i].Place = i + 1;
            }

            _chosenOne = _favorites.FirstOrDefault(f => f.IsChosenOne);
            BuildMonsterMatchups();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void BuildMonsterMatchups()
    {
        var coopMatches = _matchLog.Where(m => m.Villain is not null).ToList();

        _villainMatchups = coopMatches
            .GroupBy(m => m.Villain!.Name ?? "Unknown")
            .Select(g => new MonsterMatchupRow
                {
                    Name = g.Key,
                    Total = g.Count(),
                    Wins = g.Count(m => !m.Villain!.IsWinner),
                    Looses = g.Count(m => m.Villain!.IsWinner)
                })
            .OrderByDescending(r => r.Total)
            .ToList();

        _minionMatchups = coopMatches
            .SelectMany(m => m.Villain!.Minions)
            .GroupBy(m => m.Name ?? "Unknown")
            .Select(g => new MonsterMatchupRow
                {
                    Name = g.Key,
                    Total = g.Count(),
                    Wins = g.Count(m => !m.IsWinner),
                    Looses = g.Count(m => m.IsWinner)
                })
            .OrderByDescending(r => r.Total)
            .ToList();
    }
}
