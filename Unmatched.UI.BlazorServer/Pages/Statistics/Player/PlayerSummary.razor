@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@using Unmatched.UI.BlazorServer.Shared.Statistics
@inject IPlayerService PlayerService
@inject IImageUploadService ImageUploadService

<EntityDetailHeader Name="@Statistics.Name" Color="@ChosenOne?.Hero?.Color" ImageUrl="@BustCache(Statistics.ImageUrl)" OnFileSelected="OnImageSelectedAsync">
    <ExtraContent>
        <div class="player-summary-columns">
            <div>
                <h4>Chosen One: @ChosenOne?.Hero?.Name</h4>
                <StatisticsRecord Title="Strongest Hero" HeroMatches="_strongestHeroMatches"></StatisticsRecord>
                <StatisticsRecord Title="Weakest Hero" HeroMatches="_weakestHeroMatches"></StatisticsRecord>
            </div>
            <div>
                <HeroesMatchesPieChart HeroesMatches="_favoritesMatches"></HeroesMatchesPieChart>
            </div>
        </div>
    </ExtraContent>
</EntityDetailHeader>

@code {
    [Parameter]
    public PlayerStatisticsDto Statistics { get; set; } = new();

    [Parameter]
    public List<IGrouping<string, UiFighterDto>> Matches
    {
        get => _matches;
        set
        {
            _matches = value;
            _strongestHeroMatches = _matches
                .OrderByDescending(g => g.Count(f => f.IsWinner))
                .ThenByDescending(g => g.Select(f => f.HpLeft ?? 0).Sum())
                .ThenByDescending(g => g.Select(f => f.SidekickHpLeft ?? 0).Sum())
                .FirstOrDefault();
            _weakestHeroMatches = _matches
                .OrderByDescending(g => g.Count(f => !f.IsWinner))
                .ThenBy(g => g.Select(f => f.HpLeft ?? 0).Sum())
                .ThenBy(g => g.Select(f => f.SidekickHpLeft ?? 0).Sum())
                .FirstOrDefault();
            _favoritesMatches = _matches.OrderByDescending(g => g.Count()).Take(10).ToList();
        }
    }

    [Parameter]
    public FavoriteStatisticsDto? ChosenOne { get; set; }

    private List<IGrouping<string, UiFighterDto>> _matches = new();
    private IGrouping<string, UiFighterDto> _strongestHeroMatches;
    private IGrouping<string, UiFighterDto> _weakestHeroMatches;
    private List<IGrouping<string, UiFighterDto>> _favoritesMatches = new();
    private int _cacheBust;

    private string BustCache(string? imageUrl) => imageUrl is null ? "/Unknown.png" : $"{imageUrl}?v={_cacheBust}";

    private async Task OnImageSelectedAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(15_000_000);
        var fileName = await ImageUploadService.SaveAsync("players", Statistics.Name, Statistics.ImageFileName, stream, file.Name);
        await PlayerService.UpdateImageAsync(Statistics.PlayerId, fileName);
        Statistics.ImageFileName = fileName;
        _cacheBust++;
        StateHasChanged();
    }
}