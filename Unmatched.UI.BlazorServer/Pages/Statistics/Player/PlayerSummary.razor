@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@inject IPlayerService PlayerService
@inject IImageUploadService ImageUploadService
@*
    The player dossier header. The design never drew this screen, so it is assembled from the 2a
    banner: art, name, and the same four stat cards a hero gets.
*@
<EntityBanner Name="@Statistics.Name" Eyebrow="Player profile" ImageUrl="@BustCache(Statistics.ImageUrl)"
              OnFileSelected="OnImageSelectedAsync">
    <Chips>
        @if (ChosenOne?.Hero is not null)
        {
            <span class="player-chosen">
                <i class="bi bi-star-fill"></i>Chosen one · @ChosenOne.Hero.Name
            </span>
        }
    </Chips>
    <Stats>
        <StatTile Label="Matches" Value="@Statistics.TotalMatches.ToString()"/>
        <StatTile Label="Wins" Value="@Statistics.TotalWins.ToString()" ValueColor="var(--um-win)"/>
        <StatTile Label="Losses" Value="@Statistics.TotalLooses.ToString()" ValueColor="var(--um-loss)"/>
        <StatTile Label="K/D" Value="@Statistics.Kd.ToString("0.00")"
                  ValueColor="@(Statistics.Kd >= 1 ? "var(--um-win)" : "var(--um-loss)")"/>
    </Stats>
    <ChildContent>
        <div class="player-winrate">
            <DonutChart Percent="@WinRate" Caption="@($"{Statistics.TotalWins}W · {Statistics.TotalLooses}L")" Size="108"/>
        </div>
    </ChildContent>
</EntityBanner>

@code {
    [Parameter]
    public PlayerStatisticsDto Statistics { get; set; } = new();

    [Parameter]
    public FavoriteStatisticsDto? ChosenOne { get; set; }

    private int _cacheBust;

    private int WinRate
        => Statistics.TotalMatches == 0
            ? 0
            : (int)Math.Round((double)Statistics.TotalWins / Statistics.TotalMatches * 100);

    private string BustCache(string? imageUrl) => imageUrl is null ? "/Unknown.png" : $"{imageUrl}?v={_cacheBust}";

    private async Task OnImageSelectedAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(15_000_000);
        var fileName = await ImageUploadService.SaveAsync("players", Statistics.Name, Statistics.ImageFileName, stream, file.Name);
        await PlayerService.UpdateImageAsync(Statistics.PlayerId, fileName);
        Statistics.ImageFileName = fileName;
        _cacheBust++;
        StateHasChanged();
    }
}
