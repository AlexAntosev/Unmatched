@using Unmatched.Services.Statistics
@*
    "<Name>'s matches" - the same turn 11c row/scoreboard the main match log uses (MatchList),
    scoped to one player's matches, with a win/loss tally and a link back to the full log.
*@
<MatchList Matches="@Entries.Select(e => e.Match)" Title="@($"{PlayerName}'s matches")"
           PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" AllowPageSizeControl="true"
           ResultVariant="@(m => _selfWinByMatchId.TryGetValue(m.MatchId, out var isWin) ? isWin : (bool?)null)">
    <HeaderActions>
        <span class="pm-tally pm-tally-win">W @Wins</span>
        <span class="pm-tally pm-tally-loss">L @Losses</span>
        <a class="pm-full-log" href="@Urls.MatchLog">Full log<i class="bi bi-arrow-right"></i></a>
    </HeaderActions>
</MatchList>

@code {
    [Parameter, EditorRequired]
    public string PlayerName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public IReadOnlyList<PlayerMatchEntry> Entries { get; set; } = [];

    private int _pageSize = 10;
    private Dictionary<Guid, bool> _selfWinByMatchId = new();

    private int Wins => Entries.Count(e => e.Self.IsWinner);

    private int Losses => Entries.Count(e => !e.Self.IsWinner);

    protected override void OnParametersSet()
        => _selfWinByMatchId = Entries.ToDictionary(e => e.Match.MatchId, e => e.Self.IsWinner);

    private void OnPageSizeChanged(int size) => _pageSize = size;
}
