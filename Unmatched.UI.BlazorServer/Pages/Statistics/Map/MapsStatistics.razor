@page "/maps-statistics"
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@inject IMapStatisticsService MapStatisticsService
@inject IMapService MapService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 1c ladder with a map thumbnail instead of a hero token. Maps from
    sets you do not own are hidden, matching the heroes ladder.
*@

<EntityLadder TItem="UiMapStatisticsDto" Items="_maps" Title="Maps" ScreenKey="maps"
              Lede="@($"{_maps.Count} maps · {_totalMatches:N0} matches played")"
              Breadcrumbs="Crumbs" Columns="@Columns" SearchText="@(m => m.Name ?? string.Empty)"
              SearchPlaceholder="Search map…">
    <Header>
        <div>#</div>
        <div>Map</div>
        <div class="maps-right">Matches</div>
    </Header>
    <Row>
        <LadderRow Columns="@Columns" Rank="@(_maps.IndexOf(context) + 1)" Name="@context.Name"
                   ImageUrl="@context.ImageUrl" Fallback="/UnknownMap.png"
                   OnClick="@(() => Open(context))">
            <Metrics>
                <div class="maps-matches">@context.TotalMatches</div>
            </Metrics>
        </LadderRow>
    </Row>
    <Tile>
        <EntityTile Rank="@(_maps.IndexOf(context) + 1)" Name="@context.Name" ImageUrl="@context.ImageUrl"
                    Fallback="/UnknownMap.png" Highlighted="@(_maps.IndexOf(context) is >= 0 and <= 2)"
                    OnClick="@(() => Open(context))">
            <Metrics>
                <div class="maps-tile-matches">@context.TotalMatches matches</div>
            </Metrics>
        </EntityTile>
    </Tile>
</EntityLadder>

@code {
    private const string Columns = "44px 1fr 80px";

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Statistics"), new("Maps")];

    private List<UiMapStatisticsDto> _maps = new();
    private int _totalMatches;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var stats = MapStatisticsService.GetMapsStatisticsAsync();
            var catalog = MapService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(stats, catalog, owned);

            var catalogMaps = catalog.Result.ToDictionary(m => m.Id);
            var ownedExpansionIds = owned.Result.ToHashSet();

            _maps = stats.Result.ToList();
            foreach (var map in _maps.Where(m => catalogMaps.ContainsKey(m.MapId)))
            {
                map.Name = catalogMaps[map.MapId].DisplayName;
            }

            if (ownedExpansionIds.Count > 0)
            {
                _maps = _maps
                    .Where(m => !catalogMaps.TryGetValue(m.MapId, out var catalogMap)
                             || catalogMap.ExpansionId is null
                             || ownedExpansionIds.Contains(catalogMap.ExpansionId.Value))
                    .ToList();
            }

            _maps = _maps.OrderByDescending(m => m.TotalMatches).ToList();
            _totalMatches = _maps.Sum(m => m.TotalMatches);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Open(UiMapStatisticsDto map)
        => NavManager.NavigateTo($"{Urls.MapsStatistics}/{map.MapId}");
}
