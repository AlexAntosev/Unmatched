@page "/maps-statistics"
@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Dtos.Statistics
@using Unmatched.Services.Statistics
@using Unmatched.Services.Contracts
@inject NavigationManager NavManager
@inject IMapStatisticsService MapStatisticsService
@inject IMapService MapService
@inject ICollectionService CollectionService

<div class="page-content">
    <h1 class="page-title">Maps Statistics</h1>
    <SfGrid DataSource="@_maps" AllowPaging="true" AllowSorting="true">
        <GridPageSettings PageSize="20"></GridPageSettings>
        <GridEvents OnRecordClick="RecordClickHandler" TValue="UiMapStatisticsDto"></GridEvents>
        <GridColumns>
            <GridColumn Field="Name" HeaderText="Map" Width="120"></GridColumn>
            <GridColumn Field=@nameof(UiMapStatisticsDto.TotalMatches) HeaderText="Matches" Width="80"></GridColumn>
        </GridColumns>
    </SfGrid>
</div>

@code {
    private List<UiMapStatisticsDto> _maps = new();

    [Inject] protected BlazorBootstrap.PreloadService PreloadService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            _maps = (await MapStatisticsService.GetMapsStatisticsAsync()).OrderBy(x => x.Name).ToList();

            var catalogMaps = (await MapService.GetAsync()).ToDictionary(m => m.Id);
            ApplyDisplayNames(catalogMaps);
            await FilterByCollectionAsync(catalogMaps);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void ApplyDisplayNames(Dictionary<Guid, MapDto> catalogMaps)
    {
        foreach (var map in _maps)
        {
            if (catalogMaps.TryGetValue(map.MapId, out var catalogMap))
            {
                map.Name = catalogMap.DisplayName;
            }
        }
    }

    private async Task FilterByCollectionAsync(Dictionary<Guid, MapDto> catalogMaps)
    {
        var ownedExpansionIds = (await CollectionService.GetOwnedExpansionIdsAsync()).ToHashSet();
        if (ownedExpansionIds.Count == 0)
        {
            return;
        }

        _maps = _maps
            .Where(m => !catalogMaps.TryGetValue(m.MapId, out var catalogMap) || catalogMap.ExpansionId is null || ownedExpansionIds.Contains(catalogMap.ExpansionId.Value))
            .ToList();
    }

    private void RecordClickHandler(RecordClickEventArgs<UiMapStatisticsDto> args)
    {
        var mapId = args.RowData.MapId;
        var url = $"{Urls.MapsStatistics}/{mapId}";
        NavManager.NavigateTo(url);
    }
}