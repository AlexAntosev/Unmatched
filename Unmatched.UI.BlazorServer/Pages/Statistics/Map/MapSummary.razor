@using Unmatched.Dtos

<EntityBanner Name="@Statistics.Name" Eyebrow="Map profile" ImageUrl="@Statistics.ImageUrl"
              Fallback="/UnknownMap.png">
    <Stats>
        <StatTile Label="Matches" Value="@Statistics.TotalMatches.ToString()"/>
    </Stats>
</EntityBanner>

@code {
    [Parameter]
    public UiMapStatisticsDto Statistics { get; set; } = new();
}
