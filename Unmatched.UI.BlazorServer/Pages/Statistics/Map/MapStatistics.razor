@page "/maps-statistics/{id}"
@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IMapStatisticsService MapStatisticsService
@inject IMapService MapService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@*
    Not in the design pack: the 2a dossier pattern applied to a map.
*@

<EntityNavBar EntityNoun="map" Breadcrumbs="Crumbs" PositionLabel="@PositionLabel"
              PreviousName="@_previousMap?.Name" PreviousImageUrl="@_previousMap?.ImageUrl"
              OnPreviousClick="@(() => GoToMap(_previousMap))"
              NextName="@_nextMap?.Name" NextImageUrl="@_nextMap?.ImageUrl"
              OnNextClick="@(() => GoToMap(_nextMap))" Fallback="/UnknownMap.png"/>

<MapSummary Statistics="_map"/>

<div class="um-page">
    <MatchList Matches="_matchLog" Title="Match log" PageSize="8" Meta="@($"{_matchLog.Count} matches")"/>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UiMapStatisticsDto _map = new();
    private List<UiMatchLogDto> _matchLog = new();
    private UiMapStatisticsDto? _previousMap;
    private UiMapStatisticsDto? _nextMap;
    private int _rank;
    private int _ladderSize;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Maps", Urls.MapsStatistics), new(_map.Name ?? string.Empty)
    ];

    private string PositionLabel
        => _ladderSize == 0 ? string.Empty : $"Map {_rank:00} of {_ladderSize} · sorted by matches played";

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var mapId) || mapId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();

            var stats = MapStatisticsService.GetMapStatisticsAsync(mapId);
            var matches = MapStatisticsService.GetMapMatchesAsync(mapId);
            var catalog = MapService.GetAsync();
            var ladder = MapStatisticsService.GetMapsStatisticsAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(stats, matches, catalog, ladder, owned);

            _map = stats.Result;
            var catalogMaps = catalog.Result.ToDictionary(m => m.Id);
            // The stats service stores the internal map name; the catalog knows the printed one.
            if (catalogMaps.TryGetValue(mapId, out var catalogMap))
            {
                _map.Name = catalogMap.DisplayName;
            }

            _matchLog = matches.Result.OrderByDescending(m => m.Date).ToList();

            var ownedExpansionIds = owned.Result.ToHashSet();
            BuildNeighbours(FilterByCollection(ladder.Result.ToList(), catalogMaps, ownedExpansionIds), mapId);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    /// <summary>Maps from sets you do not own are excluded from Prev/Next, matching the ladder page.</summary>
    private static List<UiMapStatisticsDto> FilterByCollection(
        List<UiMapStatisticsDto> maps, Dictionary<Guid, MapDto> catalogMaps, HashSet<Guid> ownedExpansionIds)
    {
        if (ownedExpansionIds.Count == 0)
        {
            return maps;
        }

        return maps
            .Where(m => !catalogMaps.TryGetValue(m.MapId, out var catalogMap)
                     || catalogMap.ExpansionId is null
                     || ownedExpansionIds.Contains(catalogMap.ExpansionId.Value))
            .ToList();
    }

    /// <summary>Same order as the Maps ladder (most matches played first), wrapping at the ends.</summary>
    private void BuildNeighbours(List<UiMapStatisticsDto> ladder, Guid mapId)
    {
        var ordered = ladder.OrderByDescending(m => m.TotalMatches).ToList();
        var index = ordered.FindIndex(m => m.MapId == mapId);
        _ladderSize = ordered.Count;

        if (index < 0 || ordered.Count <= 1)
        {
            _rank = index + 1;
            _previousMap = null;
            _nextMap = null;
            return;
        }

        _rank = index + 1;
        _previousMap = ordered[(index - 1 + ordered.Count) % ordered.Count];
        _nextMap = ordered[(index + 1) % ordered.Count];
    }

    private void GoToMap(UiMapStatisticsDto? map)
    {
        if (map is not null)
        {
            NavManager.NavigateTo($"{Urls.MapsStatistics}/{map.MapId}");
        }
    }
}
