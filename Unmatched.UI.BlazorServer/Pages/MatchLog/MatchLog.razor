@page "/match-log"
@using Unmatched.Dtos
@using Unmatched.Enums
@using Unmatched.Services.Contracts
@using Unmatched.Services.Statistics
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@using Unmatched.UI.BlazorServer.Services
@inject IMatchService MatchService
@inject IPlayerService PlayerService
@inject IHeroService HeroService
@inject IMapService MapService
@inject ITournamentService TournamentService
@inject ICollectionService CollectionService
@inject NavigationManager NavigationManager
@inject AppSettingsService AppSettingsService
@*
    Screen 6a. The whole log is loaded once and filtered in memory - at this app's volume that is
    cheaper and simpler than a request per keystroke, and it keeps the KPI strip in agreement with
    the rows underneath it.
*@

<PageHeader Breadcrumbs="Crumbs">
    <Controls>
        <UmSearchBox Value="@_filter.Search" ValueChanged="OnSearchChanged"/>
        @* Export is in the design but has no backend yet, so it is present and disabled. *@
        <UmButton Size="sm" Icon="bi-download" Disabled="true" Title="Export is not available yet">Export</UmButton>
        <UmButton Size="sm" Variant="primary" Icon="bi-plus-lg" OnClick="GoToAddMatch">Add match</UmButton>
    </Controls>
</PageHeader>

<div class="log-kpis">
    <KpiCard Icon="bi-controller" Label="Matches" Value="@_metrics.TotalMatches.ToString("N0")"
             Sub="@($"+{_metrics.AddedThisWeek} this week")" SubColor="var(--um-win)"/>
    <KpiCard Icon="bi-calendar3" Label="This month" Value="@_metrics.MatchesThisMonth.ToString()"
             Sub="@($"{_metrics.SessionsThisMonth} sessions")"/>
    <KpiCard Icon="bi-star-fill" Label="Avg. epic" Value="@_metrics.AverageEpic.ToString("0.#")" Sub="of 3"/>
    <KpiCard Icon="bi-fire" Label="Longest streak" Value="@(_metrics.LongestStreak?.Length.ToString() ?? "–")"
             Sub="@_metrics.LongestStreak?.Caption"/>
</div>

<div class="log-filters">
    <SegmentedControl TValue="GameMode?" Variant="bar" Options="ModeFilters"
                      Value="_filter.Mode" ValueChanged="OnModeChanged"/>
    <div class="log-filters-divider"></div>

    <UmMultiSelect TValue="Guid" Icon="bi-people" Label="Players" Value="_filter.PlayerIds.ToList()"
                   ValueChanged="OnPlayersChanged" Options="PlayerOptions()"/>

    <UmMultiSelect TValue="Guid" Icon="bi-shield" Label="Heroes" Value="_filter.HeroIds.ToList()"
                   ValueChanged="OnHeroesChanged" Options="HeroOptions()"/>

    <UmMultiSelect TValue="string" Icon="bi-map" Label="Maps" Value="_filter.MapNames.ToList()"
                   ValueChanged="OnMapsChanged" Options="MapOptions()"/>

    <UmMultiSelect TValue="string" Icon="bi-flag" Label="Tournaments" Value="_filter.TournamentNames.ToList()"
                   ValueChanged="OnTournamentsChanged" Options="TournamentOptions()"/>

    <UmMultiSelect TValue="int" Icon="bi-calendar3" Label="Date range" Value="_filter.RangeDays.ToList()"
                   ValueChanged="OnRangeChanged" Options="RangeOptions"/>

    <div class="um-spacer"></div>
    <div class="log-count">@($"{_filtered.Count} of {_all.Count} matches")</div>
</div>

@if (!_filter.IsEmpty)
{
    <div class="log-chips">
        @foreach (var value in _filter.PlayerIds)
        {
            <FilterChip Label="@PlayerName(value)" OnRemove="@(() => RemovePlayer(value))"/>
        }
        @foreach (var value in _filter.HeroIds)
        {
            <FilterChip Label="@HeroName(value)" OnRemove="@(() => RemoveHero(value))"/>
        }
        @foreach (var value in _filter.MapNames)
        {
            <FilterChip Label="@MapDisplayName(value)" OnRemove="@(() => RemoveMap(value))"/>
        }
        @foreach (var value in _filter.TournamentNames)
        {
            <FilterChip Label="@value" OnRemove="@(() => RemoveTournament(value))"/>
        }
        @foreach (var value in _filter.RangeDays)
        {
            <FilterChip Label="@RangeLabel(value)" OnRemove="@(() => RemoveRange(value))"/>
        }
        <ClearAllFiltersChip OnClick="ClearAllFilters"/>
    </div>
}

<div class="log-body">
    <MatchList Matches="_filtered" PageSize="_pageSize" AllowPageSizeControl="true" PageSizeChanged="OnPageSizeChanged"/>
</div>

@code {
    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Play"), new("Match log")];

    private static readonly IReadOnlyList<SelectOption<GameMode?>> ModeFilters =
    [
        new(null, "All", "bi-grid-fill"),
        new(GameMode.OneVsOne, "1v1", "bi-person-fill", "var(--um-mode-1v1)"),
        new(GameMode.TeamVsTeam, "2v2", "bi-people-fill", "var(--um-mode-2v2)"),
        new(GameMode.FreeForAll, "FFA", "bi-diagram-3-fill", "var(--um-mode-ffa)"),
        new(GameMode.Cooperative, "Co-op", "bi-shield-fill", "var(--um-mode-coop)")
    ];

    private static readonly IReadOnlyList<SelectOption<int>> RangeOptions =
    [
        new(30, "Last 30 days"), new(90, "Last 3 months"), new(365, "Last year")
    ];

    private readonly MatchLogFilter _filter = new();

    private List<UiMatchLogDto> _all = new();
    private List<UiMatchLogDto> _filtered = new();
    private List<UiPlayerDto> _players = new();
    private List<UiHeroDto> _heroes = new();
    private List<MapDto> _maps = new();
    private List<Dtos.Match.TournamentDto> _tournaments = new();
    private HashSet<Guid> _ownedExpansionIds = new();
    private MatchLogMetrics _metrics = MatchLogMetrics.Empty;
    private int _pageSize = 10;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The default seeds from Settings; the footer's segmented control only overrides it
            // for this session, so it is never written back here.
            _pageSize = await AppSettingsService.GetMatchesPerPageAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var matches = MatchService.GetMatchLogAsync();
            var players = PlayerService.GetAsync();
            var heroes = HeroService.GetAsync();
            var maps = MapService.GetAsync();
            var tournaments = TournamentService.GetAsync();
            var owned = CollectionService.GetOwnedExpansionIdsAsync();
            await Task.WhenAll(matches, players, heroes, maps, tournaments, owned);

            _ownedExpansionIds = owned.Result.ToHashSet();
            _all = matches.Result.OrderByDescending(m => m.Date).ToList();
            _players = players.Result.OrderBy(p => p.Name).ToList();
            _heroes = FilterByCollection(heroes.Result, h => h.ExpansionId).OrderBy(h => h.Name).ToList();
            _maps = FilterByCollection(maps.Result, m => m.ExpansionId).OrderBy(m => m.DisplayName).ToList();
            _tournaments = tournaments.Result.OrderBy(t => t.Name).ToList();

            // The KPI strip describes the whole log, not the current filter.
            _metrics = MatchLogMetrics.Calculate(_all, DateTime.Today);
            ApplyFilter();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void ApplyFilter() => _filtered = _filter.Apply(_all).ToList();

    /// <summary>Entities from sets you do not own are hidden - unless nothing is marked as owned yet.</summary>
    private List<T> FilterByCollection<T>(IEnumerable<T> items, Func<T, Guid?> expansionIdSelector)
        => _ownedExpansionIds.Count == 0
            ? items.ToList()
            : items.Where(i => expansionIdSelector(i) is not { } expansionId || _ownedExpansionIds.Contains(expansionId)).ToList();

    private IReadOnlyList<SelectOption<Guid>> PlayerOptions()
        => _players
            .Select(p => new SelectOption<Guid>(p.Id, p.Name ?? "Unknown", AvatarUrl: p.ImageUrl,
                Count: _all.Count(m => m.Fighters.Any(f => f.PlayerId == p.Id))))
            .ToList();

    private IReadOnlyList<SelectOption<Guid>> HeroOptions()
        => _heroes
            .Select(h => new SelectOption<Guid>(h.Id, h.Name, ArtUrl: h.ImageUrl,
                Count: _all.Count(m => m.Fighters.Any(f => f.HeroId == h.Id))))
            .ToList();

    private IReadOnlyList<SelectOption<string>> MapOptions()
        => _maps
            .Select(m => new SelectOption<string>(m.Name, m.DisplayName,
                Count: _all.Count(match => match.MapName == m.Name)))
            .ToList();

    private IReadOnlyList<SelectOption<string>> TournamentOptions()
        => _tournaments
            .Select(t => new SelectOption<string>(t.Name, t.Name,
                Count: _all.Count(m => m.TournamentName == t.Name)))
            .ToList();

    private string PlayerName(Guid playerId) => _players.FirstOrDefault(p => p.Id == playerId)?.Name ?? "Unknown";

    private string HeroName(Guid heroId) => _heroes.FirstOrDefault(h => h.Id == heroId)?.Name ?? "Unknown";

    private string MapDisplayName(string mapName)
        => _maps.FirstOrDefault(m => m.Name == mapName)?.DisplayName ?? mapName;

    private static string RangeLabel(int days) => RangeOptions.First(o => o.Value == days).Label;

    private void OnModeChanged(GameMode? mode)
    {
        _filter.Mode = mode;
        ApplyFilter();
    }

    private void OnPlayersChanged(IReadOnlyList<Guid> playerIds)
    {
        _filter.PlayerIds = playerIds.ToHashSet();
        ApplyFilter();
    }

    private void OnHeroesChanged(IReadOnlyList<Guid> heroIds)
    {
        _filter.HeroIds = heroIds.ToHashSet();
        ApplyFilter();
    }

    private void OnMapsChanged(IReadOnlyList<string> mapNames)
    {
        _filter.MapNames = mapNames.ToHashSet();
        ApplyFilter();
    }

    private void OnTournamentsChanged(IReadOnlyList<string> tournamentNames)
    {
        _filter.TournamentNames = tournamentNames.ToHashSet();
        ApplyFilter();
    }

    private void OnRangeChanged(IReadOnlyList<int> rangeDays)
    {
        _filter.RangeDays = rangeDays.ToHashSet();
        ApplyFilter();
    }

    private void OnSearchChanged(string? search)
    {
        _filter.Search = search;
        ApplyFilter();
    }

    private void RemovePlayer(Guid playerId)
    {
        _filter.PlayerIds.Remove(playerId);
        ApplyFilter();
    }

    private void RemoveHero(Guid heroId)
    {
        _filter.HeroIds.Remove(heroId);
        ApplyFilter();
    }

    private void RemoveMap(string mapName)
    {
        _filter.MapNames.Remove(mapName);
        ApplyFilter();
    }

    private void RemoveTournament(string tournamentName)
    {
        _filter.TournamentNames.Remove(tournamentName);
        ApplyFilter();
    }

    private void RemoveRange(int days)
    {
        _filter.RangeDays.Remove(days);
        ApplyFilter();
    }

    private void ClearAllFilters()
    {
        _filter.Clear();
        ApplyFilter();
    }

    private void GoToAddMatch() => NavigationManager.NavigateTo(Urls.AddMatch);

    private void OnPageSizeChanged(int size) => _pageSize = size;
}
