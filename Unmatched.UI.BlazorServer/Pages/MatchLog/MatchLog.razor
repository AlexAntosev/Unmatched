@page "/match-log"
@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Enums
@using Unmatched.Services
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Shared.MatchLog
@inject IMatchService MatchService

<div class="page-content">
    <h1 class="page-title">Match Log</h1>

    <MatchLogGrid MatchLogEntries="_filteredEntries"></MatchLogGrid>
</div>

@code {
    [Parameter, SupplyParameterFromQuery]
    public string? Mode { get; set; }

    private List<UiMatchLogDto> _matchLogEntries = new();
    private List<UiMatchLogDto> _filteredEntries = new();

    [Inject] protected BlazorBootstrap.PreloadService PreloadService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            _matchLogEntries = (await MatchService.GetMatchLogAsync()).OrderByDescending(x => x.Date).ToList();
            foreach (var matchLogEntry in _matchLogEntries)
            {
                matchLogEntry.Fighters = matchLogEntry.Fighters.OrderBy(x => x.Turn);
            }

            ApplyFilter();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    protected override void OnParametersSet()
    {
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredEntries = Enum.TryParse<GameMode>(Mode, out var mode)
            ? _matchLogEntries.Where(m => m.GameMode == mode).ToList()
            : _matchLogEntries;
    }
}
