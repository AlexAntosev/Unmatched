@using Unmatched.Dtos
@*
    The co-op villain card and its minion column (design/IMPLEMENTATION-PROMPT.md §5.2, revision 3
    turn 14a): the villain is the same 180px vertical card as a fighter, minus a turn badge, a drag
    handle, a sidekick row and a player - it always acts last (fixed) and is never dragged. Minions
    are 132px cards in a column to its right, each with only an HP stepper (no Count - the DTO has
    no such field, so today's one-row-per-minion-instance model stays, just restyled).
*@
<div class="villain-row">
    <div class="match-card" style="width:180px">
        <div class="match-card-art-wrap" style="height:118px">
            <img class="match-card-art @(IsWinner ? "is-winner" : null) @(IsLoser ? "is-grayscale" : null)"
                 src="@(MatchVillain.Villain?.ImageUrl ?? "/Unknown.png")" alt="@MatchVillain.Villain?.Name"
                 onerror="this.onerror=null;this.src='/Unknown.png'"/>
            @if (IsLoser)
            {
                <div class="match-card-loser-veil"><i class="bi bi-x-lg" style="font-size:44px"></i></div>
            }
        </div>

        <UmSelect TValue="Guid" Variant="chip" Icon="bi-eye" Class="match-card-select"
                  Value="MatchVillain.VillainId" ValueChanged="OnVillainChanged" Options="VillainOptions()"/>

        <div class="match-card-fields">
            <Stepper Label="@HpFieldLabel" Value="MatchVillain.HpLeft" Max="EffectiveMaxHp"
                     IsAlert="@(IsLoser && MatchVillain.HpLeft == 0)" ValueChanged="OnHpChangedAsync"/>
            <Stepper Label="CARDS" Value="null" Dash="true"/>
        </div>
    </div>

    <div class="villain-minion-column">
        @foreach (var minion in MatchVillain.Minions.ToList())
        {
            <div class="match-card" style="width:132px">
                <div class="match-card-art-wrap" style="height:78px">
                    <img class="match-card-art" src="@(minion.Minion?.ImageUrl ?? "/Unknown.png")" alt="@minion.Minion?.Name"
                         onerror="this.onerror=null;this.src='/Unknown.png'"/>
                    <div class="minion-badge">MINION</div>
                    <button type="button" class="match-card-remove" title="Remove minion"
                            @onclick="() => RemoveMinion(minion)" @onclick:stopPropagation="true">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>

                <UmSelect TValue="Guid" Variant="chip" Class="match-card-select"
                          Value="minion.MinionId" ValueChanged="@(id => OnMinionChanged(minion, id))" Options="MinionOptions()"/>

                <div class="match-card-fields">
                    <Stepper Label="HP" Value="minion.HpLeft" Max="@(minion.Minion?.Hp ?? 0)"
                             ValueChanged="@(v => OnMinionHpChangedAsync(minion, v))"/>
                </div>
            </div>
        }

        <button type="button" class="villain-add-minion" @onclick="OnAddMinion">
            <i class="bi bi-plus-lg"></i><span>Add minion</span>
        </button>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<VillainDto> Villains { get; set; } = [];

    [Parameter]
    public IReadOnlyList<MinionDto> Minions { get; set; } = [];

    [Parameter, EditorRequired]
    public UiMatchVillainDto MatchVillain { get; set; } = new();

    /// <summary>Co-op HP scales with the number of heroes facing the villain - see
    /// <see cref="VillainDto.EffectiveHp"/> - so the caller passes how many are currently in the match.</summary>
    [Parameter]
    public int HeroCount { get; set; } = 2;

    [Parameter]
    public bool IsWinner { get; set; }

    [Parameter]
    public bool IsLoser { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnAddMinion { get; set; }

    [Parameter]
    public EventCallback<int?> HpChanged { get; set; }

    [Parameter]
    public EventCallback<(UiMatchMinionDto Minion, int? Value)> MinionHpChanged { get; set; }

    private int EffectiveMaxHp => MatchVillain.Villain?.EffectiveHp(HeroCount) ?? 0;

    private string HpFieldLabel => MatchVillain.Villain is null ? "HP" : $"HP · max {EffectiveMaxHp} ({HeroCount}p)";

    private IReadOnlyList<SelectOption<Guid>> VillainOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Villain…") }
            .Concat(Villains.Select(v => new SelectOption<Guid>(v.Id, v.Name, ArtUrl: v.ImageUrl)))
            .ToList();

    private IReadOnlyList<SelectOption<Guid>> MinionOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Minion…") }
            .Concat(Minions.Select(m => new SelectOption<Guid>(m.Id, m.Name, ArtUrl: m.ImageUrl)))
            .ToList();

    private Task OnVillainChanged(Guid villainId)
    {
        MatchVillain.Villain = Villains.FirstOrDefault(v => v.Id == villainId);
        MatchVillain.SetDefaultData(HeroCount);
        return OnChanged.InvokeAsync();
    }

    private Task OnHpChangedAsync(int? value) => HpChanged.InvokeAsync(value);

    private Task OnMinionChanged(UiMatchMinionDto matchMinion, Guid minionId)
    {
        matchMinion.Minion = Minions.FirstOrDefault(m => m.Id == minionId);
        matchMinion.SetDefaultData();
        return OnChanged.InvokeAsync();
    }

    private Task OnMinionHpChangedAsync(UiMatchMinionDto matchMinion, int? value)
        => MinionHpChanged.InvokeAsync((matchMinion, value));

    private Task RemoveMinion(UiMatchMinionDto matchMinion)
    {
        MatchVillain.Minions = MatchVillain.Minions.Where(m => m != matchMinion).ToList();
        return OnChanged.InvokeAsync();
    }
}
