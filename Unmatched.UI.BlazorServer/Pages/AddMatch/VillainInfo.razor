@using Microsoft.AspNetCore.Components
@using Syncfusion.Blazor.DropDowns
@using Unmatched.Dtos

<fieldset class="wrapper">
    <legend class="title">Villain</legend>
    <div>
        <label for="villain">Villain:</label>
        <SfComboBox TValue="Guid" TItem="VillainDto" DataSource="@Villains" Value="@MatchVillain.VillainId"
                    ValueChanged="@((Guid value) => VillainChanged(value))"
                    AllowFiltering="true" Placeholder="Search villain..." id="villain" CssClass="rounded-form">
            <ComboBoxFieldSettings Value="Id" Text="Name"></ComboBoxFieldSettings>
        </SfComboBox>
        <ValidationMessage For="() => MatchVillain.VillainId"/>
    </div>
    <div>
        <label for="villainHp">HP:</label>
        <InputNumber @bind-Value=MatchVillain.HpLeft id="villainHp" class="form-control transparent rounded-form"/>
    </div>
    <div>
        <label for="villainCardsLeft">Cards Left:</label>
        <InputNumber @bind-Value=MatchVillain.CardsLeft id="villainCardsLeft" class="form-control transparent rounded-form"/>
    </div>
</fieldset>

<div class="page-content">
    <label>Minions:</label>
    <button type="button" class="btn btn-secondary rounded-form" @onclick="AddMinion">+ Add minion</button>
    @foreach (var minion in MatchVillain.Minions.ToList())
    {
        <div style="display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px;">
            <SfComboBox TValue="Guid" TItem="MinionDto" DataSource="@Minions" Value="@minion.MinionId"
                        ValueChanged="@((Guid value) => MinionChanged(minion, value))"
                        AllowFiltering="true" Placeholder="Search minion..." CssClass="rounded-form">
                <ComboBoxFieldSettings Value="Id" Text="Name"></ComboBoxFieldSettings>
            </SfComboBox>
            <label>HP:</label>
            <InputNumber @bind-Value=minion.HpLeft class="form-control transparent rounded-form"/>
            <button type="button" class="btn btn-secondary rounded-form" @onclick="() => RemoveMinion(minion)">✕</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<VillainDto> Villains { get; set; } = new();

    [Parameter]
    public List<MinionDto> Minions { get; set; } = new();

    [Parameter]
    public UiMatchVillainDto MatchVillain { get; set; } = new();

    private void VillainChanged(Guid villainId)
    {
        var villain = Villains.FirstOrDefault(v => v.Id == villainId);
        MatchVillain.Villain = villain;
        MatchVillain.SetDefaultData();
    }

    private void MinionChanged(UiMatchMinionDto matchMinion, Guid minionId)
    {
        var minion = Minions.FirstOrDefault(m => m.Id == minionId);
        matchMinion.Minion = minion;
        matchMinion.SetDefaultData();
    }

    private void AddMinion()
    {
        MatchVillain.Minions = MatchVillain.Minions.Append(new UiMatchMinionDto()).ToList();
    }

    private void RemoveMinion(UiMatchMinionDto matchMinion)
    {
        MatchVillain.Minions = MatchVillain.Minions.Where(m => m != matchMinion).ToList();
    }
}

<style>
    .wrapper {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      column-gap: 24px;
      row-gap: 4px;
    }
    .title {
        grid-column: 1 / -1;
        grid-row-start: 1;
        grid-row-end: 2;
        text-align: center;
        opacity: 0.9 !important;
        color: white;
        text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
    }
</style>
