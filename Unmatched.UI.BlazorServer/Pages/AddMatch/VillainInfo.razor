@using Unmatched.Dtos
@*
    The co-op villain plate (design/IMPLEMENTATION-PROMPT.md §5.5): no player avatar, no sidekick,
    no cards field - just the villain art (assets/Unknown.png when unset), the Villain picker and
    HP. It never carries a turn-order badge (the villain always acts last, fixed) and is not
    draggable. Minions are indented 16px beneath it.
*@
<div class="villain">
    <div class="plate @(IsLoser ? "is-loser" : null)">
        <div class="plate-art-wrap" style="width:64px;height:64px">
            <img class="plate-art @(IsLoser ? "is-grayscale" : null)"
                 src="@(MatchVillain.Villain?.ImageUrl ?? "/Unknown.png")" alt="@MatchVillain.Villain?.Name"
                 onerror="this.onerror=null;this.src='/Unknown.png'"/>
            @if (IsLoser)
            {
                <div class="plate-loser-veil"><i class="bi bi-x-lg" style="font-size:30px"></i></div>
            }
        </div>
        <div class="plate-stacked-fields">
            <div class="plate-line">
                <UmSelect TValue="Guid" Variant="chip" Icon="bi-eye"
                          Value="MatchVillain.VillainId" ValueChanged="OnVillainChanged" Options="VillainOptions()"/>
            </div>
            <div class="plate-line">
                <UmField Label="@HpFieldLabel" Class="fighter-narrow">
                    <UmTextField Type="number" Variant="xs" Centered="true" Min="0" Max="@EffectiveMaxHp.ToString()"
                                 Value="@MatchVillain.HpLeft?.ToString()" ValueChanged="OnHpChangedAsync"/>
                </UmField>
            </div>
        </div>
    </div>

    @foreach (var minion in MatchVillain.Minions.ToList())
    {
        <div class="minion">
            <HeroToken ImageUrl="@(minion.Minion?.ImageUrl ?? "/Unknown.png")" Alt="@minion.Minion?.Name"
                       Size="30" Radius="9" Opacity="0.85"/>
            <div class="minion-identity">
                <div class="minion-select-spacer"></div>
                <UmSelect TValue="Guid" Variant="chip" Value="minion.MinionId"
                          ValueChanged="@(id => OnMinionChanged(minion, id))" Options="MinionOptions()"/>
                <span class="minion-count">×1 on the board</span>
            </div>
            <UmField Label="HP" Class="minion-hp">
                <UmTextField Type="number" Variant="xs" Centered="true" Value="@minion.HpLeft?.ToString()"
                             ValueChanged="@(v => OnMinionHpChangedAsync(minion, v))"/>
            </UmField>
            <button type="button" class="minion-remove" title="Remove minion" @onclick="() => RemoveMinion(minion)">
                <i class="bi bi-trash3"></i>
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<VillainDto> Villains { get; set; } = [];

    [Parameter]
    public IReadOnlyList<MinionDto> Minions { get; set; } = [];

    [Parameter, EditorRequired]
    public UiMatchVillainDto MatchVillain { get; set; } = new();

    /// <summary>Co-op HP scales with the number of heroes facing the villain - see
    /// <see cref="VillainDto.EffectiveHp"/> - so the caller passes how many are currently in the match.</summary>
    [Parameter]
    public int HeroCount { get; set; } = 2;

    [Parameter]
    public bool IsLoser { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<int?> HpChanged { get; set; }

    [Parameter]
    public EventCallback<(UiMatchMinionDto Minion, int? Value)> MinionHpChanged { get; set; }

    private int EffectiveMaxHp => MatchVillain.Villain?.EffectiveHp(HeroCount) ?? 0;

    private string HpFieldLabel => MatchVillain.Villain is null ? "HP" : $"HP · max {EffectiveMaxHp} ({HeroCount}p)";

    private static int? ParseInt(string? value) => int.TryParse(value, out var parsed) ? parsed : null;

    private int? ClampToMax(int? value) => value is null ? null : Math.Clamp(value.Value, 0, EffectiveMaxHp);

    private IReadOnlyList<SelectOption<Guid>> VillainOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Villain…") }
            .Concat(Villains.Select(v => new SelectOption<Guid>(v.Id, v.Name, ArtUrl: v.ImageUrl)))
            .ToList();

    private IReadOnlyList<SelectOption<Guid>> MinionOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Minion…") }
            .Concat(Minions.Select(m => new SelectOption<Guid>(m.Id, m.Name, ArtUrl: m.ImageUrl)))
            .ToList();

    private Task OnVillainChanged(Guid villainId)
    {
        MatchVillain.Villain = Villains.FirstOrDefault(v => v.Id == villainId);
        MatchVillain.SetDefaultData(HeroCount);
        return OnChanged.InvokeAsync();
    }

    private Task OnHpChangedAsync(string? value) => HpChanged.InvokeAsync(ClampToMax(ParseInt(value)));

    private Task OnMinionChanged(UiMatchMinionDto matchMinion, Guid minionId)
    {
        matchMinion.Minion = Minions.FirstOrDefault(m => m.Id == minionId);
        matchMinion.SetDefaultData();
        return OnChanged.InvokeAsync();
    }

    private Task OnMinionHpChangedAsync(UiMatchMinionDto matchMinion, string? value)
        => MinionHpChanged.InvokeAsync((matchMinion, ParseInt(value)));

    private Task RemoveMinion(UiMatchMinionDto matchMinion)
    {
        MatchVillain.Minions = MatchVillain.Minions.Where(m => m != matchMinion).ToList();
        return OnChanged.InvokeAsync();
    }
}
