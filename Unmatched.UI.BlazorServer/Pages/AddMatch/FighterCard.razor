@using Unmatched.Dtos
@using Unmatched.Extensions
@*
    One participant card on the match sheet (design/IMPLEMENTATION-PROMPT.md §5.2, revision 3 turn
    14a): a 180px vertical card - hero art with a drag-handle strip across its top, a turn badge
    bottom-left, an FFA place medal bottom-right (click cycles the place), then the hero dropdown,
    the player dropdown, and HP left / Cards / Sidekick as full-width steppers. The winner control
    lives on the side header in every mode (see AddMatch.razor), not on the card.
*@
<div class="match-card @(_isDragOver ? "is-drag-over" : null) @(_dragging ? "is-dragging" : null)"
     style="width:180px" draggable="@AllowDrag"
     @onmouseup="Disarm"
     @ondragstart="HandleDragStart" @ondragstart:preventDefault="@(!_armed)" @ondragstart:stopPropagation="true"
     @ondragover="HandleDragOver" @ondragover:preventDefault="true" @ondragover:stopPropagation="true"
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDrop" @ondrop:preventDefault="true" @ondrop:stopPropagation="true"
     @ondragend="HandleDragEnd">

    <div class="match-card-art-wrap" style="height:118px">
        <img class="match-card-art @(IsWinner ? "is-winner" : null) @(IsLoser ? "is-grayscale" : null)"
             src="@Fighter.HeroImageUrl" alt="@Fighter.Hero?.Name"
             onerror="this.onerror=null;this.src='/Unknown.png'"/>

        @if (AllowDrag)
        {
            <div class="match-card-grip" title="Drag to change turn order"
                 @onmousedown="Arm" @onmousedown:stopPropagation="true">
                <i class="bi bi-grip-horizontal"></i>
            </div>
        }

        @if (ShowTurnBadge && Fighter.Turn is not null)
        {
            <div class="match-card-turn-badge">@Fighter.Turn</div>
        }

        @if (ShowPlace)
        {
            var badge = PlaceBadge(Fighter.Placement);
            <button type="button" class="match-card-place-badge" style="color:@badge.Color" title="Cycle place"
                    @onclick="CyclePlace" @onclick:stopPropagation="true">
                <i class="bi @badge.Icon"></i><span>@badge.Label</span>
            </button>
        }

        @if (OnRemove.HasDelegate)
        {
            <button type="button" class="match-card-remove" title="Remove player" @onclick="OnRemove" @onclick:stopPropagation="true">
                <i class="bi bi-trash3"></i>
            </button>
        }

        @if (IsLoser)
        {
            <div class="match-card-loser-veil"><i class="bi bi-x-lg" style="font-size:44px"></i></div>
        }
    </div>

    <UmSelect TValue="Guid" Variant="chip" Highlighted="true" Class="match-card-select"
              Value="Fighter.HeroId" ValueChanged="OnHeroChanged" OnRandomize="RandomizeHero" Options="HeroOptions()"/>

    <UmSelect TValue="Guid" Variant="chip" Class="match-card-select" AvatarUrl="@Fighter.PlayerImageUrl"
              Value="Fighter.PlayerId" ValueChanged="OnPlayerChanged" Options="PlayerOptions()"/>

    <div class="match-card-fields">
        <Stepper Label="HP LEFT" Value="Fighter.HpLeft" Max="40" IsAlert="@(IsLoser && Fighter.HpLeft == 0)"
                 ValueChanged="OnHpChangedAsync"/>
        <Stepper Label="CARDS" Value="Fighter.CardsLeft" Max="40" ValueChanged="OnCardsChangedAsync"/>
        <Stepper Label="SIDEKICK" Value="Fighter.SidekickHpLeft" Max="20" Dash="@(Fighter.SidekickName is null)"
                 ValueChanged="OnSidekickChangedAsync"/>
    </div>
</div>

@code {
    private static readonly IReadOnlyDictionary<int, (string Label, string Color, string Icon)> PlaceBadges = new Dictionary<int, (string, string, string)>
    {
        [1] = ("1ST", "var(--um-gold)", "bi-trophy-fill"),
        [2] = ("2ND", "var(--um-silver)", "bi-award-fill"),
        [3] = ("3RD", "var(--um-bronze)", "bi-award-fill"),
        [4] = ("4TH", "var(--um-text-muted)", "bi-award")
    };

    private bool _isDragOver;
    private bool _dragging;

    /// <summary>Set true only by a mousedown on the grip strip - an actual drag gesture starting
    /// anywhere else on the card is cancelled in HandleDragStart, so the hero/player dropdowns and
    /// the steppers stay clickable (design/IMPLEMENTATION-PROMPT.md §5.2: "this strip is the only
    /// place a card can be grabbed").</summary>
    private bool _armed;

    [Parameter, EditorRequired]
    public UiFighterDto Fighter { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<UiPlayerDto> Players { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<UiHeroDto> Heroes { get; set; } = [];

    [Parameter]
    public bool ShowPlace { get; set; }

    [Parameter]
    public bool ShowTurnBadge { get; set; } = true;

    /// <summary>Whether this card's grip strip (and the drag machinery behind it) renders at all -
    /// false for co-op, which has no turn order.</summary>
    [Parameter]
    public bool AllowDrag { get; set; } = true;

    [Parameter]
    public bool IsWinner { get; set; }

    [Parameter]
    public bool IsLoser { get; set; }

    /// <summary>Whether the match is Ranked - gates whether picking a hero fills in the stat fields
    /// (Ranked) or clears them (Unranked, which allows nulls instead of stale/fabricated numbers).</summary>
    [Parameter]
    public bool IsRanked { get; set; }

    [Parameter]
    public int MaxPlace { get; set; } = 4;

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<int?> HpChanged { get; set; }

    [Parameter]
    public EventCallback<UiFighterDto> OnDragStart { get; set; }

    [Parameter]
    public EventCallback<UiFighterDto> OnDroppedOn { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    private static (string Label, string Color, string Icon) PlaceBadge(int? placement)
        => PlaceBadges.TryGetValue(placement ?? 1, out var badge) ? badge : PlaceBadges[1];

    private IReadOnlyList<SelectOption<Guid>> PlayerOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Player…") }
            .Concat(Players.Select(p => new SelectOption<Guid>(p.Id, p.Name ?? "Unknown", AvatarUrl: p.ImageUrl)))
            .ToList();

    private IReadOnlyList<SelectOption<Guid>> HeroOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Hero…") }
            .Concat(Heroes.Select(h => new SelectOption<Guid>(h.Id, h.Name, ArtUrl: h.ImageUrl)))
            .ToList();

    private Task OnPlayerChanged(Guid playerId)
    {
        Fighter.PlayerId = playerId;
        Fighter.Player = Players.FirstOrDefault(p => p.Id == playerId);
        return OnChanged.InvokeAsync();
    }

    private Task OnHeroChanged(Guid heroId)
    {
        SetHero(Heroes.FirstOrDefault(h => h.Id == heroId));
        return OnChanged.InvokeAsync();
    }

    private Task CyclePlace()
    {
        var next = (Fighter.Placement ?? 0) + 1;
        Fighter.Placement = next > MaxPlace ? 1 : next;
        return OnChanged.InvokeAsync();
    }

    private Task OnHpChangedAsync(int? value) => HpChanged.InvokeAsync(value);

    private Task OnCardsChangedAsync(int? value)
    {
        Fighter.CardsLeft = value;
        return OnChanged.InvokeAsync();
    }

    private Task OnSidekickChangedAsync(int? value)
    {
        Fighter.SidekickHpLeft = value;
        return OnChanged.InvokeAsync();
    }

    private Task RandomizeHero()
    {
        SetHero(Heroes.ToList().GetRandomItem());
        return OnChanged.InvokeAsync();
    }

    /// <summary>Picking a hero refills HP, cards and sidekick HP from that hero's profile when the
    /// match is Ranked; when it's Unranked, those fields are cleared instead - not required, and
    /// left blank rather than carrying over the previous hero's numbers.</summary>
    private void SetHero(UiHeroDto? hero)
    {
        Fighter.Hero = hero;
        Fighter.HeroId = hero?.Id ?? Guid.Empty;

        if (IsRanked)
        {
            Fighter.SetDefaultData();
        }
        else
        {
            Fighter.ClearStatData();
        }
    }

    private void Arm() => _armed = true;

    private void Disarm() => _armed = false;

    private Task HandleDragStart()
    {
        if (!AllowDrag || !_armed)
        {
            return Task.CompletedTask;
        }

        _dragging = true;
        return OnDragStart.InvokeAsync(Fighter);
    }

    private void HandleDragOver() => _isDragOver = true;

    private void HandleDragLeave() => _isDragOver = false;

    private Task HandleDrop()
    {
        _isDragOver = false;
        return OnDroppedOn.InvokeAsync(Fighter);
    }

    private Task HandleDragEnd()
    {
        _isDragOver = false;
        _dragging = false;
        _armed = false;
        return OnDragEnd.InvokeAsync();
    }
}
