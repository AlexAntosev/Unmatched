@using Unmatched.Dtos
@using Unmatched.Extensions
@*
    One fighter plate on screen 4b (design/IMPLEMENTATION-PROMPT.md §5.2-§5.4): drag handle, hero
    art with the turn-order badge (and, in FFA, a place badge), then Player/Hero on one line and
    HP/Cards/Sidekick on the next - or, in FFA, all five fields in a single row. The winner control
    lives here only for 1v1/FFA; 2v2/co-op mark the winner on the side header instead.
*@
<div class="plate @(IsLoser ? "is-loser" : null) @(_isDragOver ? "is-drag-over" : null)"
     draggable="true"
     @ondragstart="HandleDragStart" @ondragstart:stopPropagation="true"
     @ondragover="HandleDragOver" @ondragover:preventDefault="true" @ondragover:stopPropagation="true"
     @ondragleave="HandleDragLeave"
     @ondrop="HandleDrop" @ondrop:preventDefault="true" @ondrop:stopPropagation="true"
     @ondragend="HandleDragEnd">
    <i class="plate-handle bi bi-grip-vertical" title="Drag to reorder"></i>

    <div class="plate-art-wrap" style="@($"width:{ArtSize}px;height:{ArtSize}px")">
        <img class="plate-art @(IsLoser ? "is-grayscale" : null)" src="@Fighter.HeroImageUrl" alt="@Fighter.Hero?.Name"
             onerror="this.onerror=null;this.src='/Unknown.png'"/>
        @if (ShowTurnBadge && Fighter.Turn is not null)
        {
            <div class="plate-order-badge">@Fighter.Turn</div>
        }
        @if (ShowPlace && PlaceBadge(Fighter.Placement) is { Label.Length: > 0 } badge)
        {
            <div class="plate-place-badge" style="color:@badge.Color">@badge.Label</div>
        }
        @if (IsLoser)
        {
            <div class="plate-loser-veil"><i class="bi bi-x-lg" style="font-size:@(VeilIconSize)px"></i></div>
        }
    </div>

    @if (Layout == "row")
    {
        <div class="plate-row-fields">
            <UmSelect TValue="Guid" Variant="chip" AvatarUrl="@Fighter.PlayerImageUrl"
                      Value="Fighter.PlayerId" ValueChanged="OnPlayerChanged" Options="PlayerOptions()"/>
            <UmSelect TValue="Guid" Variant="chip" Highlighted="true"
                      Value="Fighter.HeroId" ValueChanged="OnHeroChanged" OnRandomize="RandomizeHero" Options="HeroOptions()"/>
            <UmField Label="HP">
                <UmTextField Type="number" Variant="xs" Centered="true" Value="@Fighter.HpLeft?.ToString()"
                             ValueChanged="OnHpChangedAsync"/>
            </UmField>
            <UmField Label="Cards">
                <UmTextField Type="number" Variant="xs" Centered="true" Value="@Fighter.CardsLeft?.ToString()"
                             ValueChanged="@(v => Fighter.CardsLeft = ParseInt(v))"/>
            </UmField>
            <UmField Label="Place">
                <UmSelect TValue="int?" Variant="chip" Icon="bi-award"
                          Value="Fighter.Placement" ValueChanged="OnPlacementChanged" Options="PlaceOptions()"/>
            </UmField>
        </div>
    }
    else
    {
        <div class="plate-stacked-fields">
            <div class="plate-line">
                <UmSelect TValue="Guid" Variant="chip" AvatarUrl="@Fighter.PlayerImageUrl"
                          Value="Fighter.PlayerId" ValueChanged="OnPlayerChanged" Options="PlayerOptions()"/>
                <UmSelect TValue="Guid" Variant="chip" Highlighted="true"
                          Value="Fighter.HeroId" ValueChanged="OnHeroChanged" OnRandomize="RandomizeHero" Options="HeroOptions()"/>
                @if (ShowWinnerControl)
                {
                    <WinnerButton IsWinner="Fighter.IsWinner" OnClick="OnSetWinner"/>
                }
            </div>
            <div class="plate-line">
                <UmField Label="HP" Class="fighter-narrow">
                    <UmTextField Type="number" Variant="xs" Centered="true" Value="@Fighter.HpLeft?.ToString()"
                                 ValueChanged="OnHpChangedAsync"/>
                </UmField>
                <UmField Label="Cards" Class="fighter-narrow">
                    <UmTextField Type="number" Variant="xs" Centered="true" Value="@Fighter.CardsLeft?.ToString()"
                                 ValueChanged="@(v => Fighter.CardsLeft = ParseInt(v))"/>
                </UmField>
                <UmField Label="Sidekick" Class="fighter-narrow">
                    <UmTextField Type="number" Variant="xs" Centered="true" Disabled="@(Fighter.SidekickName is null)"
                                 Value="@Fighter.SidekickHpLeft?.ToString()"
                                 ValueChanged="@(v => Fighter.SidekickHpLeft = ParseInt(v))"/>
                </UmField>
            </div>
        </div>
    }

    @if (OnRemove.HasDelegate)
    {
        <button type="button" class="fighter-remove" title="Remove player" @onclick="OnRemove" @onclick:stopPropagation="true">
            <i class="bi bi-trash3"></i>
        </button>
    }
</div>

@code {
    private static readonly IReadOnlyDictionary<int, (string Label, string Color)> PlaceBadges = new Dictionary<int, (string, string)>
    {
        [1] = ("1ST", "var(--um-gold)"),
        [2] = ("2ND", "var(--um-silver)"),
        [3] = ("3RD", "var(--um-bronze)"),
        [4] = ("4TH", "var(--um-text-muted)")
    };

    private bool _isDragOver;

    /// <summary>Scales with the art (30px on a 64px plate, 44px on 1v1's 96px plate).</summary>
    private int VeilIconSize => (int)Math.Round(ArtSize * 0.46);

    [Parameter, EditorRequired]
    public UiFighterDto Fighter { get; set; } = default!;

    [Parameter, EditorRequired]
    public IReadOnlyList<UiPlayerDto> Players { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<UiHeroDto> Heroes { get; set; } = [];

    /// <summary>stacked (default, two lines) | row (FFA's single-line grid)</summary>
    [Parameter]
    public string Layout { get; set; } = "stacked";

    [Parameter]
    public int ArtSize { get; set; } = 64;

    [Parameter]
    public bool ShowPlace { get; set; }

    [Parameter]
    public bool ShowTurnBadge { get; set; } = true;

    [Parameter]
    public bool ShowWinnerControl { get; set; }

    [Parameter]
    public bool IsLoser { get; set; }

    [Parameter]
    public int MaxPlace { get; set; } = 4;

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnSetWinner { get; set; }

    [Parameter]
    public EventCallback<int?> HpChanged { get; set; }

    [Parameter]
    public EventCallback<UiFighterDto> OnDragStart { get; set; }

    [Parameter]
    public EventCallback<UiFighterDto> OnDroppedOn { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    private static int? ParseInt(string? value) => int.TryParse(value, out var parsed) ? parsed : null;

    private static (string Label, string Color) PlaceBadge(int? placement)
        => placement is not null && PlaceBadges.TryGetValue(placement.Value, out var badge) ? badge : (string.Empty, string.Empty);

    private IReadOnlyList<SelectOption<Guid>> PlayerOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Player…") }
            .Concat(Players.Select(p => new SelectOption<Guid>(p.Id, p.Name ?? "Unknown", AvatarUrl: p.ImageUrl)))
            .ToList();

    private IReadOnlyList<SelectOption<Guid>> HeroOptions()
        => new SelectOption<Guid>[] { new(Guid.Empty, "Hero…") }
            .Concat(Heroes.Select(h => new SelectOption<Guid>(h.Id, h.Name, ArtUrl: h.ImageUrl)))
            .ToList();

    private IReadOnlyList<SelectOption<int?>> PlaceOptions()
        => Enumerable.Range(1, MaxPlace).Select(place => new SelectOption<int?>(place, place.ToString())).ToList();

    private Task OnPlayerChanged(Guid playerId)
    {
        Fighter.PlayerId = playerId;
        Fighter.Player = Players.FirstOrDefault(p => p.Id == playerId);
        return OnChanged.InvokeAsync();
    }

    private Task OnHeroChanged(Guid heroId)
    {
        SetHero(Heroes.FirstOrDefault(h => h.Id == heroId));
        return OnChanged.InvokeAsync();
    }

    private Task OnPlacementChanged(int? placement)
    {
        Fighter.Placement = placement;
        return OnChanged.InvokeAsync();
    }

    private Task OnHpChangedAsync(string? value) => HpChanged.InvokeAsync(ParseInt(value));

    private Task RandomizeHero()
    {
        SetHero(Heroes.ToList().GetRandomItem());
        return OnChanged.InvokeAsync();
    }

    /// <summary>Picking a hero refills HP, cards and sidekick HP from that hero's profile.</summary>
    private void SetHero(UiHeroDto? hero)
    {
        Fighter.Hero = hero;
        Fighter.HeroId = hero?.Id ?? Guid.Empty;
        Fighter.SetDefaultData();
    }

    private Task HandleDragStart() => OnDragStart.InvokeAsync(Fighter);

    private void HandleDragOver() => _isDragOver = true;

    private void HandleDragLeave() => _isDragOver = false;

    private Task HandleDrop()
    {
        _isDragOver = false;
        return OnDroppedOn.InvokeAsync(Fighter);
    }

    private Task HandleDragEnd()
    {
        _isDragOver = false;
        return OnDragEnd.InvokeAsync();
    }
}
