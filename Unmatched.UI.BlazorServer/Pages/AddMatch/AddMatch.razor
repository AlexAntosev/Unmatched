@page "/match/{id}"
@using BlazorBootstrap
@using Microsoft.AspNetCore.Components
@using Unmatched.Constants
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Dtos.Player
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services
@using Unmatched.Services.Contracts
@inject IMatchService MatchService
@inject IHeroService HeroService
@inject ITournamentService TournamentService
@inject IPlayerService PlayerService
@inject IMapService MapService
@inject IFavoriteService FavoriteService
@inject ICollectionService CollectionService
@inject IVillainService VillainService
@inject IMinionService MinionService
@inject NavigationManager NavManager
@inject NotificationService NotificationService

<div style="height: 100%; background: linear-gradient(90deg, @(_match.Fighters.FirstOrDefault()?.Hero?.Color ?? "white") 0%, @(_match.Fighters.LastOrDefault()?.Hero?.Color ?? "white") 100%);">
    <Modal @ref="matchSavedPopup" Title="Match successfully saved!">
        <BodyTemplate>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="ButtonColor.Secondary" @onclick="OnPopupCloseClick">Close</Button>
        </FooterTemplate>
    </Modal>

    <div class="row">
        <div class="column start">
            <label for="gameMode">Mode:</label>
            <InputSelect Value="@_match.GameMode" ValueExpression="@(() => _match.GameMode)" name="gameMode" id="gameMode" class="form-select transparent rounded-form" ValueChanged="@((GameMode value) => GameModeChanged(value))">
                <option value="@GameMode.OneVsOne">1 на 1</option>
                <option value="@GameMode.TeamVsTeam">2 на 2</option>
                <option value="@GameMode.FreeForAll">Втрьох (вільний бій)</option>
                <option value="@GameMode.Cooperative">Кооп проти гри</option>
            </InputSelect>
        </div>
    </div>

    @if (_match.GameMode == GameMode.OneVsOne)
    {
        <div class="row">
            <div class="triple-column center">
                <FighterInfo Title="Fighter" Players="_players" Heroes="_heroes" Fighter="@_match.Fighters.First()"></FighterInfo>
            </div>
            <div class="triple-column center">
                <img src="Vs.png"/>
            </div>
            <div class="triple-column center">
                <FighterInfo Title="Opponent" Players="_players" Heroes="_heroes" Fighter="@_match.Fighters.Last()"></FighterInfo>
            </div>
        </div>
    }
    else if (_match.GameMode == GameMode.TeamVsTeam)
    {
        <div class="row">
            <div class="triple-column center">
                <h4>Команда 1</h4>
                <label>
                    <input type="checkbox" checked="@Team1Won" @onchange="@((ChangeEventArgs e) => SetTeamWinner(1, (bool)e.Value!))"/>
                    Ця команда перемогла
                </label>
                @foreach (var fighter in TeamFighters(1))
                {
                    <FighterInfo Title="Fighter" Players="_players" Heroes="_heroes" Fighter="@fighter" ShowWinnerCheckbox="false"></FighterInfo>
                }
            </div>
            <div class="triple-column center">
                <img src="Vs.png"/>
            </div>
            <div class="triple-column center">
                <h4>Команда 2</h4>
                <label>
                    <input type="checkbox" checked="@Team2Won" @onchange="@((ChangeEventArgs e) => SetTeamWinner(2, (bool)e.Value!))"/>
                    Ця команда перемогла
                </label>
                @foreach (var fighter in TeamFighters(2))
                {
                    <FighterInfo Title="Fighter" Players="_players" Heroes="_heroes" Fighter="@fighter" ShowWinnerCheckbox="false"></FighterInfo>
                }
            </div>
        </div>
    }
    else if (_match.GameMode == GameMode.FreeForAll)
    {
        <div class="row">
            <button type="button" class="btn btn-secondary rounded-form" @onclick="AddFighter">+ Add player</button>
            @foreach (var fighter in _match.Fighters)
            {
                <div class="triple-column center">
                    <FighterInfo Title="Fighter" Players="_players" Heroes="_heroes" Fighter="@fighter" ShowWinnerCheckbox="false" ShowPlacementInput="true"></FighterInfo>
                    <button type="button" class="btn btn-secondary rounded-form" @onclick="() => RemoveFighter(fighter)">Remove</button>
                </div>
            }
        </div>
    }
    else if (_match.GameMode == GameMode.Cooperative)
    {
        <div class="row">
            <div class="column center">
                <label>
                    <input type="checkbox" checked="@_playersWon" @onchange="@((ChangeEventArgs e) => SetPlayersWon((bool)e.Value!))"/>
                    Гравці перемогли?
                </label>
                <button type="button" class="btn btn-secondary rounded-form" @onclick="AddFighter">+ Add player</button>
                @foreach (var fighter in _match.Fighters)
                {
                    <div class="triple-column center">
                        <FighterInfo Title="Fighter" Players="_players" Heroes="_heroes" Fighter="@fighter" ShowWinnerCheckbox="false"></FighterInfo>
                        <button type="button" class="btn btn-secondary rounded-form" @onclick="() => RemoveFighter(fighter)">Remove</button>
                    </div>
                }
            </div>
            <div class="column center">
                <VillainInfo Villains="_villains" Minions="_minions" MatchVillain="@(_match.Villain ??= new UiMatchVillainDto())"></VillainInfo>
            </div>
        </div>
    }

    <div class="row">
        <div class="column end">
            <EditForm Model=@_match>
                <div>
                    <label for="Map">Map:</label>
                    <div style=" display: flex; flex-direction: row;">
                        <InputSelect Value="@_match.Map.Id" ValueExpression="@(() => _match.Map.Id)" name="Map" id="maps" class="form-select transparent rounded-form" ValueChanged="@((Guid value) => SetMapInfo(value))">
                            @foreach (var map in _maps)
                            {
                                <option value="@map.Id"> @map.DisplayName</option>
                            }
                        </InputSelect >
                        <button style="border-width: 0; background: transparent;" @onclick="RandomizeMap">🎲</button>
                    </div>
                </div>
                <div>
                    <label for="Tournament">Tournament:</label>
                    <InputSelect @bind-Value=_match.TournamentId name="Tournament" id="tournaments" class="form-select transparent rounded-form">
                        @foreach (var tournament in _tournaments)
                        {
                            <option value="@tournament.Id"> @tournament.Name</option>
                        }
                    </InputSelect >
                </div>
                <div>
                    <label for="Date">Date:</label>
                    <InputDate @bind-Value=_match.Date name="Date" class="form-control transparent rounded-form"/>
                </div>
                <div>
                    <label for="Comment">Comment:</label>
                    <InputText @bind-Value=_match.Comment name="Comment" class="form-control transparent rounded-form"/>
                </div>
                <div>
                    <label for="Stage">Stage:</label>
                    <InputSelect @bind-Value=_match.Stage name="Stage" id="stages" class="form-select transparent rounded-form">
                        @foreach (var stage in _stages)
                        {
                            <option value="@stage.Item1"> @stage.Item2</option>
                        }
                    </InputSelect >
                </div>
                <p></p>
                <button class="btn btn-primary rounded-form" @onclick="OnAddNewMatchClickAsync">Add match</button>
                @if (_match.GameMode == GameMode.OneVsOne)
                {
                    <button class="btn btn-secondary rounded-form" @onclick="OnRandomizeMatchClick">Randomize</button>
                }
            </EditForm>
        </div>
        <div class="column start">
            <img style="border: 4px solid black;" src="@_match.Map?.ImageUrl" onerror="this.onerror=null;this.src='/UnknownMap.png'"/>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Id { get; set; }

    private List<UiPlayerDto> _players = new();
    private List<UiHeroDto> _heroes = new();
    private List<VillainDto> _villains = new();
    private List<MinionDto> _minions = new();
    private List<MapDto> _maps = new();
    private List<TournamentDto> _tournaments = new();
    private List<(Stage?, string)> _stages = new();
    private bool _playersWon;

    UiMatchDto _match = new()
        {
            Fighters = new List<UiFighterDto>()
                {
                    new(),
                    new()
                },
            Map = new()
                {
                    Name = "UnknownMap"
                },
            Date = DateTime.UtcNow
        };

    [Inject] protected PreloadService PreloadService { get; set; }

    private Modal matchSavedPopup = default!;

    private bool Team1Won => _match.Fighters.Any(f => f.Team == 1) && TeamFighters(1).All(f => f.IsWinner);
    private bool Team2Won => _match.Fighters.Any(f => f.Team == 2) && TeamFighters(2).All(f => f.IsWinner);

    private IEnumerable<UiFighterDto> TeamFighters(int team) => _match.Fighters.Where(f => f.Team == team);

    protected override async Task OnInitializedAsync()
    {
        NotificationService.RefreshRequested += RerenderComponent;
        try
        {
            PreloadService.Show();

            _players = (await PlayerService.GetAsync()).ToList();
            _heroes = (await HeroService.GetAsync()).OrderBy(x => x.Name).ToList();
            _villains = (await VillainService.GetAsync()).OrderBy(x => x.Name).ToList();
            _minions = (await MinionService.GetAsync()).OrderBy(x => x.Name).ToList();
            _maps = (await MapService.GetAsync()).OrderBy(x => x.Name).ToList();
            _tournaments = (await TournamentService.GetAsync()).ToList();
            _stages = new List<(Stage?, string)>
                {
                    (null, ""),
                    (Stage.EighthFinals, Stage.EighthFinals.GetStageName()),
                    (Stage.QuarterFinals, Stage.QuarterFinals.GetStageName()),
                    (Stage.SemiFinals, Stage.SemiFinals.GetStageName()),
                    (Stage.ThirdPlaceDecider, Stage.ThirdPlaceDecider.GetStageName()),
                    (Stage.GrandFinals, Stage.GrandFinals.GetStageName())
                };

            var defaultTournament = _tournaments.FirstOrDefault(x => x.Name == TournamentNames.GoldenHalatLeague);
            if (defaultTournament != null)
            {
                _match.TournamentId = defaultTournament.Id;
            }

            UiMatchDto match;
            if (Guid.TryParse(Id, out var id)
             && id != Guid.Empty)
            {
                match = await MatchService.GetAsync(id);
                match.Date = DateTime.UtcNow;
                foreach (var fighter in match.Fighters)
                {
                    fighter.SetDefaultData();
                }
            }
            else
            {
                match = await GenerateDefaultMatch();
            }

            await FilterByCollectionAsync(match);

            _match = match;
            _playersWon = _match.GameMode == GameMode.Cooperative && (_match.Fighters.FirstOrDefault()?.IsWinner ?? false);
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task FilterByCollectionAsync(UiMatchDto match)
    {
        var ownedExpansionIds = (await CollectionService.GetOwnedExpansionIdsAsync()).ToHashSet();
        if (ownedExpansionIds.Count == 0)
        {
            return;
        }

        var keepHeroIds = match.Fighters.Select(f => f.HeroId).Where(id => id != Guid.Empty).ToHashSet();
        var keepMapId = match.Map?.Id;

        _heroes = _heroes
            .Where(h => h.ExpansionId is null || ownedExpansionIds.Contains(h.ExpansionId.Value) || keepHeroIds.Contains(h.Id))
            .ToList();
        _maps = _maps
            .Where(m => m.ExpansionId is null || ownedExpansionIds.Contains(m.ExpansionId.Value) || m.Id == keepMapId)
            .ToList();
    }

    private async Task<UiMatchDto> GenerateDefaultMatch()
    {
        var match = new UiMatchDto();
        var andy = _players.FirstOrDefault(x => x.Name == PlayerNames.Andrii);
        var olex = _players.FirstOrDefault(x => x.Name == PlayerNames.Oleksandr);

        if (andy is not null
         && olex is not null)
        {
            var random = new Random();
            var andyTurn = random.Next(1, 3);
            var olexTurn = 3 - andyTurn; // in two player game there are Turn 1 and Turn 2. Sum is 3. So <seconds player turn> = 3 - <first player turn>
            var favouriteAndyHero = await FavoriteService.GetFavouriteHeroAsync(andy.Id);
            var favouriteOlexHero = await FavoriteService.GetFavouriteHeroAsync(olex.Id);
            var defaultFighters = new List<UiFighterDto>()
                {
                    new()
                        {
                            Player = andy,
                            PlayerId = andy.Id,
                            Turn = andyTurn,
                            Hero = favouriteAndyHero
                        },
                    new()
                        {
                            Player = olex,
                            PlayerId = olex.Id,
                            Turn = olexTurn,
                            Hero = favouriteOlexHero
                        }
                };
            match.Fighters = defaultFighters.OrderBy(x => x.Turn).ToArray();
            match.Fighters.First().SetDefaultData();
            match.Fighters.Last().SetDefaultData();
        }

        match.Date = DateTime.UtcNow;
        match.TournamentId = _tournaments.FirstOrDefault(x => x.Name == TournamentNames.GoldenHalatLeague)?.Id;
        var map = _maps.FirstOrDefault(x => x.Name == MapNames.Castle);
        match.Map = map;
        return match;
    }

    private async Task OnAddNewMatchClickAsync()
    {
        try
        {
            PreloadService.Show();

            PrepareMatchForSubmit();

            var match = _match;

            var isValidId = Guid.TryParse(Id, out var id);
            if (!isValidId)
            {
                return;
            }

            SaveMatchResultDto result;
            if (id == Guid.Empty)
            {
                result = await MatchService.AddAsync(match);

            }
            else
            {
                result = await MatchService.UpdateAsync(match);
            }

            var parameters = new Dictionary<string, object>
                {
                    {
                        "Result", result
                    }
                };
            await matchSavedPopup.ShowAsync<MatchSavedPopup>(title: "Match successfully saved!", parameters: parameters);
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            throw;
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void PrepareMatchForSubmit()
    {
        if (_match.GameMode == GameMode.FreeForAll)
        {
            foreach (var fighter in _match.Fighters)
            {
                fighter.IsWinner = fighter.Placement == 1;
            }
        }
    }

    private void GameModeChanged(GameMode mode)
    {
        _match.GameMode = mode;
        switch (mode)
        {
            case GameMode.OneVsOne:
                _match.Fighters = EnsureFighterCount(2);
                _match.Villain = null;
                break;
            case GameMode.TeamVsTeam:
                _match.Fighters = EnsureFighterCount(4);
                AssignTeams();
                _match.Villain = null;
                break;
            case GameMode.FreeForAll:
                _match.Fighters = EnsureFighterCount(3);
                break;
            case GameMode.Cooperative:
                _match.Fighters = EnsureFighterCount(2);
                _match.Villain ??= new UiMatchVillainDto();
                break;
        }
    }

    private List<UiFighterDto> EnsureFighterCount(int count)
    {
        var fighters = _match.Fighters.ToList();
        while (fighters.Count < count)
        {
            fighters.Add(new UiFighterDto());
        }

        if (fighters.Count > count)
        {
            fighters = fighters.Take(count).ToList();
        }

        return fighters;
    }

    private void AssignTeams()
    {
        var fighters = _match.Fighters.ToList();
        for (var i = 0; i < fighters.Count; i++)
        {
            fighters[i].Team = i < 2 ? 1 : 2;
        }
    }

    private void SetTeamWinner(int winningTeam, bool won)
    {
        if (!won)
        {
            return;
        }

        foreach (var fighter in _match.Fighters)
        {
            fighter.IsWinner = fighter.Team == winningTeam;
        }
    }

    private void SetPlayersWon(bool won)
    {
        _playersWon = won;
        foreach (var fighter in _match.Fighters)
        {
            fighter.IsWinner = won;
        }

        if (_match.Villain is not null)
        {
            _match.Villain.IsWinner = !won;
            foreach (var minion in _match.Villain.Minions)
            {
                minion.IsWinner = !won;
            }
        }
    }

    private void AddFighter()
    {
        _match.Fighters = _match.Fighters.Append(new UiFighterDto()).ToList();
    }

    private void RemoveFighter(UiFighterDto fighter)
    {
        _match.Fighters = _match.Fighters.Where(f => f != fighter).ToList();
    }

    private void OnRandomizeMatchClick()
    {
        RandomizeMap();
        RandomizeFighter();
        RandomizeOpponent();
    }

    private void RandomizeMap()
    {
        var mapId = _maps.GetRandomItem().Id;
        SetMapInfo(mapId);
    }

    private void RandomizeFighter()
    {
        NotificationService.CallRandomizeFighter(_match.Fighters.First());
        _match.Fighters.First().Turn = 1;
    }

    private void RandomizeOpponent()
    {
        NotificationService.CallRandomizeFighter(_match.Fighters.Last(), _match.Fighters.First());
        _match.Fighters.Last().Turn = 2;
    }

    private async Task OnPopupCloseClick()
    {
        await matchSavedPopup.HideAsync();
        NavManager.NavigateTo(Urls.DuelMatchLog);
    }

    private void SetMapInfo(Guid mapId)
    {
        var map = _maps.First(h => h.Id == mapId);
        _match.Map = map;
    }

    private void RerenderComponent()
    {
        StateHasChanged();
    }
}

<style>
    label {
        opacity: 0.9 !important;
        font-size: 20px;
        color: white;
        text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
    }

    .transparent {
        opacity: 0.9 !important;
    }

    .rounded-form {
        border-radius: 16px;
    }
</style>
