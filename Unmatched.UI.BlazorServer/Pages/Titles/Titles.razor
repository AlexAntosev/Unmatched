@page "/titles"
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Enums
@using Unmatched.Services.Contracts
@inject ITitleService TitleService
@inject IHeroService HeroService
@*
    Not in the design pack: a panel of rows plus an assign dialog, built from design-system parts.
    A first pass - the layout is deliberately plain until this screen gets designed. Grouped by how a
    title behaves rather than alphabetically: Shared titles can have many holders at once, Unique titles
    have exactly one (assigning a new one transfers it away from whoever held it), Tournament titles are
    each scoped to the tournament that awarded them.
*@

<PageHeader Breadcrumbs="Crumbs">
    <Controls>
        <UmTextField Placeholder="New title" Variant="control" Value="@_newTitleName"
                     ValueChanged="@(v => _newTitleName = v)" Class="titles-new"/>
        <UmButton Size="sm" Variant="primary" Icon="bi-plus-lg" Disabled="@(!IsNewTitleValid)"
                  OnClick="AddTitleAsync">Add title</UmButton>
    </Controls>
</PageHeader>

<div class="um-page">
    <Panel Title="Shared" Meta="@($"{SharedTitles.Count}")">
        @if (SharedTitles.Count == 0)
        {
            <div class="titles-empty">No shared titles yet.</div>
        }
        @foreach (var title in SharedTitles)
        {
            @TitleRow(title)
        }
    </Panel>

    <Panel Title="Unique" Meta="@($"{UniqueTitles.Count}")">
        @if (UniqueTitles.Count == 0)
        {
            <div class="titles-empty">No unique titles yet.</div>
        }
        @foreach (var title in UniqueTitles)
        {
            @TitleRow(title)
        }
    </Panel>

    <Panel Title="Tournament" Meta="@($"{TournamentTitlesList.Count}")">
        @if (TournamentTitlesList.Count == 0)
        {
            <div class="titles-empty">No tournament has awarded a title yet.</div>
        }
        @foreach (var title in TournamentTitlesList)
        {
            @TitleRow(title)
        }
    </Panel>
</div>

<BlazorBootstrap.Modal @ref="_assignDialog" Title="Assign heroes">
    <BodyTemplate>
        @if (_assigningTitle?.Exclusivity == TitleExclusivity.Unique)
        {
            <div class="titles-assign-hint">Unique title - picking a hero transfers it away from whoever holds it now.</div>
        }
        <div class="titles-assign">
            @foreach (var hero in _assignableHeroes)
            {
                <label class="titles-assign-row">
                    <UmCheckbox Checked="hero.IsAssigned" CheckedChanged="@(v => OnHeroToggled(hero, v))"/>
                    <span>@hero.Name</span>
                </label>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <UmButton Size="sm" OnClick="@(() => _assignDialog.HideAsync())">Cancel</UmButton>
        <UmButton Size="sm" Variant="primary" Icon="bi-check-lg" OnClick="SaveAssignmentsAsync">Save</UmButton>
    </FooterTemplate>
</BlazorBootstrap.Modal>

@code {
    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Play"), new("Titles")];

    private List<TitleDto> _titles = new();
    private List<UiHeroDto> _heroes = new();
    private List<HeroTitleAssignDto> _assignableHeroes = new();
    private BlazorBootstrap.Modal _assignDialog = default!;
    private TitleDto? _assigningTitle;
    private string? _newTitleName;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private List<TitleDto> SharedTitles
        => _titles.Where(t => t.TournamentId is null && t.Exclusivity == TitleExclusivity.Shared).ToList();

    private List<TitleDto> UniqueTitles
        => _titles.Where(t => t.TournamentId is null && t.Exclusivity == TitleExclusivity.Unique).ToList();

    private List<TitleDto> TournamentTitlesList
        => _titles.Where(t => t.TournamentId is not null).ToList();

    private bool IsNewTitleValid
        => !string.IsNullOrWhiteSpace(_newTitleName)
        && _titles.All(t => !string.Equals(t.Name, _newTitleName, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            PreloadService.Show();
            var titles = TitleService.GetAsync();
            var heroes = HeroService.GetAsync();
            await Task.WhenAll(titles, heroes);

            _titles = titles.Result.OrderBy(t => t.Name).ToList();
            _heroes = heroes.Result.ToList();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private UiHeroDto? HeroFor(Guid heroId) => _heroes.FirstOrDefault(h => h.Id == heroId);

    private RenderFragment TitleRow(TitleDto title) => @<div class="titles-row">
        <div class="titles-head">
            <i class="bi bi-award-fill"></i>
            <div class="titles-names">
                <div class="titles-name">@title.Name</div>
                @if (!string.IsNullOrWhiteSpace(title.Comment))
                {
                    <div class="titles-comment">@title.Comment</div>
                }
            </div>
            <UmButton Size="sm" Icon="bi-people" OnClick="@(() => OpenAssignAsync(title))">Assign heroes</UmButton>
            <UmButton Size="sm" Variant="danger" Icon="bi-trash" Disabled="@(title.RuleKey is not null)"
                      Title="@(title.RuleKey is not null ? "Rule-backed titles can't be deleted" : null)"
                      OnClick="@(() => DeleteTitleAsync(title.Id))"/>
        </div>
        <div class="titles-holders">
            @if (!title.Holders.Any())
            {
                <span class="titles-vacant">Vacant</span>
            }
            @foreach (var holder in title.Holders)
            {
                var hero = HeroFor(holder.HeroId);
                <div class="titles-holder">
                    <HeroToken ImageUrl="@(hero?.ImageUrl ?? "/Unknown.png")" Size="26" Title="@(hero?.Name ?? "Unknown")"/>
                    <span class="titles-holder-name">@(hero?.Name ?? "Unknown")</span>
                    @if (holder.EarnedAt is not null)
                    {
                        <span class="titles-holder-date">@holder.EarnedAt.Value.ToShortDateString()</span>
                    }
                </div>
            }
        </div>
    </div>;

    private async Task AddTitleAsync()
    {
        if (!IsNewTitleValid)
        {
            return;
        }

        await TitleService.AddAsync(new TitleDto { Name = _newTitleName, Comment = string.Empty });
        _newTitleName = null;
        await RefreshAsync();
    }

    private async Task DeleteTitleAsync(Guid id)
    {
        await TitleService.DeleteAsync(id);
        await RefreshAsync();
    }

    private async Task OpenAssignAsync(TitleDto title)
    {
        _assigningTitle = title;
        _assignableHeroes = (await TitleService.GetHeroesForTitleAssign(title.Id))
            .OrderBy(h => h.Name)
            .ToList();
        await _assignDialog.ShowAsync();
    }

    private void OnHeroToggled(HeroTitleAssignDto hero, bool value)
    {
        if (value && _assigningTitle?.Exclusivity == TitleExclusivity.Unique)
        {
            foreach (var other in _assignableHeroes.Where(h => h != hero))
            {
                other.IsAssigned = false;
            }
        }

        hero.IsAssigned = value;
    }

    private async Task SaveAssignmentsAsync()
    {
        if (_assigningTitle is null)
        {
            return;
        }

        var assignedHeroIds = _assignableHeroes.Where(h => h.IsAssigned).Select(h => h.Id);
        await TitleService.MergeAsync(_assigningTitle.Id, assignedHeroIds);
        await _assignDialog.HideAsync();
        await RefreshAsync();
    }
}
