@page "/tournaments"
@using Unmatched.Dtos.Match
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services.Contracts
@inject ITournamentService TournamentService
@inject NavigationManager NavManager
@*
    Not in the design pack: a panel of rows plus a create form, built from design-system parts.
    A first pass - the layout is deliberately plain until this screen gets designed.
*@

<PageHeader Breadcrumbs="Crumbs"/>

<div class="um-page">
    <Panel Title="Tournaments" Meta="@($"{_tournaments.Count} tournaments")">
        @if (_tournaments.Count == 0)
        {
            <div class="tournaments-empty">No tournaments yet.</div>
        }
        @foreach (var tournament in _tournaments)
        {
            <div class="tournaments-row" @onclick="@(() => Open(tournament))">
                <i class="bi bi-flag-fill"></i>
                <div class="tournaments-names">
                    <div class="tournaments-name">@tournament.Name</div>
                    <div class="tournaments-meta">
                        @tournament.Type · @tournament.CurrentStage.GetStageName()
                    </div>
                </div>
                <UmButton Size="sm" Variant="danger" Icon="bi-trash" StopPropagation="true"
                          OnClick="@(() => DeleteAsync(tournament.Id))">Delete</UmButton>
            </div>
        }
    </Panel>

    <Panel Title="New tournament">
        <div class="tournaments-form">
            <UmField Label="Name">
                <UmTextField Placeholder="Tournament name" Value="@_form.Name"
                             ValueChanged="@(v => _form.Name = v)"/>
            </UmField>
            <UmField Label="Initial stage">
                <UmSelect TValue="Stage" Icon="bi-diagram-2" Value="_form.InitialStage"
                          ValueChanged="@(stage => _form.InitialStage = stage)">
                    @foreach (var stage in AllStages)
                    {
                        <option value="@stage">@stage.GetStageName()</option>
                    }
                </UmSelect>
            </UmField>
            <UmField Label="Type">
                <UmSelect TValue="TournamentType" Icon="bi-trophy" Value="_form.Type"
                          ValueChanged="@(type => _form.Type = type)">
                    @foreach (var type in AllTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </UmSelect>
            </UmField>
            <UmButton Variant="primary" Icon="bi-plus-lg" Disabled="@(!IsFormValid)" OnClick="AddAsync">
                Add tournament
            </UmButton>
        </div>
    </Panel>
</div>

@code {
    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Play"), new("Tournaments")];

    private static readonly Stage[] AllStages =
    [
        Stage.EighthFinals, Stage.QuarterFinals, Stage.SemiFinals, Stage.ThirdPlaceDecider, Stage.GrandFinals
    ];

    private static readonly TournamentType[] AllTypes = [TournamentType.Championship, TournamentType.League];

    private List<TournamentDto> _tournaments = new();
    private TournamentDto _form = new();

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private bool IsFormValid
        => !string.IsNullOrWhiteSpace(_form.Name)
        && _tournaments.All(t => !string.Equals(t.Name, _form.Name, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            PreloadService.Show();
            _tournaments = (await TournamentService.GetAsync()).OrderBy(t => t.Name).ToList();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task AddAsync()
    {
        if (!IsFormValid)
        {
            return;
        }

        try
        {
            PreloadService.Show();
            _form.CurrentStage = _form.InitialStage;
            var created = await TournamentService.AddAsync(_form);
            await TournamentService.GenerateMatchesAsync(created.Id);
            _form = new TournamentDto();
            await RefreshAsync();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        await TournamentService.DeleteAsync(id);
        await RefreshAsync();
    }

    private void Open(TournamentDto tournament)
        => NavManager.NavigateTo($"{Urls.Tournaments}/{tournament.Id}");
}
