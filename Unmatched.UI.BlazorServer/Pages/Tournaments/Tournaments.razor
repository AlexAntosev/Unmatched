@page "/tournaments"
@using Unmatched.Dtos.Match
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@using Unmatched.UI.BlazorServer.Shared.DesignSystem
@inject ITournamentService TournamentService
@inject TournamentCreateModalService TournamentCreateModalService
@inject NavigationManager NavManager
@*
    Not in the design pack: a shelf of tournament covers, built to the Collection.razor standard
    (design/README.md flags Tournaments as a deliberate follow-up). Each card is a box on a shelf,
    same as a collection expansion - cover art, name, a format/status badge, how many are signed up.
*@

<PageHeader Breadcrumbs="Crumbs">
    <Controls>
        <UmSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="Search tournaments…"/>
        <UmMultiSelect TValue="TournamentFormat" Icon="bi-funnel" Label="Format"
                       Value="_formatFilter" ValueChanged="OnFormatFilterChanged" Options="FormatOptions"/>
        <UmButton Size="sm" Variant="primary" Icon="bi-plus-lg" OnClick="@(() => TournamentCreateModalService.RequestOpen())">
            New tournament
        </UmButton>
    </Controls>
</PageHeader>

<div class="tournaments-kpis">
    <KpiCard Icon="bi-flag-fill" Label="Tournaments" Value="@_tournaments.Count.ToString()"/>
    <KpiCard Icon="bi-pencil" Label="Draft" Value="@CountByStatus(TournamentStatus.Draft).ToString()"/>
    <KpiCard Icon="bi-play-fill" Label="In progress" Value="@CountByStatus(TournamentStatus.InProgress).ToString()"/>
    <KpiCard Icon="bi-trophy-fill" Label="Completed" Value="@CountByStatus(TournamentStatus.Completed).ToString()"/>
</div>

<div class="um-page tournaments-page">
    <SectionCaption Text="Tournaments" Meta="@($"{_visible.Count} shown")"/>

    @if (_pageItems.Count == 0)
    {
        <div class="tournaments-empty">
            @(_tournaments.Count == 0 ? "No tournaments yet." : "No tournaments match your filters.")
        </div>
    }
    else
    {
        <div class="tournaments-grid">
            @foreach (var tournament in _pageItems)
            {
                var style = TournamentFormatStyle.For(tournament.Format);
                <div class="tournament-card" @onclick="@(() => Open(tournament))">
                    <div class="tournament-cover">
                        @if (tournament.ImageUrl is not null)
                        {
                            <img class="tournament-cover-art" src="@tournament.ImageUrl" alt="@tournament.Name"/>
                        }
                        else
                        {
                            <img class="tournament-cover-logo" src="/Unmatched-logo.png" alt=""/>
                        }
                        <div class="tournament-format-badge"><i class="bi @style.Icon"></i>@style.Label</div>
                    </div>
                    <div class="tournament-meta">
                        <div class="tournament-name">@tournament.Name</div>
                        <div class="tournament-subline">
                            <span class="tournament-status @StatusClass(tournament.Status)">@tournament.Status</span>
                            <span class="tournament-participants">
                                <i class="bi bi-people"></i>@tournament.ParticipantHeroIds.Count() participants
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
        <GridFooter Caption="ROWS PER PAGE" PageSizeOptions="PageSizeOptions" PageSize="_pageSize"
                    PageSizeChanged="OnPageSizeChanged" CurrentPage="_currentPage" PageCount="PageCount"
                    TotalCount="_visible.Count" PageChanged="GoToPage" Class="tournaments-footer"/>
    }
</div>

@code {
    private const int DefaultPageSize = 20;

    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Play"), new("Tournaments")];

    private static readonly IReadOnlyList<SelectOption<int>> PageSizeOptions =
        [new(10, "10"), new(20, "20"), new(GridFooter.AllPageSize, "All")];

    private static readonly IReadOnlyList<SelectOption<TournamentFormat>> FormatOptions =
        Enum.GetValues<TournamentFormat>()
            .Select(format => new SelectOption<TournamentFormat>(format, TournamentFormatStyle.For(format).Label))
            .ToList();

    private List<TournamentDto> _tournaments = new();
    private List<TournamentDto> _visible = new();
    private List<TournamentDto> _pageItems = new();
    private IReadOnlyList<TournamentFormat> _formatFilter = [];
    private string? _search;
    private int _currentPage = 1;
    private int _pageSize = DefaultPageSize;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_visible.Count / (double)_pageSize));

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            PreloadService.Show();
            _tournaments = (await TournamentService.GetAsync())
                .OrderByDescending(t => t.Status == TournamentStatus.InProgress)
                .ThenBy(t => t.Name)
                .ToList();
            Rebuild();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private void Rebuild()
    {
        IEnumerable<TournamentDto> tournaments = _tournaments;

        if (_formatFilter.Count > 0)
        {
            tournaments = tournaments.Where(t => _formatFilter.Contains(t.Format));
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var term = _search.Trim();
            tournaments = tournaments.Where(t => t.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        _visible = tournaments.ToList();
        _currentPage = Math.Clamp(_currentPage, 1, PageCount);
        BuildPage();
    }

    private void BuildPage()
        => _pageItems = _visible.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    private void GoToPage(int page)
    {
        _currentPage = page;
        BuildPage();
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        Rebuild();
    }

    private void OnSearchChanged(string? search)
    {
        _search = search;
        _currentPage = 1;
        Rebuild();
    }

    private void OnFormatFilterChanged(IReadOnlyList<TournamentFormat> formats)
    {
        _formatFilter = formats;
        _currentPage = 1;
        Rebuild();
    }

    private int CountByStatus(TournamentStatus status) => _tournaments.Count(t => t.Status == status);

    private static string StatusClass(TournamentStatus status) => status switch
    {
        TournamentStatus.InProgress => "is-in-progress",
        TournamentStatus.Completed => "is-completed",
        _ => "is-draft"
    };

    private void Open(TournamentDto tournament)
        => NavManager.NavigateTo($"{Urls.Tournaments}/{tournament.Id}");
}
