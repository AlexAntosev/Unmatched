@page "/tournaments/new"
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@using Unmatched.UI.BlazorServer.Shared.DesignSystem
@inject ITournamentService TournamentService
@inject IHeroService HeroService
@inject IImageUploadService ImageUploadService
@inject NavigationManager NavManager
@*
    Not in the design pack (see Tournaments.razor). Name → format → how many can sign up → who's
    signed up → which titles it hands out → cover/trophy art → Create. Images upload by name slug
    (ImageUploadService.SaveAsync keys off the name, not an id), so they can be picked before the
    tournament exists - Create just submits whatever filenames are already staged.
*@

<PageHeader Breadcrumbs="Crumbs"/>

<div class="um-page tournament-create">
    <Panel Title="Details">
        <div class="tc-grid">
            <UmField Label="Name">
                <UmTextField Placeholder="Golden Halat League II" Value="@_form.Name"
                             ValueChanged="@(v => _form.Name = v ?? string.Empty)"/>
            </UmField>
            <UmField Label="Format">
                <UmSelect TValue="TournamentFormat" Icon="bi-flag" Value="_form.Format"
                          ValueChanged="OnFormatChanged" Options="FormatOptions"/>
            </UmField>
            <UmField Label="Max participants">
                <UmTextField Type="number" Min="2" Value="@_form.MaxParticipants.ToString()"
                             ValueChanged="OnMaxParticipantsChanged"/>
            </UmField>
            @if (_form.Format == TournamentFormat.SingleElimination)
            {
                <UmField Label="Bracket size">
                    <UmSelect TValue="Stage" Icon="bi-diagram-2" Value="_form.InitialStage"
                              ValueChanged="@(stage => _form.InitialStage = stage)" Options="StageOptions"/>
                </UmField>
            }
        </div>
    </Panel>

    <Panel Title="Participants" Meta="@($"{_selectedParticipants.Count} / {_form.MaxParticipants}")">
        <UmMultiSelect TValue="Guid" Icon="bi-shield-fill" Label="Heroes"
                       Value="_selectedParticipants.ToList()" ValueChanged="OnParticipantsChanged" Options="HeroOptions()"/>
        @if (_selectedParticipants.Count > _form.MaxParticipants)
        {
            <div class="tc-warning">That's more heroes than max participants allows - raise the cap or trim the list.</div>
        }
    </Panel>

    <Panel Title="Titles this tournament awards">
        <div class="tc-titles">
            @foreach (var kind in TitleKindOptions)
            {
                var isChampion = kind == TournamentTitleKind.Champion;
                <label class="tc-title-row @(isChampion ? "is-locked" : null)">
                    <UmCheckbox Checked="@(isChampion || _selectedTitles.Contains(kind))"
                                Title="@(isChampion ? "Champion is always awarded" : null)"
                                CheckedChanged="@(_ => ToggleTitle(kind))"/>
                    <span class="tc-title-label">@kind@(isChampion ? " (required)" : null)</span>
                </label>
            }
        </div>
    </Panel>

    <Panel Title="Art">
        <div class="tc-images">
            <div class="tc-image-block">
                <span class="um-section-caption">Cover</span>
                <EditableImage ImageUrl="@(_coverPreviewUrl ?? "/Unmatched-logo.png")" AltText="Tournament cover"
                               Label="Upload cover" FallbackImageUrl="/Unmatched-logo.png"
                               OnFileSelected="OnCoverSelectedAsync"/>
            </div>
            <div class="tc-image-block">
                <span class="um-section-caption">Trophy</span>
                <EditableImage ImageUrl="@(_trophyPreviewUrl ?? "/Unmatched-logo.png")" AltText="Trophy"
                               Label="Upload trophy" FallbackImageUrl="/Unmatched-logo.png"
                               OnFileSelected="OnTrophySelectedAsync"/>
            </div>
        </div>
        @if (!CanUploadImages)
        {
            <div class="tc-warning">Name the tournament before uploading art.</div>
        }
    </Panel>

    <footer class="tc-footer">
        @if (_error is not null)
        {
            <span class="tc-error">@_error</span>
        }
        <div class="um-spacer"></div>
        <UmButton Variant="primary" Icon="bi-plus-lg" Disabled="@(!IsValid || _isSaving)" OnClick="CreateAsync">
            Create tournament
        </UmButton>
    </footer>
</div>

@code {
    private static readonly IReadOnlyList<Breadcrumb.Crumb> Crumbs = [new("Tournaments", Urls.Tournaments), new("New tournament")];

    private static readonly IReadOnlyList<SelectOption<TournamentFormat>> FormatOptions =
        Enum.GetValues<TournamentFormat>()
            .Select(format => new SelectOption<TournamentFormat>(format, TournamentFormatStyle.For(format).Label, TournamentFormatStyle.For(format).Icon))
            .ToList();

    private static readonly Stage[] BracketStages = [Stage.EighthFinals, Stage.QuarterFinals, Stage.SemiFinals];

    private static readonly IReadOnlyList<SelectOption<Stage>> StageOptions =
        BracketStages.Select(stage => new SelectOption<Stage>(stage, stage.GetStageName())).ToList();

    private static readonly TournamentTitleKind[] TitleKindOptions = Enum.GetValues<TournamentTitleKind>();

    private TournamentDto _form = new() { Format = TournamentFormat.SingleElimination, MaxParticipants = 8, InitialStage = Stage.QuarterFinals };
    private readonly HashSet<Guid> _selectedParticipants = new();
    private readonly HashSet<TournamentTitleKind> _selectedTitles = new() { TournamentTitleKind.Champion };
    private List<UiHeroDto> _heroes = new();
    private string? _coverPreviewUrl;
    private string? _trophyPreviewUrl;
    private string? _error;
    private bool _isSaving;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private bool CanUploadImages => !string.IsNullOrWhiteSpace(_form.Name);

    private bool IsValid
        => !string.IsNullOrWhiteSpace(_form.Name)
        && _form.MaxParticipants >= 2
        && _selectedParticipants.Count >= 2
        && _selectedParticipants.Count <= _form.MaxParticipants;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();
            _heroes = (await HeroService.GetAsync()).OrderBy(h => h.Name).ToList();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private IReadOnlyList<SelectOption<Guid>> HeroOptions()
        => _heroes.Select(h => new SelectOption<Guid>(h.Id, h.Name, ArtUrl: h.ImageUrl)).ToList();

    /// <summary>Only SingleElimination's opening round is a user choice - GroupStage always starts at
    /// the group phase, and Swiss/League/Bounty don't use Stage at all.</summary>
    private void OnFormatChanged(TournamentFormat format)
    {
        _form.Format = format;
        _form.InitialStage = format switch
        {
            TournamentFormat.SingleElimination when !BracketStages.Contains(_form.InitialStage) => Stage.QuarterFinals,
            TournamentFormat.GroupStage => Stage.Group,
            _ => _form.InitialStage
        };
    }

    private void OnMaxParticipantsChanged(string? value)
        => _form.MaxParticipants = int.TryParse(value, out var parsed) ? Math.Max(2, parsed) : _form.MaxParticipants;

    private void OnParticipantsChanged(IReadOnlyList<Guid> heroIds)
    {
        _selectedParticipants.Clear();
        foreach (var heroId in heroIds)
        {
            _selectedParticipants.Add(heroId);
        }
    }

    private void ToggleTitle(TournamentTitleKind kind)
    {
        if (kind == TournamentTitleKind.Champion)
        {
            return; // always on, not user-toggleable
        }

        if (!_selectedTitles.Add(kind))
        {
            _selectedTitles.Remove(kind);
        }
    }

    private async Task OnCoverSelectedAsync(IBrowserFile file)
    {
        if (!CanUploadImages)
        {
            return;
        }

        await using var stream = file.OpenReadStream(15_000_000);
        _form.ImageFileName = await ImageUploadService.SaveAsync("tournaments", _form.Name, _form.ImageFileName, stream, file.Name);
        _coverPreviewUrl = $"/images/tournaments/{_form.ImageFileName}";
    }

    private async Task OnTrophySelectedAsync(IBrowserFile file)
    {
        if (!CanUploadImages)
        {
            return;
        }

        await using var stream = file.OpenReadStream(15_000_000);
        _form.TrophyImageFileName = await ImageUploadService.SaveAsync("trophies", _form.Name, _form.TrophyImageFileName, stream, file.Name);
        _trophyPreviewUrl = $"/images/trophies/{_form.TrophyImageFileName}";
    }

    private async Task CreateAsync()
    {
        if (!IsValid)
        {
            return;
        }

        _isSaving = true;
        _error = null;
        try
        {
            PreloadService.Show();
            _form.ParticipantHeroIds = _selectedParticipants.ToList();
            _form.TitleKinds = _selectedTitles.ToList();

            var created = await TournamentService.AddAsync(_form);
            NavManager.NavigateTo($"{Urls.Tournaments}/{created.Id}");
        }
        catch (Exception exception)
        {
            _error = $"Failed to create the tournament: {exception.Message}";
        }
        finally
        {
            _isSaving = false;
            PreloadService.Hide();
        }
    }
}
