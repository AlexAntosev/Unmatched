@page "/tournaments/{id}"
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Dtos.Player
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Shared.DesignSystem
@inject ITournamentService TournamentService
@inject IMatchService MatchService
@inject IHeroService HeroService
@inject IPlayerService PlayerService
@inject IMapService MapService
@inject NavigationManager NavManager
@*
    SingleElimination gets the live bracket (PlayoffBracket.razor, design/CLAUDE.md turn 15b) and
    Bounty gets the champion pool (BountyDetail.razor, turn 15d) - both deliberate, per-format
    designs. GroupStage keeps the older generic per-Stage panel rendering below (its group phase is
    just Stage.Group, so the same rendering already covers it once the playoff stages follow) and
    Swiss keeps one panel per Round - neither has a dedicated design yet. League has neither, so it
    gets a standings table plus the shared match list. Matches are filtered by TournamentId, not by
    name.
*@

<PageHeader Breadcrumbs="Crumbs">
    <Controls>
        @if (CanGenerate)
        {
            <UmButton Size="sm" Icon="bi-magic" OnClick="GenerateMatchesAsync">Generate matches</UmButton>
        }
        @if (SupportsCompletion)
        {
            <UmButton Size="sm" Icon="bi-trophy" Disabled="!CanComplete" Title="@CompleteButtonTitle" OnClick="CompleteAsync">
                Complete tournament
            </UmButton>
        }
        <UmButton Size="sm" Variant="primary" Icon="bi-plus-lg" OnClick="OpenNewMatch">New match</UmButton>
    </Controls>
</PageHeader>

<div class="um-page tournament-detail">
    <div class="td-banner">
        <img class="td-cover" src="@(_tournament.ImageUrl ?? "/Unmatched-logo.png")" alt="@_tournament.Name"/>
        <div class="td-identity">
            <div class="td-name">@_tournament.Name</div>
            <div class="td-meta">
                <span class="td-format"><i class="bi @Style.Icon"></i>@Style.Label</span>
                <span class="td-status @StatusClass">@_tournament.Status</span>
                <span class="td-participants"><i class="bi bi-people"></i>@_tournament.ParticipantHeroIds.Count() participants</span>
            </div>
        </div>
        @if (_tournament.TrophyImageUrl is not null)
        {
            <img class="td-trophy" src="@_tournament.TrophyImageUrl" alt="Trophy" title="Trophy"/>
        }
    </div>

    @if (_error is not null)
    {
        <div class="td-error alert alert-danger" role="alert">@_error</div>
    }

    @if (_tournament.Status == TournamentStatus.Completed && _awards.Count > 0)
    {
        <Panel Title="Awards" Meta="@($"{_awards.Count}")">
            <div class="award-list">
                @foreach (var award in _awards.OrderByDescending(a => a.Points))
                {
                    var hero = HeroFor(award.HeroId);
                    var placement = _standings.FirstOrDefault(s => s.HeroId == award.HeroId)?.FinalPlacement;
                    <div class="award-row">
                        @if (placement is >= 1 and <= 3)
                        {
                            <MedalBadge Place="@placement.Value" Size="xs"/>
                        }
                        <HeroToken ImageUrl="@(hero?.ImageUrl ?? "/Unknown.png")" Size="28" Title="@(hero?.Name ?? "Unknown")"/>
                        <span class="award-hero-name">@(hero?.Name ?? "Unknown")</span>
                        <span class="award-kind">@award.AwardKind.GetLabel()</span>
                        <span class="award-points @(award.Points >= 0 ? "is-positive" : "is-negative")">@(award.Points >= 0 ? "+" : "")@award.Points</span>
                    </div>
                }
            </div>
        </Panel>
    }

    @if (_tournament.Format != TournamentFormat.Bounty)
    {
        <Panel Title="Participants" Meta="@($"{_tournament.ParticipantHeroIds.Count()}")">
            <div class="td-participant-list">
                @foreach (var heroId in _tournament.ParticipantHeroIds)
                {
                    var hero = HeroFor(heroId);
                    <HeroToken ImageUrl="@(hero?.ImageUrl ?? "/Unknown.png")" Alt="@(hero?.Name ?? "Unknown")"
                               Size="40" Title="@(hero?.Name ?? "Unknown")"/>
                }
            </div>
        </Panel>
    }

    @if (_tournament.Format == TournamentFormat.SingleElimination)
    {
        <PlayoffBracket Tournament="_tournament" Matches="_matches" Maps="_maps" OnChanged="RefreshAsync"/>
    }
    else if (_tournament.Format == TournamentFormat.Bounty)
    {
        <BountyDetail Tournament="_tournament" Heroes="_heroes" Players="_players" Maps="_maps"
                      MatchLog="_tournamentMatchLog" OnChanged="RefreshAsync"/>
    }
    else if (IsBracketFormat)
    {
        <div class="bracket">
            @foreach (var stage in Stages())
            {
                var stageMatches = _matches.Where(m => m.Stage == stage).ToList();
                <Panel Title="@stage.GetStageName()" Meta="@($"{stageMatches.Count}")" Class="bracket-stage">
                    @if (stageMatches.Count == 0)
                    {
                        <div class="bracket-empty">Not played yet.</div>
                    }
                    @foreach (var match in stageMatches)
                    {
                        <TournamentMatchCard Match="match" OnOpen="OpenMatch"/>
                    }
                </Panel>
            }
        </div>
    }
    else if (IsSwiss)
    {
        <div class="bracket">
            @foreach (var round in Rounds())
            {
                var roundMatches = _matches.Where(m => m.Round == round).ToList();
                <Panel Title="@($"Round {round}")" Meta="@($"{roundMatches.Count}")" Class="bracket-stage">
                    @foreach (var match in roundMatches)
                    {
                        <TournamentMatchCard Match="match" OnOpen="OpenMatch"/>
                    }
                </Panel>
            }
            @if (Rounds().Count == 0)
            {
                <div class="bracket-empty">No rounds played yet.</div>
            }
        </div>
    }
    else
    {
        <Panel Title="Standings" Meta="@($"{_standings.Count} participants")">
            @if (_standings.Count == 0)
            {
                <div class="bracket-empty">Nobody has played yet.</div>
            }
            else
            {
                <div class="standings-table">
                    <div class="standings-header">
                        <div>#</div><div>Hero</div><div class="standings-right">W</div><div class="standings-right">L</div>
                    </div>
                    @foreach (var entry in _standings.Select((standing, index) => (Standing: standing, Rank: index + 1)))
                    {
                        var hero = HeroFor(entry.Standing.HeroId);
                        <div class="standings-row">
                            <div class="standings-rank">@entry.Rank</div>
                            <div class="standings-hero">
                                <HeroToken ImageUrl="@(hero?.ImageUrl ?? "/Unknown.png")" Size="28"/>
                                <span>@(hero?.Name ?? "Unknown")</span>
                            </div>
                            <div class="standings-right">@entry.Standing.Wins</div>
                            <div class="standings-right">@entry.Standing.Losses</div>
                        </div>
                    }
                </div>
            }
        </Panel>

        <MatchList Matches="_tournamentMatchLog" Title="Matches" PageSize="10" Meta="@($"{_tournamentMatchLog.Count} matches")"/>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private TournamentDto _tournament = new();
    private List<UiMatchDto> _matches = new();
    private List<TournamentStandingDto> _standings = new();
    private List<TournamentAwardDto> _awards = new();
    private List<UiMatchLogDto> _tournamentMatchLog = new();
    private List<UiHeroDto> _heroes = new();
    private List<UiPlayerDto> _players = new();
    private List<MapDto> _maps = new();
    private string? _error;

    [Inject]
    protected BlazorBootstrap.PreloadService PreloadService { get; set; } = default!;

    private IReadOnlyList<Breadcrumb.Crumb> Crumbs =>
    [
        new("Tournaments", Urls.Tournaments), new(_tournament.Name ?? string.Empty)
    ];

    private TournamentFormatStyle Style => TournamentFormatStyle.For(_tournament.Format);

    /// <summary>GroupStage's group phase is just Stage.Group, so the generic per-Stage panel below
    /// already covers it once the playoff stages follow - SingleElimination has its own dedicated
    /// PlayoffBracket instead (see the header comment).</summary>
    private bool IsBracketFormat => _tournament.Format == TournamentFormat.GroupStage;

    private bool IsSwiss => _tournament.Format == TournamentFormat.Swiss;

    /// <summary>Playoff generates its own next round automatically (see TryAutoGenerateNextStageAsync)
    /// and has no manual button for it; Bounty has no generator at all.</summary>
    private bool CanGenerate => TournamentFormatStyle.SupportsGeneration(_tournament.Format)
        && _tournament.Format != TournamentFormat.SingleElimination
        && !_matches.Any(m => m.IsPlanned);

    /// <summary>Bounty's payout is an ongoing per-challenge pool, not a one-shot placement schedule -
    /// it never completes. Playoff completes through its own popup (PlayoffBracket.razor) instead of
    /// this header button, mirroring how it also hides the generic "Generate matches" button above.</summary>
    private bool SupportsCompletion => _tournament.Format is not TournamentFormat.Bounty and not TournamentFormat.SingleElimination;

    private bool CanComplete => _tournament.Status != TournamentStatus.Completed
        && _matches.Count > 0 && !_matches.Any(m => m.IsPlanned);

    private string? CompleteButtonTitle => _tournament.Status == TournamentStatus.Completed
        ? "This tournament is already completed."
        : _matches.Any(m => m.IsPlanned)
            ? "Finish every planned match before completing the tournament."
            : _matches.Count == 0
                ? "Play at least one match before completing the tournament."
                : null;

    private string StatusClass => _tournament.Status switch
    {
        TournamentStatus.InProgress => "is-in-progress",
        TournamentStatus.Completed => "is-completed",
        _ => "is-draft"
    };

    private IEnumerable<Stage> Stages()
    {
        for (var stage = _tournament.InitialStage; stage <= Stage.GrandFinals; stage++)
        {
            yield return stage;
        }
    }

    private List<int> Rounds()
        => _matches.Where(m => m.Round.HasValue).Select(m => m.Round!.Value).Distinct().OrderBy(r => r).ToList();

    private UiHeroDto? HeroFor(Guid heroId) => _heroes.FirstOrDefault(h => h.Id == heroId);

    protected override async Task OnParametersSetAsync()
    {
        if (!Guid.TryParse(Id, out var tournamentId) || tournamentId == Guid.Empty)
        {
            return;
        }

        try
        {
            PreloadService.Show();
            await LoadAsync(tournamentId);

            // The round that just finished needs its next round generated - Playoff has no manual
            // "Generate matches" button (see CanGenerate), so this is the only place it happens.
            // Swallowing the failure is deliberate: once the bracket is fully decided,
            // CreateNextStagePlannedMatchesAsync always throws "nothing further to generate", which
            // just means PlayoffBracket's "Tournament complete" popup takes over from here.
            if (_tournament.Format == TournamentFormat.SingleElimination && _matches.Count > 0 && !_matches.Any(m => m.IsPlanned))
            {
                try
                {
                    await TournamentService.GenerateMatchesAsync(tournamentId);
                    await LoadAsync(tournamentId);
                }
                catch (Exception)
                {
                    // no further stage to generate - the bracket is complete.
                }
            }
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private async Task LoadAsync(Guid tournamentId)
    {
        var tournament = TournamentService.GetAsync(tournamentId);
        var matches = MatchService.GetByTournamentIdAsync(tournamentId);
        var standings = TournamentService.GetStandingsAsync(tournamentId);
        var awards = TournamentService.GetAwardsAsync(tournamentId);
        var heroes = HeroService.GetAsync();
        var players = PlayerService.GetAsync();
        var maps = MapService.GetAsync();
        var matchLog = MatchService.GetMatchLogAsync();
        await Task.WhenAll(tournament, matches, standings, awards, heroes, players, maps, matchLog);

        _tournament = tournament.Result;
        _matches = matches.Result.ToList();
        _standings = standings.Result.ToList();
        _awards = awards.Result.ToList();
        _heroes = heroes.Result.ToList();
        _players = players.Result.ToList();
        _maps = maps.Result.ToList();
        _tournamentMatchLog = matchLog.Result
            .Where(m => m.TournamentId == tournamentId)
            .OrderByDescending(m => m.Date)
            .ToList();
    }

    private async Task RefreshAsync() => await OnParametersSetAsync();

    private async Task GenerateMatchesAsync()
    {
        _error = null;
        try
        {
            await TournamentService.GenerateMatchesAsync(_tournament.Id);
            await OnParametersSetAsync();
        }
        catch (Exception exception)
        {
            _error = $"Couldn't generate the next round: {exception.Message}";
        }
    }

    private async Task CompleteAsync()
    {
        _error = null;
        try
        {
            await TournamentService.CompleteAsync(_tournament.Id);
            await OnParametersSetAsync();
        }
        catch (Exception exception)
        {
            _error = $"Couldn't complete the tournament: {exception.Message}";
        }
    }

    /// <summary>Only a planned match is worth opening - it is the one still waiting for a result.</summary>
    private void OpenMatch(UiMatchDto match)
    {
        if (match.IsPlanned)
        {
            NavManager.NavigateTo($"{Urls.Match}/{match.Id}");
        }
    }

    private void OpenNewMatch()
        => NavManager.NavigateTo($"{Urls.AddMatch}?tournamentId={_tournament.Id}");
}
