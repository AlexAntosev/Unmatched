@using Microsoft.AspNetCore.Components
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.UI.BlazorServer.Shared.Statistics

<div class="page-content">
    <h5>@Title: @_hero</h5>
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <StatCard Value="@_total.ToString()" Label="Total Matches"/>
        <StatCard Value="@_wins.ToString()" Label="Wins" Variant="win"/>
        <StatCard Value="@_looses.ToString()" Label="Looses" Variant="loss"/>
        <StatCard Value="@_kd.ToString()" Label="K/D"/>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public bool IsAgainst { get; set; }

    [Parameter]
    public IGrouping<string, UiFighterDto>? HeroMatches
    {
        get => _heroMatches;
        set
        {
            _heroMatches = value;
            if (value is not null)
            {
                _hero = value.Key;
                _total = value.Count();
                _wins = value.Count(f => IsAgainst ? !f.IsWinner : f.IsWinner);
                _looses = value.Count(f => IsAgainst ? f.IsWinner : !f.IsWinner);
                _kd = CalculateKd();
            }

        }
    }

    private double CalculateKd() => _looses > 0
        ? Math.Round((double)_wins / _looses, 2)
        : 0;

    private string _hero = "";
    private int _total;
    private int _wins;
    private int _looses;
    private double? _kd = 0;
    private IGrouping<string, UiFighterDto>? _heroMatches;
}
