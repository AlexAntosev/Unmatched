@page "/admin"
@using Microsoft.AspNetCore.Components
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@inject IRatingService RatingService
@inject RatingRecalculationStateNotifier RecalculationStateNotifier

<div class="page-content">
    <h1 class="page-title">Admin</h1>

    @if (_recalculationSucceeded)
    {
        <div class="alert alert-success alert-dismissible mb-3" role="alert">
            Ratings recalculated successfully.
            <button type="button" class="btn-close" @onclick="() => _recalculationSucceeded = false"></button>
        </div>
    }

    @if (_recalculationError is not null)
    {
        <div class="alert alert-danger alert-dismissible mb-3" role="alert">
            @_recalculationError
            <button type="button" class="btn-close" @onclick="() => _recalculationError = null"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Rating Recalculation</h5>
            <p>Recalculates ratings for all players based on their full match history. This can take a while and cannot be undone.</p>
            <button class="btn btn-primary" @onclick="() => _confirmDialog.ShowAsync()">Recalculate Ratings</button>
        </div>
    </div>

    <BlazorBootstrap.Modal @ref="_confirmDialog" Title="Confirm recalculation">
        <BodyTemplate>
            Are you sure you want to recalculate ratings for all players? This action cannot be undone.
        </BodyTemplate>
        <FooterTemplate>
            <button class="btn btn-secondary" @onclick="() => _confirmDialog.HideAsync()" disabled="@_isRecalculating">Cancel</button>
            <button class="btn btn-danger" @onclick="OnConfirmRecalculateClick" disabled="@_isRecalculating">
                @(_isRecalculating ? "Recalculating..." : "Yes, recalculate")
            </button>
        </FooterTemplate>
    </BlazorBootstrap.Modal>
</div>

@code {
    private BlazorBootstrap.Modal _confirmDialog = default!;
    private bool _isRecalculating;
    private bool _recalculationSucceeded;
    private string? _recalculationError;

    [Inject] protected BlazorBootstrap.PreloadService PreloadService { get; set; }

    private async Task OnConfirmRecalculateClick()
    {
        if (_isRecalculating)
        {
            return;
        }

        try
        {
            _isRecalculating = true;
            PreloadService.Show();
            _recalculationSucceeded = false;
            _recalculationError = null;

            await RatingService.RecalculateAsync();
            RecalculationStateNotifier.NotifyChanged();

            _recalculationSucceeded = true;
            await _confirmDialog.HideAsync();
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            _recalculationError = "Failed to recalculate ratings. Please try again.";
        }
        finally
        {
            _isRecalculating = false;
            PreloadService.Hide();
        }
    }
}
