@page "/draft"
@using BlazorBootstrap
@using Unmatched.Dtos
@using Unmatched.Dtos.Match
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Pages.AddMatch
@using Unmatched.UI.BlazorServer.Pages.Draft.Steps
@using Unmatched.UI.BlazorServer.Services
@using Unmatched.UI.BlazorServer.Shared.DesignSystem
@inject IPlayerService PlayerService
@inject IHeroService HeroService
@inject IMapService MapService
@inject IVillainService VillainService
@inject IMinionService MinionService
@inject ICollectionService CollectionService
@inject NavigationManager NavManager
@inject PreloadService PreloadService
@*
    Draft session (design/IMPLEMENTATION-PROMPT.md §5A) - a full-screen flow, not a modal: mode &amp;
    players -> map bans -> hero ban + snake pick + final pick -> turn-order roll (or a villain step
    for co-op) -> the same MatchSheet used by Add/Edit match, prefilled and with its own footer
    hidden (this page's footer saves instead). Everything lives in DraftState until that last save
    - nothing is persisted mid-draft.
*@

<div class="draft-page">
    <header class="draft-head">
        <div class="draft-title">Draft session</div>
        <div class="draft-mode-chip" style="color:@ModeStyle.Color">
            <i class="bi @ModeStyle.Icon"></i>@ModeStyle.Label
        </div>
        <div class="um-spacer"></div>
        <UmButton Size="sm" Icon="bi-arrow-counterclockwise" OnClick="Restart">Restart</UmButton>
        <span class="draft-step-of">Step @_state.CurrentStep of 5</span>
    </header>

    <DraftProgressRail State="_state" OnStepSelected="GoToStep"/>

    <div class="draft-body">
        @switch (_state.CurrentStep)
        {
            case DraftState.Step1Players:
                <PlayersStep State="_state" AllPlayers="_players" OnChanged="StateHasChanged"/>
                break;
            case DraftState.Step2Map:
                <MapBanStep State="_state" AllMaps="_maps" OnChanged="StateHasChanged"/>
                break;
            case DraftState.Step3Heroes:
                <HeroDraftStep State="_state" AllHeroes="_heroes" OnChanged="StateHasChanged"/>
                break;
            case DraftState.Step4TurnOrOrVillain:
                @if (_state.IsCoop)
                {
                    <VillainStep State="_state" AllVillains="_villains" AllMinions="_minions" OnChanged="StateHasChanged"/>
                }
                else
                {
                    <TurnOrderStep State="_state" OnChanged="StateHasChanged"/>
                }
                break;
            case DraftState.Step5Sheet:
                @if (_prefilledMatch is not null)
                {
                    <MatchSheet @ref="_sheet" Match="_prefilledMatch" Players="_players" Heroes="_heroes" Villains="_villains"
                                Minions="_minions" Maps="_maps" Tournaments="@(Array.Empty<TournamentDto>())"
                                Prefilled="true" Embedded="true" BannerSub="Fighters sorted by turn order — every field is still editable"
                                DraftLog="@DraftLogText" OnSaved="HandleSaved"/>
                }
                break;
        }
    </div>

    <footer class="draft-footer">
        <span class="draft-footer-hint">@FooterHint()</span>
        <div class="um-spacer"></div>
        @if (_state.CurrentStep < DraftState.Step5Sheet)
        {
            <UmButton Size="sm" Disabled="@(_state.CurrentStep == DraftState.Step1Players)" OnClick="Back">Back</UmButton>
            <UmButton Size="sm" Variant="primary" Disabled="@(!_state.CanAdvanceFromStep(_state.CurrentStep))" OnClick="NextAsync">Next</UmButton>
        }
        else
        {
            <UmButton Size="sm" OnClick="Back">Back</UmButton>
            <UmButton Size="sm" Variant="primary" Icon="bi-check-lg" OnClick="SaveMatchAsync">Save match</UmButton>
        }
    </footer>
</div>

@code {
    private DraftState _state = new();
    private UiMatchDto? _prefilledMatch;
    private MatchSheet? _sheet;

    private List<UiPlayerDto> _players = new();
    private List<UiHeroDto> _heroes = new();
    private List<VillainDto> _villains = new();
    private List<MinionDto> _minions = new();
    private List<MapDto> _maps = new();

    private GameModeStyle ModeStyle => GameModeStyle.For(_state.Mode);

    private string DraftLogText => string.Join(" · ", _state.BanLog);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            PreloadService.Show();

            var players = PlayerService.GetAsync();
            var heroes = HeroService.GetAsync();
            var villains = VillainService.GetAsync();
            var minions = MinionService.GetAsync();
            var maps = MapService.GetAsync();
            await Task.WhenAll(players, heroes, villains, minions, maps);

            _players = players.Result.OrderBy(p => p.Name).ToList();
            _heroes = heroes.Result.OrderBy(h => h.Name).ToList();
            _villains = villains.Result.OrderBy(v => v.Name).ToList();
            _minions = minions.Result.OrderBy(m => m.Name).ToList();
            _maps = maps.Result.OrderBy(m => m.DisplayName).ToList();

            await FilterByOwnedSetsAsync();
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    /// <summary>Draft pools come from owned sets only (the New match modal's own footer note) -
    /// same mechanism AddMatch.razor uses for the manual-entry sheet.</summary>
    private async Task FilterByOwnedSetsAsync()
    {
        var ownedExpansionIds = (await CollectionService.GetOwnedExpansionIdsAsync()).ToHashSet();
        if (ownedExpansionIds.Count == 0)
        {
            return;
        }

        _heroes = _heroes.Where(h => h.ExpansionId is null || ownedExpansionIds.Contains(h.ExpansionId.Value)).ToList();
        _maps = _maps.Where(m => m.ExpansionId is null || ownedExpansionIds.Contains(m.ExpansionId.Value)).ToList();
        _villains = _villains.Where(v => v.ExpansionId is null || ownedExpansionIds.Contains(v.ExpansionId.Value)).ToList();
        _minions = _minions.Where(m => m.ExpansionId is null || ownedExpansionIds.Contains(m.ExpansionId.Value)).ToList();
    }

    private void GoToStep(int step)
    {
        if (step <= _state.HighestReachedStep)
        {
            _state.CurrentStep = step;
        }
    }

    private void Back()
    {
        if (_state.CurrentStep > DraftState.Step1Players)
        {
            _state.CurrentStep--;
        }
    }

    private Task NextAsync()
    {
        if (!_state.CanAdvanceFromStep(_state.CurrentStep))
        {
            return Task.CompletedTask;
        }

        _state.CurrentStep++;
        _state.HighestReachedStep = Math.Max(_state.HighestReachedStep, _state.CurrentStep);

        if (_state.CurrentStep == DraftState.Step5Sheet)
        {
            _prefilledMatch ??= DraftMatchMapper.ToMatch(_state);
        }

        return Task.CompletedTask;
    }

    private void Restart()
    {
        _state = new DraftState();
        _prefilledMatch = null;
        _sheet = null;
    }

    private async Task SaveMatchAsync()
    {
        if (_sheet is not null)
        {
            await _sheet.SaveAsync();
        }
    }

    private void HandleSaved(SaveMatchResultDto result) => NavManager.NavigateTo(Urls.MatchLog);

    private string FooterHint() => _state.CurrentStep switch
    {
        DraftState.Step1Players => "Pick a mode, then the players",
        DraftState.Step2Map => "Ban maps until one remains",
        DraftState.Step3Heroes => "Ban and pick heroes, then choose your final one",
        DraftState.Step4TurnOrOrVillain => _state.IsCoop ? "Pick a villain and minions" : "Roll the turn order",
        _ => "Review the sheet, then save"
    };
}
