@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Services
@inject IRatingService RatingService
@inject NavigationManager NavigationManager
@inject RatingRecalculationStateNotifier RecalculationStateNotifier
@*
    Sits at the bottom of the nav rail whenever the match service reports that ratings drifted,
    and links to the Settings screen where they can be recalculated.
*@
@if (_isRecalculationRequired)
{
    <NavLink class="rail-item rail-warning" href="@Urls.Settings" title="Rating recalculation required">
        <i class="bi bi-exclamation-triangle-fill"></i>
        @if (IsExpanded)
        {
            <span class="rail-item-label">Recalculation required</span>
        }
    </NavLink>
}

@code {
    private bool _isRecalculationRequired;

    [Parameter]
    public bool IsExpanded { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        RecalculationStateNotifier.Changed += OnRecalculationStateChanged;

        await RefreshAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshAsync();
    }

    private async void OnRecalculationStateChanged()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isRecalculationRequired = await RatingService.IsRecalculationRequiredAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        RecalculationStateNotifier.Changed -= OnRecalculationStateChanged;
    }
}
