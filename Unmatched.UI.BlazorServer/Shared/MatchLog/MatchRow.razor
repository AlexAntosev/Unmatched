@using Unmatched.Dtos
@using Unmatched.Enums
@using Unmatched.Extensions
@using Unmatched.Services.Statistics
@*
    Screen 3b: the one row shape used by the match log and every "recent matches" block. The left
    edge carries the game mode, not the result - this app is a hub for everybody's games, so the
    outcome only appears inside the expanded scoreboard.
*@
<div class="match-row @(IsOpen ? "is-open" : null) @(IsHighlighted ? "is-highlighted" : null) @ResultVariantClass" style="border-left-color:@_mode.Color">
    <div class="match-row-line" @onclick="OnToggle">
        <div>
            <div class="match-row-date">@Match.Date.ToString("dd MMM yyyy")</div>
            @if (Match.Date.TimeOfDay != TimeSpan.Zero)
            {
                @* Matches logged before the form had a time field are stored at midnight. *@
                <div class="match-row-time">@Match.Date.ToString("HH:mm")</div>
            }
        </div>
        <div>
            <ModeBadge Mode="Match.GameMode"/>
            @if (ShowUnrankedBadge)
            {
                <span class="match-row-unranked" title="Unranked - doesn't affect hero rating"><i class="bi bi-dash-circle"></i>Unranked</span>
            }
        </div>
        <div class="match-row-participants">
            @foreach (var side in _sides)
            {
                @if (side.Separator is not null)
                {
                    <span class="match-row-separator">@side.Separator</span>
                }
                <SideBox Variant="@SideVariant(side)">
                    @foreach (var participant in side.Participants)
                    {
                        <FighterPlate Participant="@participant"
                                      Title="@ChipTitle(participant)"
                                      IsRanked="@Match.IsRanked"
                                      ShowPlace="@(Match.GameMode == GameMode.FreeForAll)"/>
                    }
                </SideBox>
            }
        </div>
        <div class="match-row-map">
            @if (Map is not null)
            {
                <img class="match-row-map-thumb" src="@Map.ImageUrl" alt="@Map.DisplayName"
                     onerror="this.onerror=null;this.src='/UnknownMap.png'"/>
                <div class="match-row-map-text">
                    <div class="match-row-map-name">@Map.DisplayName</div>
                    @if (!string.IsNullOrEmpty(Map.ExpansionName))
                    {
                        <div class="match-row-map-expansion">@Map.ExpansionName</div>
                    }
                </div>
            }
            else
            {
                <div class="match-row-map-name">@MapName</div>
            }
        </div>
        <div class="match-row-tournament">
            @if (Match.TournamentId is not null)
            {
                <i class="bi bi-trophy"></i>
                <div class="match-row-tournament-text">
                    <div class="match-row-tournament-name">@Match.TournamentName</div>
                    @if (!string.IsNullOrEmpty(StageOrRoundText))
                    {
                        <div class="match-row-tournament-stage">@StageOrRoundText</div>
                    }
                </div>
            }
            else
            {
                <span class="match-row-tournament-dash">–</span>
            }
        </div>
        <div class="match-row-epic">
            @if (!string.IsNullOrWhiteSpace(Match.Comment))
            {
                <i class="bi bi-chat-left-text-fill match-row-comment-icon" title="@Match.Comment"></i>
            }
            <EpicStars Value="@(Match.Epic ?? 0)" ReadOnly="true" Size="13"/>
        </div>
        <div class="match-row-chevron">
            <i class="bi @(IsOpen ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </div>
    </div>
    @if (IsOpen)
    {
        <MatchScoreboard Match="Match"/>
    }
</div>

@code {
    private IReadOnlyList<MatchSide> _sides = [];
    private GameModeStyle _mode = GameModeStyle.For(GameMode.OneVsOne);

    [Parameter, EditorRequired]
    public UiMatchLogDto Match { get; set; } = default!;

    /// <summary>Resolved display name for the map - used only when <see cref="Map"/> couldn't be
    /// resolved (falls back to the internal name the log DTO carries).</summary>
    [Parameter]
    public string? MapName { get; set; }

    /// <summary>The full map, for the thumbnail + expansion name shown in the row. Optional -
    /// falls back to plain <see cref="MapName"/> text when the caller can't resolve it.</summary>
    [Parameter]
    public MapDto? Map { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback OnToggle { get; set; }

    /// <summary>Gilds the row - currently only Bounty's Title History uses this, to call out the
    /// challenge that changed the pool's holder (see MatchList.HighlightRow).</summary>
    [Parameter]
    public bool IsHighlighted { get; set; }

    /// <summary>Win/loss colouring relative to whichever hero/player the caller's page is scoped to
    /// (see MatchList.ResultVariant). `null` means no colouring.</summary>
    [Parameter]
    public bool? ResultVariant { get; set; }

    private string? ResultVariantClass
        => ResultVariant switch { true => "is-win", false => "is-loss", null => null };

    /// <summary>Co-op is excluded - it never affects rating regardless of IsRanked, so the label
    /// would only raise a question the game mode itself already answers.</summary>
    private bool ShowUnrankedBadge => !Match.IsRanked && Match.GameMode != GameMode.Cooperative;

    /// <summary>Bracket stage for elimination formats, or "Round N" for Swiss/group formats that
    /// use <see cref="UiMatchLogDto.Round"/> instead - the two are mutually exclusive per match.</summary>
    private string StageOrRoundText
        => Match.Stage is not null
            ? Match.Stage.Value.GetStageName()
            : Match.Round is not null
                ? $"Round {Match.Round}"
                : string.Empty;

    protected override void OnParametersSet()
    {
        _sides = MatchPresentation.Sides(Match);
        _mode = GameModeStyle.For(Match.GameMode);
        MapName ??= Match.MapName;
    }

    /// <summary>
    /// Sides are washed win/loss only where a side is a team. A lone fighter already shows its
    /// result through the chip's ring, and free-for-all places are shown by the medals.
    /// </summary>
    private string SideVariant(MatchSide side)
    {
        if (Match.GameMode is GameMode.OneVsOne or GameMode.FreeForAll)
        {
            return "neutral";
        }

        return side.IsWinner ? "win" : "loss";
    }

    private static string ChipTitle(MatchParticipant participant)
        => participant.PlayerName is null
            ? participant.Name
            : $"{participant.Name} · {participant.PlayerName}";
}
