@using Unmatched.Dtos
@using Unmatched.Services.Contracts
@inject IMapService MapService
@inject IVillainService VillainService
@inject IMinionService MinionService
@*
    A panel of 3b rows with a column header and paging. Only one row is expanded at a time, which
    is the `openMatch` state from the handoff.
*@
<Panel Title="@Title" Meta="@Meta" Flush="true" HeaderActions="@HeaderActions">
    <ChildContent>
        <ColumnHeader Columns="@Columns" Class="match-list-head">
            <div>Date</div>
            <div>Mode</div>
            <div>Participants</div>
            <div>Map</div>
            <div>Tournament</div>
            <div class="match-list-right">Epic</div>
            <div></div>
        </ColumnHeader>
        @if (_page.Count == 0)
        {
            <div class="match-list-empty">No matches match these filters.</div>
        }
        @foreach (var match in _page)
        {
            <MatchRow Match="match"
                      Map="@ResolvedMap(match.MapName)"
                      MapName="@match.MapName"
                      IsOpen="@(_openMatchId == match.MatchId)"
                      OnToggle="@(() => Toggle(match.MatchId))"
                      IsHighlighted="@(HighlightRow?.Invoke(match) ?? false)"
                      ResultVariant="@(ResultVariant?.Invoke(match))"/>
        }
    </ChildContent>
    <Footer>
        @if (AllowPageSizeControl)
        {
            <span class="match-list-footer-page">Page @_currentPage of @PageCount</span>
            <div class="match-list-footer-divider"></div>
            <span class="match-list-footer-pagesize-label">Per page</span>
            <SegmentedControl TValue="int" Variant="bar" Options="PageSizeOptions" Value="PageSize" ValueChanged="OnPageSizeChanged"/>
            <div class="um-spacer"></div>
            <Pagination Page="_currentPage" PageCount="@PageCount" PageChanged="GoToPage"/>
        }
        else
        {
            <Pagination Page="_currentPage" PageCount="@PageCount" PageChanged="GoToPage"
                        Meta="@($"Page {_currentPage} of {PageCount}")"/>
        }
    </Footer>
</Panel>

@code {
    // Must stay identical to the grid-template-columns in MatchRow.razor.css - ColumnHeader sets
    // this as an inline style from a child component, which scoped CSS there can't override.
    private const string Columns =
        "clamp(88px,7.5vw,132px) clamp(84px,6vw,104px) minmax(0,1fr) clamp(150px,14vw,260px) clamp(140px,13vw,240px) clamp(70px,5.5vw,96px) clamp(26px,2vw,30px)";

    private Dictionary<string, MapDto> _mapsByName = new();
    private Dictionary<Guid, VillainDto> _villainsById = new();
    private Dictionary<Guid, MinionDto> _minionsById = new();
    private List<UiMatchLogDto> _all = new();
    private List<UiMatchLogDto> _page = new();
    private Guid? _openMatchId;
    private int _currentPage = 1;

    [Parameter, EditorRequired]
    public IEnumerable<UiMatchLogDto> Matches { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Match log";

    [Parameter]
    public string? Meta { get; set; }

    /// <summary>Extra header content (tallies, a "Full log" link) for callers embedding this as a
    /// scoped mini-log, e.g. on a hero or player page.</summary>
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 8;

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>Shows the "Per page" segmented override in the footer - the match log page opts in.</summary>
    [Parameter]
    public bool AllowPageSizeControl { get; set; }

    /// <summary>Optional per-row emphasis, e.g. Bounty's Title History gilding the challenge that
    /// changed the pool's holder. Unset (the default) means no row is ever highlighted, so every
    /// other caller of this shared component is unaffected.</summary>
    [Parameter]
    public Func<UiMatchLogDto, bool>? HighlightRow { get; set; }

    /// <summary>Optional per-row win/loss colouring relative to whichever hero/player the caller's
    /// page is scoped to, e.g. Hero/Player match logs. `true` = win, `false` = loss, `null` (or an
    /// unset callback) = no colouring - independent of <see cref="HighlightRow"/>'s gold gilding.</summary>
    [Parameter]
    public Func<UiMatchLogDto, bool?>? ResultVariant { get; set; }

    private static readonly IReadOnlyList<SelectOption<int>> PageSizeOptions =
        [new(10, "10"), new(20, "20"), new(50, "50"), new(100, "100")];

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_all.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var maps = MapService.GetAsync();
        var villains = VillainService.GetAsync();
        var minions = MinionService.GetAsync();
        await Task.WhenAll(maps, villains, minions);

        _mapsByName = maps.Result
            .GroupBy(m => m.Name)
            .ToDictionary(group => group.Key, group => group.First());
        _villainsById = villains.Result.ToDictionary(v => v.Id);
        _minionsById = minions.Result.ToDictionary(m => m.Id);
    }

    protected override void OnParametersSet()
    {
        _all = Matches.ToList();
        foreach (var match in _all)
        {
            EnrichVillain(match.Villain);
        }
        // Filters can shrink the list under the current page - fall back to the last one that exists.
        _currentPage = Math.Clamp(_currentPage, 1, PageCount);
        BuildPage();
    }

    /// <summary>The match log only carries a villain/minion's id and name - the row needs their
    /// catalogue art too, so it's joined in here the same way the map thumbnail is.</summary>
    private void EnrichVillain(UiMatchVillainDto? villain)
    {
        if (villain is null)
        {
            return;
        }

        villain.Villain ??= _villainsById.GetValueOrDefault(villain.VillainId);
        foreach (var minion in villain.Minions)
        {
            minion.Minion ??= _minionsById.GetValueOrDefault(minion.MinionId);
        }
    }

    private void BuildPage()
        => _page = _all.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

    private void GoToPage(int page)
    {
        _currentPage = page;
        _openMatchId = null;
        BuildPage();
    }

    private void Toggle(Guid matchId)
        => _openMatchId = _openMatchId == matchId ? null : matchId;

    private Task OnPageSizeChanged(int size)
    {
        _currentPage = 1;
        return PageSizeChanged.InvokeAsync(size);
    }

    private MapDto? ResolvedMap(string mapName)
        => _mapsByName.GetValueOrDefault(mapName);
}
