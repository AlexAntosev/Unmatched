@using Unmatched.Constants
@using Unmatched.Dtos
@using Unmatched.Enums
@using Unmatched.Services
@using Unmatched.Services.Contracts
@using Unmatched.UI.BlazorServer.Pages
@inject IMatchService MatchService
@inject IMapService MapService

<SfGrid DataSource="@GridData" AllowPaging="true" AllowSorting="true" AllowResizing="true">
    <GridPageSettings PageSize="@PageSize"></GridPageSettings>
    <GridColumns>
        <GridColumn Field="@nameof(MatchLogRow.Date)" Format="d" Type="ColumnType.Date" HeaderText="Date" Width="44" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center"></GridColumn>
        <GridColumn Field="@nameof(MatchLogRow.Tournament)" HeaderText="Tournament" Width="100" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center"></GridColumn>
        <GridColumn Field="@nameof(MatchLogRow.Map)" HeaderText="Map" Width="60" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center"></GridColumn>
        <GridColumn HeaderText="Participants" Width="320" HeaderTextAlign="TextAlign.Center">
            <Template>
                @{
                    var row = (MatchLogRow)context;
                }
                @if (row.GameMode == GameMode.Cooperative)
                {
                    var isVillainWinner = row.Source.Villain?.IsWinner == true;
                    <div class="match-participants @(isVillainWinner ? "looser-name" : "winner-name")">
                        Villain: @row.Source.Villain?.Name — @(isVillainWinner ? "Villain won" : "Players won")
                    </div>
                }
                else if (row.GameMode == GameMode.FreeForAll)
                {
                    <div class="match-participants match-participants-ffa">
                        @foreach (var fighter in row.Source.Fighters.OrderBy(f => f.Placement))
                        {
                            <div class="@(fighter.Placement == 1 ? "winner-name" : "")">
                                #@fighter.Placement @fighter.Player?.Name - @fighter.Hero?.Name
                            </div>
                        }
                    </div>
                }
                else if (row.GameMode == GameMode.TeamVsTeam)
                {
                    var team1 = row.Source.Fighters.Where(f => f.Team == 1).ToList();
                    var team2 = row.Source.Fighters.Where(f => f.Team == 2).ToList();
                    <div class="match-participants match-participants-teams">
                        <div class="@(team1.FirstOrDefault()?.IsWinner == true ? "winner-name" : "looser-name")">
                            Team 1: @string.Join(", ", team1.Select(f => $"{f.Player?.Name} - {f.Hero?.Name}"))
                        </div>
                        <div class="@(team2.FirstOrDefault()?.IsWinner == true ? "winner-name" : "looser-name")">
                            Team 2: @string.Join(", ", team2.Select(f => $"{f.Player?.Name} - {f.Hero?.Name}"))
                        </div>
                    </div>
                }
                else
                {
                    var fighter = row.Source.Fighters.First();
                    var opponent = row.Source.Fighters.Last();
                    <div class="match-participants match-participants-duel">
                        <div class="match-fighter @(fighter.IsWinner ? "winner-name" : "looser-name")">
                            <img src="@fighter.PlayerImageUrl" alt="" class="match-fighter-avatar"/>
                            @fighter.Hero?.Name (@fighter.HpLeft)
                        </div>
                        <span class="match-vs">vs</span>
                        <div class="match-fighter @(opponent.IsWinner ? "winner-name" : "looser-name")">
                            <img src="@opponent.PlayerImageUrl" alt="" class="match-fighter-avatar"/>
                            @opponent.Hero?.Name (@opponent.HpLeft)
                        </div>
                    </div>
                }
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(MatchLogRow.Comment)" HeaderText="Comment" Width="80" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center"></GridColumn>
        <GridColumn Field="@nameof(MatchLogRow.Epic)" HeaderText="Epic" Width="50" HeaderTextAlign="TextAlign.Center" TextAlign="TextAlign.Center">
            <Template>
                @{
                    var row = (MatchLogRow)context;
                }
                @if (row.Epic is not null)
                {
                    <Epic Rating="@(row.Epic.Value)" Max="3" RatingChanged="@((int rate) => EpicChanged(rate, row))"/>
                }
            </Template>
        </GridColumn>
    </GridColumns>
</SfGrid>

@code {
    private List<UiMatchLogDto> _matchLogEntries = new();
    private Dictionary<string, string> _mapDisplayNames = new();

    [Parameter]
    public List<UiMatchLogDto> MatchLogEntries { get; set; } = new();

    [Parameter]
    public int PageSize { get; set; } = 20;

    private List<MatchLogRow> GridData { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        var maps = await MapService.GetAsync();
        _mapDisplayNames = maps
            .GroupBy(m => m.Name)
            .ToDictionary(g => g.Key, g => g.First().DisplayName);
    }

    protected override void OnParametersSet()
    {
        _matchLogEntries = MatchLogEntries;
        GridData = _matchLogEntries.Select(e => new MatchLogRow
            {
                MatchId = e.MatchId,
                Date = e.Date,
                Tournament = e.TournamentName,
                Map = _mapDisplayNames.GetValueOrDefault(e.MapName, e.MapName),
                Comment = e.Comment,
                Epic = e.Epic ?? 0,
                GameMode = e.GameMode,
                Source = e
            }).ToList();
    }

    private async Task EpicChanged(int rate, MatchLogRow row)
    {
        row.Epic = rate;
        await MatchService.UpdateEpicAsync(row.MatchId, rate);
    }
}
