<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Unmatched</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <RatingRecalculationWarning/>
        <NavSubMenu Title="Statistics" IconClass="bi bi-bar-chart-line">
            <NavLink class="nav-link" href="@Urls.HeroesStatistics">
                <span class="bi bi-shield" aria-hidden="true"></span> Heroes
            </NavLink>
            <NavLink class="nav-link" href="@Urls.PlayersStatistics">
                <span class="bi bi-people" aria-hidden="true"></span> Players
            </NavLink>
            <NavLink class="nav-link" href="@Urls.MapsStatistics">
                <span class="bi bi-map" aria-hidden="true"></span> Maps
            </NavLink>
            <NavLink class="nav-link" href="@Urls.MinionsStatistics">
                <span class="bi bi-bug" aria-hidden="true"></span> Minions
            </NavLink>
            <NavLink class="nav-link" href="@Urls.VillainsStatistics">
                <span class="bi bi-eye" aria-hidden="true"></span> Villains
            </NavLink>
        </NavSubMenu>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.Collection">
                <span class="bi bi-box-seam" aria-hidden="true"></span> Collection
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.AddMatch">
                <span class="bi bi-plus-circle" aria-hidden="true"></span> Add match
            </NavLink>
        </div>
        <NavSubMenu Title="Match Log" IconClass="bi bi-list-ul">
            <NavLink class="nav-link" href="@Urls.MatchLog" Match="NavLinkMatch.All">
                <span class="bi bi-collection" aria-hidden="true"></span> All
            </NavLink>
            <NavLink class="nav-link" href="@($"{Urls.MatchLog}?mode=OneVsOne")">
                <span class="bi bi-person" aria-hidden="true"></span> 1v1
            </NavLink>
            <NavLink class="nav-link" href="@($"{Urls.MatchLog}?mode=TeamVsTeam")">
                <span class="bi bi-people" aria-hidden="true"></span> 2v2
            </NavLink>
            <NavLink class="nav-link" href="@($"{Urls.MatchLog}?mode=FreeForAll")">
                <span class="bi bi-shuffle" aria-hidden="true"></span> Free-for-all
            </NavLink>
            <NavLink class="nav-link" href="@($"{Urls.MatchLog}?mode=Cooperative")">
                <span class="bi bi-shield-shaded" aria-hidden="true"></span> Co-op
            </NavLink>
        </NavSubMenu>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.Titles">
                <span class="bi bi-award" aria-hidden="true"></span> Titles
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.Tournaments">
                <span class="bi bi-flag" aria-hidden="true"></span> Tournaments
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.Initialize">
                <span class="bi bi-cloud-download" aria-hidden="true"></span> Initialize default data
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="@Urls.Admin">
                <span class="bi bi-gear" aria-hidden="true"></span> Admin
            </NavLink>
        </div>
    </nav>
</div>

@code {

    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu
        ? "collapse"
        : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

}