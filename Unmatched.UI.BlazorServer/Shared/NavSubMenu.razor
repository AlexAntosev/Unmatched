<div class="nav-item px-3">
    <NavLink class="nav-link nav-submenu-toggle" @onclick="Toggle">
        <span class="nav-submenu-toggle-label">
            <span class="@IconClass" aria-hidden="true"></span> @Title
        </span>
        <span class="nav-submenu-caret bi bi-chevron-down @(_expanded ? "expanded" : "")" aria-hidden="true"></span>
    </NavLink>
    @if (_expanded)
    {
        <div class="nav-submenu">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string IconClass { get; set; } = string.Empty;

    [Parameter]
    public bool InitiallyExpanded { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _expanded;
    private bool _initialized;

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            _expanded = InitiallyExpanded;
            _initialized = true;
        }
    }

    private void Toggle() => _expanded = !_expanded;
}
