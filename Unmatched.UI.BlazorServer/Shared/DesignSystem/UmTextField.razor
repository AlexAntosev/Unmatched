@*
    Text, number, date and time inputs share one inset shell. Numeric values switch to the mono
    face because the design uses mono for anything numeric or temporal.
*@
<div class="um-text-field um-text-field-@Variant @(Centered ? "is-centered" : null) @Class">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="bi @Icon"></i>
    }
    <input type="@Type"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@Disabled"
           min="@Min"
           max="@Max"
           @onchange="HandleChangeAsync"/>
</div>

@code {
    /// <summary>text | number | date | time</summary>
    [Parameter]
    public string Type { get; set; } = "text";

    /// <summary>field (36px) | control (32px) | xs (26px)</summary>
    [Parameter]
    public string Variant { get; set; } = "field";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? Min { get; set; }

    [Parameter]
    public string? Max { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Centres the value - used by the compact HP / Cards / Sidekick boxes on Add match.</summary>
    [Parameter]
    public bool Centered { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private Task HandleChangeAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }
}
