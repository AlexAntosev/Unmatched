@typeparam TValue
@*
    Two looks sharing the same Options/Value/ValueChanged binding: "underline" (default) is the
    sorting-tabs look above the heroes ladder - a 2px bottom edge marks the active tab and the rule
    continues across the remaining width. "pill" is the rounded chip-group look the Titles page uses
    for its Achievements/Titles/Tournament switch - no trailing rule, the active tab gets a tinted
    background instead of an underline.
*@
<div class="um-tabs @(IsPill ? "um-tabs-pill" : null) @Class">
    @foreach (var option in Options)
    {
        var isSelected = EqualityComparer<TValue>.Default.Equals(option.Value, Value);
        <button type="button" class="um-tab @(IsPill ? "um-tab-pill" : null) @(isSelected ? "is-selected" : null)" @onclick="@(() => SelectAsync(option.Value))">
            @option.Label
        </button>
    }
    @if (!IsPill)
    {
        <div class="um-tabs-rule"></div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<SelectOption<TValue>> Options { get; set; } = Array.Empty<SelectOption<TValue>>();

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    /// <summary>"underline" (default) or "pill".</summary>
    [Parameter]
    public string Variant { get; set; } = "underline";

    [Parameter]
    public string? Class { get; set; }

    private bool IsPill => Variant == "pill";

    private Task SelectAsync(TValue value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }
}
