@typeparam TItem
@inject Unmatched.UI.BlazorServer.Services.AppSettingsService AppSettingsService
@*
    The 1c ladder pattern for the list screens the design never drew - players, maps, minions,
    villains. The page supplies the row/tile content; this owns the page header, the search box,
    the List/Tiles switch, the column captions and the per-page footer, so every list behaves the
    same way (design/IMPLEMENTATION-PROMPT.md §1).
*@
<PageHeader Breadcrumbs="Breadcrumbs">
    <Controls>
        <UmSearchBox Value="@_search" ValueChanged="OnSearchChanged" Placeholder="@SearchPlaceholder"/>
        <SegmentedControl TValue="ListViewMode" Variant="bar" Options="ListViewModeOptions.Default"
                           Value="_viewMode" ValueChanged="OnViewModeChanged"/>
    </Controls>
</PageHeader>

<div class="entity-ladder">
    <header class="entity-ladder-head">
        <div>
            <h1 class="um-page-title">@Title</h1>
            <div class="entity-ladder-lede">@Lede</div>
        </div>
    </header>

    @if (_viewMode == ListViewMode.List)
    {
        <ColumnHeader Columns="@Columns" Class="entity-ladder-columns">
            @Header
        </ColumnHeader>

        <div class="entity-ladder-rows">
            @if (_page.Count == 0)
            {
                <div class="entity-ladder-empty">Nothing to show yet.</div>
            }
            @foreach (var item in _page)
            {
                @Row(item)
            }
        </div>
    }
    else
    {
        <div class="um-tile-grid">
            @if (_page.Count == 0)
            {
                <div class="entity-ladder-empty">Nothing to show yet.</div>
            }
            @foreach (var item in _page)
            {
                @Tile(item)
            }
        </div>
    }

    <GridFooter Caption="@(_viewMode == ListViewMode.List ? "ROWS PER PAGE" : "TILES PER PAGE")"
                PageSizeOptions="PageSizeOptions" PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged"
                CurrentPage="_currentPage" PageCount="PageCount" TotalCount="_filtered.Count"
                PageChanged="GoToPage" Class="entity-ladder-footer"/>
</div>

@code {
    private List<TItem> _filtered = new();
    private List<TItem> _page = new();
    private string? _search;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private ListViewMode _viewMode = ListViewMode.List;

    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Lede { get; set; }

    [Parameter]
    public IReadOnlyList<Breadcrumb.Crumb>? Breadcrumbs { get; set; }

    [Parameter, EditorRequired]
    public string Columns { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RenderFragment Header { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> Row { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> Tile { get; set; } = default!;

    /// <summary>How the search box matches an item - usually its name.</summary>
    [Parameter, EditorRequired]
    public Func<TItem, string> SearchText { get; set; } = default!;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search…";

    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>Storage key for the persisted List/Tiles choice - one per screen, e.g. "players".</summary>
    [Parameter, EditorRequired]
    public string ScreenKey { get; set; } = string.Empty;

    private static readonly IReadOnlyList<SelectOption<int>> ListPageSizeOptions =
        [new(10, "10"), new(20, "20"), new(50, "50"), new(100, "100")];

    private static readonly IReadOnlyList<SelectOption<int>> TilePageSizeOptions =
        [new(10, "10"), new(20, "20"), new(50, "50"), new(GridFooter.AllPageSize, "All")];

    private IReadOnlyList<SelectOption<int>> PageSizeOptions
        => _viewMode == ListViewMode.List ? ListPageSizeOptions : TilePageSizeOptions;

    private int PageCount => Math.Max(1, (int)Math.Ceiling(_filtered.Count / (double)_pageSize));

    protected override void OnInitialized() => _pageSize = PageSize;

    protected override void OnParametersSet() => Rebuild();

    /// <summary>
    /// The persisted List/Tiles choice is read via JS interop (localStorage), which cannot run
    /// during static prerendering - only once the circuit is interactive, same as
    /// <see cref="AppSettingsService.GetMatchesPerPageAsync"/> in the match log.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _viewMode = await AppSettingsService.GetListViewModeAsync(ScreenKey);
            StateHasChanged();
        }
    }

    private void Rebuild()
    {
        _filtered = string.IsNullOrWhiteSpace(_search)
            ? Items.ToList()
            : Items.Where(i => SearchText(i).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

        _currentPage = Math.Clamp(_currentPage, 1, PageCount);
        _page = _filtered.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();
    }

    private void OnSearchChanged(string? search)
    {
        _search = search;
        _currentPage = 1;
        Rebuild();
    }

    private void GoToPage(int page)
    {
        _currentPage = page;
        Rebuild();
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _currentPage = 1;
        Rebuild();
    }

    private async Task OnViewModeChanged(ListViewMode mode)
    {
        _viewMode = mode;
        _currentPage = 1;
        _pageSize = PageSize;
        Rebuild();
        await AppSettingsService.SetListViewModeAsync(ScreenKey, mode);
    }
}
